<UserControl x:Class="QuizApp.Views.DashboardArtworkControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Grid>
        <!-- ========================================================== -->
        <!-- 1. HERO SCENIC BACKDROP + PANDA WITH 中文 BOOK             -->
        <!-- ========================================================== -->
        <Viewbox x:Name="HeroArt" Visibility="Collapsed" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Bottom">
