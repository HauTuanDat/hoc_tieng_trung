                                            </Button>
                                            <Button Style="{StaticResource SocialLoginButton}" Height="36" Margin="2,0,2,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="f" FontWeight="ExtraBold" Foreground="#1877F2" FontSize="13" Margin="0,0,5,0" />
                                                    <TextBlock Text="Facebook" FontSize="12" Foreground="#4A403A" FontWeight="Medium" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SocialLoginButton}" Height="36" Margin="4,0,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource AppleLogoIcon}"
                                                          Fill="#1A1513"
                                                          Width="12" Height="14"
                                                          Stretch="Uniform"
                                                          Margin="0,0,5,0"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="Apple" FontSize="12" Foreground="#4A403A" FontWeight="Medium" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>

                                        <!-- Switch to Register Link -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Chưa có tài khoản? " FontSize="13" Foreground="#59685F" />
                                            <TextBlock Text="Đăng ký ngay >" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Cursor="Hand">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SwitchToRegisterTabCommand}" />
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- MOBILE TAB 2: REGISTER FORM -->
                                    <StackPanel Grid.Row="2" Visibility="{Binding IsRegisterTab, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Tạo tài khoản mới!" FontSize="24" FontWeight="Bold" Foreground="#26352D" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="Đăng ký thành viên Mộc Ngữ để bắt đầu lộ trình học bài bản" FontSize="13" Foreground="#59685F" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <Border Background="#FAF8F5" BorderBrush="#E2DDD3" BorderThickness="1.2" CornerRadius="12" Height="42" Padding="12,0" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="👤" FontSize="13" Foreground="#78867D" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Grid.Column="1" Text="{Binding RegisterFullName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#26352D" VerticalContentAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Border Background="#FAF8F5" BorderBrush="#E2DDD3" BorderThickness="1.2" CornerRadius="12" Height="42" Padding="12,0" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="✉" FontSize="13" Foreground="#78867D" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Grid.Column="1" Text="{Binding RegisterUsername, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#26352D" VerticalContentAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Border Background="#FAF8F5" BorderBrush="#E2DDD3" BorderThickness="1.2" CornerRadius="12" Height="42" Padding="12,0" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔒" FontSize="13" Foreground="#78867D" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <PasswordBox x:Name="MobileRegisterPasswordBox" PasswordChanged="RegisterPasswordBox_PasswordChanged" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#26352D" VerticalContentAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Border Background="#FAF8F5" BorderBrush="#E2DDD3" BorderThickness="1.2" CornerRadius="12" Height="42" Padding="12,0" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔒" FontSize="13" Foreground="#78867D" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <PasswordBox x:Name="MobileRegisterConfirmPasswordBox" PasswordChanged="RegisterConfirmPasswordBox_PasswordChanged" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#26352D" VerticalContentAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Button Command="{Binding RegisterCommand}" Cursor="Hand" Height="44" BorderThickness="0" Margin="0,0,0,12">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="{DynamicResource PrimaryButtonGradientBrush}" CornerRadius="12">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#198754" Opacity="0.25" />
                                                        </Border.Effect>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="✨ " FontSize="13" VerticalAlignment="Center" Foreground="White" />
                                                            <TextBlock Text="Đăng ký tài khoản" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Đã có tài khoản? " FontSize="13" Foreground="#59685F" />
                                            <TextBlock Text="Đăng nhập ngay >" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Cursor="Hand">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SwitchToLoginTabCommand}" />
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Mobile Bottom Copyright: Floating on Background -->
                            <TextBlock Text="© 2026 Mộc Ngữ  •  Nền tảng học tiếng Trung toàn diện"
                                       FontFamily="Inter, Be Vietnam Pro, Segoe UI, sans-serif"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,12">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1.2" Direction="270" Color="#000000" Opacity="0.55" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>