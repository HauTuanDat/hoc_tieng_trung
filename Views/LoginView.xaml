                                                                <Border x:Name="tabBorder" CornerRadius="12" Background="#FAF8F5" BorderBrush="#E2DDD3" BorderThickness="1">
                                                                    <TextBlock x:Name="tabText" Text="Đăng nhập" FontSize="13.5" FontWeight="SemiBold" Foreground="#59685F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
