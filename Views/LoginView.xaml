                            <!-- 3 Social Buttons (Never change color when switching theme) -->
                            <UniformGrid Columns="3" Margin="0,0,0,18">
                                <Button Style="{StaticResource SocialLoginButton}" Height="40" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="G" FontWeight="ExtraBold" Foreground="#EA4335" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Google" FontSize="13" Foreground="#4A403A" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SocialLoginButton}" Height="40" Margin="3,0,3,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="f" FontWeight="ExtraBold" Foreground="#1877F2" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Facebook" FontSize="13" Foreground="#4A403A" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SocialLoginButton}" Height="40" Margin="5,0,0,0">
