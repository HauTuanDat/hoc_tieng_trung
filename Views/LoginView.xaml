                            <Border Background="#FAF8F5" BorderBrush="#E2DDD3" BorderThickness="1.2" CornerRadius="12" Height="48" Padding="14,0" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="✉" FontSize="14" Foreground="#78867D" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" Text="{Binding RegisterUsername, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#26352D" VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="#FAF8F5" BorderBrush="#E2DDD3" BorderThickness="1.2" CornerRadius="12" Height="48" Padding="14,0" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔒" FontSize="14" Foreground="#78867D" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <PasswordBox x:Name="RegisterPasswordBox" PasswordChanged="RegisterPasswordBox_PasswordChanged" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#26352D" VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="#FAF8F5" BorderBrush="#E2DDD3" BorderThickness="1.2" CornerRadius="12" Height="48" Padding="14,0" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔒" FontSize="14" Foreground="#78867D" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <PasswordBox x:Name="RegisterConfirmPasswordBox" PasswordChanged="RegisterConfirmPasswordBox_PasswordChanged" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#26352D" VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>

                            <Button Command="{Binding RegisterCommand}" Cursor="Hand" Height="48" BorderThickness="0" Margin="0,0,0,16">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{DynamicResource PrimaryButtonGradientBrush}" CornerRadius="14">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#198754" Opacity="0.30" />
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="✨ " FontSize="14" VerticalAlignment="Center" Foreground="White" />
                                                <TextBlock Text="Đăng ký tài khoản" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Đã có tài khoản? " FontSize="14" Foreground="#59685F" />
                                <TextBlock Text="Đăng nhập ngay >" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Cursor="Hand">
                                    <TextBlock.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SwitchToLoginTabCommand}" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. MOBILE VIEW (Image 2 - Auto-scales to fit any phone)  -->
