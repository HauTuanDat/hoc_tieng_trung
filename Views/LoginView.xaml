<UserControl x:Class="QuizApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
             Background="#FAF7F2"
             Loaded="UserControl_Loaded">

    <Grid>
        <!-- 1. Background Image with Failover Loading (Subtle oriental watercolor texture) -->
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.12" />

        <!-- 2. Subtle Warm Oriental Texture Overlay -->
        <Border Background="#15FAF7F2" />

        <!-- 3. Top-Right Language Pill Selector: [🌐 Tiếng Việt ▾] -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,22,40,0"
                Background="#EEFFFFFF"
                BorderBrush="#E5DDD0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,5"
                Cursor="Hand"
                Panel.ZIndex="10"
                Effect="{StaticResource CardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🌐" FontSize="13" Foreground="#4A403A" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Tiếng Việt" FontSize="12.5" FontWeight="Medium" Foreground="#4A403A" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="▾" FontSize="11" Foreground="#7D746D" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 4. Main 2-Column Responsive Layout -->
        <Grid Margin="40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="470" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT COLUMN: Mộc Ngữ Brand, Highlights & Mascot-->
            <!-- ============================================== -->
            <Grid Grid.Column="0" Margin="0,0,40,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Brand Header: [ 语 ] Mộc Ngữ -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource PrimaryBrush}" Margin="0,0,14,0" Effect="{StaticResource ButtonGlowShadow}">
                        <TextBlock Text="语" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mộc Ngữ" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="Học tiếng Trung - Kết nối thế giới" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                    </StackPanel>
                </StackPanel>

                <!-- Center Content: Slogan, Highlights & Mascot -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center" Margin="0,10,20,10">
                        <!-- Slogan Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Học tiếng Trung" FontSize="36" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource PrimaryTintBrush}" BorderBrush="{StaticResource PrimaryLightBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="10,2" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="中文" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Dễ dàng hơn mỗi ngày" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,14" />

                        <TextBlock Text="Cùng Mộc Ngữ khám phá hành trình chinh phục tiếng Trung với lộ trình khoa học, nội dung phong phú và trải nghiệm học tập thú vị!"
                                   FontSize="14.5" LineHeight="24" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="600" Margin="0,0,0,24" />

                        <!-- 4 Feature Pills in 2x2 Grid -->
                        <UniformGrid Columns="2" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,24">
                            <!-- Feature 1 -->
                            <Border Background="White" BorderBrush="#E6DFD5" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,10,10" Effect="{StaticResource CardShadow}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Đa dạng khóa học" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Lộ trình HSK 1 ~ 6" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Feature 2 -->
                            <Border Background="White" BorderBrush="#E6DFD5" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,10" Effect="{StaticResource CardShadow}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Theo dõi tiến độ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Thống kê bài học chi tiết" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Feature 3 -->
                            <Border Background="White" BorderBrush="#E6DFD5" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,10,0" Effect="{StaticResource CardShadow}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎧" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Luyện tập đa kỹ năng" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Nghe, Nói, Đọc, Viết, Xếp câu" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Feature 4 -->
                            <Border Background="White" BorderBrush="#E6DFD5" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,0" Effect="{StaticResource CardShadow}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⭐" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Học mọi lúc mọi nơi" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Linh hoạt và hiệu quả" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Mascot Graphic & Motivational Speech Bubble -->
                        <Border Background="#FDF8F2" BorderBrush="{StaticResource PrimaryLightBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18,14" HorizontalAlignment="Left" MaxWidth="560">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🐼" FontSize="42" Margin="0,0,14,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="&quot;Bắt đầu từ hôm nay để chạm tới ước mơ của bạn! ❤&quot;" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="&quot;Tiếng Trung không chỉ là ngôn ngữ mà còn là cánh cửa mở ra thế giới!&quot;" FontSize="12" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Status -->
                <TextBlock Grid.Row="2" Text="© 2026 Mộc Ngữ • Nền tảng học tiếng Trung toàn diện" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,10,0,0" />
            </Grid>

            <!-- ============================================== -->
            <!-- RIGHT COLUMN: Interactive Login / Register Card-->
            <!-- ============================================== -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#EDE6DC"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="36,32"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="4" Direction="270" Color="#1F2923" Opacity="0.08" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Dual Tabs: [ Đăng nhập ] | [ Đăng ký ] -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tab 1: Đăng nhập -->
                        <Button Grid.Column="0"
                                Command="{Binding SwitchToLoginTabCommand}"
                                Cursor="Hand"
                                Height="42"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="tabBorder"
                                                        CornerRadius="14"
                                                        Background="#FAF8F5"
                                                        BorderBrush="#E8E0D5"
                                                        BorderThickness="1">
                                                    <TextBlock x:Name="tabText"
                                                               Text="Đăng nhập"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#4A403A"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoginTab}" Value="True">
                                                        <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                        <Setter TargetName="tabBorder" Property="BorderThickness" Value="0" />
                                                        <Setter TargetName="tabText" Property="Foreground" Value="White" />
                                                        <Setter TargetName="tabText" Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Tab 2: Đăng ký -->
                        <Button Grid.Column="2"
                                Command="{Binding SwitchToRegisterTabCommand}"
                                Cursor="Hand"
                                Height="42"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="tabBorder"
                                                        CornerRadius="14"
                                                        Background="#FAF8F5"
                                                        BorderBrush="#E8E0D5"
                                                        BorderThickness="1">
                                                    <TextBlock x:Name="tabText"
                                                               Text="Đăng ký"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#4A403A"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsRegisterTab}" Value="True">
                                                        <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                        <Setter TargetName="tabBorder" Property="BorderThickness" Value="0" />
                                                        <Setter TargetName="tabText" Property="Foreground" Value="White" />
                                                        <Setter TargetName="tabText" Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Feedback Alert Messages -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <!-- Error Alert -->
                        <Border Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,9"
                                Margin="0,0,0,6"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Success Alert -->
                        <Border Background="#F0FDF4"
                                BorderBrush="#BBF7D0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,9"
                                Margin="0,0,0,6"
                                Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✅ " FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================================== -->
                    <!-- TAB 1: LOGIN FORM                              -->
                    <!-- ============================================== -->
                    <StackPanel Grid.Row="2" Visibility="{Binding IsLoginTab, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Chào mừng trở lại!" FontSize="25" FontWeight="Bold" Foreground="#1A1513" Margin="0,0,0,5" />
                        <TextBlock Text="Đăng nhập để tiếp tục hành trình học tiếng Trung của bạn" FontSize="13" Foreground="#7D746D" Margin="0,0,0,22" />

                        <!-- Input 1: Email hoặc số điện thoại -->
                        <Border Background="#FAF8F5"
                                BorderBrush="#E5DFD7"
                                BorderThickness="1.2"
                                CornerRadius="12"
                                Height="48"
                                Padding="14,0"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="✉" FontSize="15" Foreground="#9E968F" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="13.5"
                                         Foreground="#1A1513"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Input 2: Mật khẩu -->
                        <Border Background="#FAF8F5"
                                BorderBrush="#E5DFD7"
                                BorderThickness="1.2"
                                CornerRadius="12"
                                Height="48"
                                Padding="14,0"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒" FontSize="15" Foreground="#9E968F" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <PasswordBox x:Name="LoginPasswordBox"
                                             Grid.Column="1"
                                             PasswordChanged="LoginPasswordBox_PasswordChanged"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14"
                                             Foreground="#1A1513"
                                             VerticalContentAlignment="Center"
                                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisibility}}" />

                                <TextBox x:Name="LoginPasswordTextBox"
                                         Grid.Column="1"
                                         Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="LoginPasswordTextBox_TextChanged"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="13.5"
                                         Foreground="#1A1513"
                                         VerticalContentAlignment="Center"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibility}}" />

                                <Button Grid.Column="2"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="👁" FontSize="15" Foreground="#9E968F" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Remember Me & Forgot Password Row -->
                        <Grid Margin="0,0,0,20">
                            <CheckBox IsChecked="{Binding RememberMe}" VerticalAlignment="Center">
                                <TextBlock Text="Nhớ tài khoản" FontSize="13" Foreground="#4A403A" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </CheckBox>
                            <TextBlock Text="Quên mật khẩu?" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Cursor="Hand" />
                        </Grid>

                        <!-- Large Primary Login Button -->
                        <Button Command="{Binding LoginCommand}"
                                Cursor="Hand"
                                Height="48"
                                BorderThickness="0"
                                Margin="0,0,0,12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder"
                                            Background="{StaticResource PrimaryButtonGradientBrush}"
                                            CornerRadius="14">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#208B58" Opacity="0.30" />
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="➔ " FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="Đăng nhập" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Quick Demo Account Fill Button -->
                        <Button Command="{Binding QuickDemoLoginCommand}"
                                Style="{StaticResource OutlineButton}"
                                Height="36"
                                Padding="0"
                                Margin="0,0,0,18"
                                BorderBrush="#E5DDD0">
                            <TextBlock Text="✨ Đăng nhập nhanh tài khoản mẫu: Minh Đạt" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        </Button>

                        <!-- Social Login Divider -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="1" Background="#EDE5DA" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Hoặc đăng nhập bằng" FontSize="11.5" Foreground="#8C837C" Margin="14,0" />
                            <Border Grid.Column="2" Height="1" Background="#EDE5DA" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 3 Social Buttons -->
                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Button Style="{StaticResource OutlineButton}" Height="38" Padding="0" Margin="0,0,5,0" BorderBrush="#E5DDD0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="G" FontWeight="ExtraBold" Foreground="#EA4335" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Google" FontSize="12" Foreground="#4A403A" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OutlineButton}" Height="38" Padding="0" Margin="3,0,3,0" BorderBrush="#E5DDD0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="f" FontWeight="ExtraBold" Foreground="#1877F2" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Facebook" FontSize="12" Foreground="#4A403A" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OutlineButton}" Height="38" Padding="0" Margin="5,0,0,0" BorderBrush="#E5DDD0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="" FontWeight="ExtraBold" Foreground="#1A1513" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Apple" FontSize="12" Foreground="#4A403A" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- Bottom Switch to Register Link -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Chưa có tài khoản? " FontSize="13" Foreground="#7D746D" />
                            <TextBlock Text="Đăng ký ngay >" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SwitchToRegisterTabCommand}" />
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============================================== -->
                    <!-- TAB 2: REGISTER FORM                           -->
                    <!-- ============================================== -->
                    <StackPanel Grid.Row="2" Visibility="{Binding IsRegisterTab, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Tạo tài khoản mới!" FontSize="25" FontWeight="Bold" Foreground="#1A1513" Margin="0,0,0,5" />
                        <TextBlock Text="Đăng ký thành viên Mộc Ngữ để bắt đầu lộ trình học bài bản" FontSize="13" Foreground="#7D746D" Margin="0,0,0,20" />

                        <!-- Input 1: Họ và tên -->
                        <Border Background="#FAF8F5" BorderBrush="#E5DFD7" BorderThickness="1.2" CornerRadius="12" Height="46" Padding="14,0" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="👤" FontSize="14" Foreground="#9E968F" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" Text="{Binding RegisterFullName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="#1A1513" VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Input 2: Email / Username -->
                        <Border Background="#FAF8F5" BorderBrush="#E5DFD7" BorderThickness="1.2" CornerRadius="12" Height="46" Padding="14,0" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="✉" FontSize="14" Foreground="#9E968F" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" Text="{Binding RegisterUsername, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="#1A1513" VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Input 3: Password -->
                        <Border Background="#FAF8F5" BorderBrush="#E5DFD7" BorderThickness="1.2" CornerRadius="12" Height="46" Padding="14,0" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒" FontSize="14" Foreground="#9E968F" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <PasswordBox x:Name="RegisterPasswordBox" PasswordChanged="RegisterPasswordBox_PasswordChanged" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#1A1513" VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Input 4: Confirm Password -->
                        <Border Background="#FAF8F5" BorderBrush="#E5DFD7" BorderThickness="1.2" CornerRadius="12" Height="46" Padding="14,0" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒" FontSize="14" Foreground="#9E968F" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <PasswordBox x:Name="RegisterConfirmPasswordBox" PasswordChanged="RegisterConfirmPasswordBox_PasswordChanged" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#1A1513" VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Register Button -->
                        <Button Command="{Binding RegisterCommand}"
                                Cursor="Hand"
                                Height="48"
                                BorderThickness="0"
                                Margin="0,0,0,16">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{StaticResource PrimaryButtonGradientBrush}" CornerRadius="14">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#208B58" Opacity="0.30" />
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="✨ " FontSize="14" VerticalAlignment="Center" Foreground="White" />
                                            <TextBlock Text="Đăng ký tài khoản" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Bottom Switch to Login Link -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Đã có tài khoản? " FontSize="13" Foreground="#7D746D" />
                            <TextBlock Text="Đăng nhập ngay >" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SwitchToLoginTabCommand}" />
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
