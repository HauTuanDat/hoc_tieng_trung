                                            <TextBlock Text="Đăng nhập ngay >" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Cursor="Hand">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SwitchToLoginTabCommand}" />
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>