<UserControl x:Class="QuizApp.Views.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1140"
             Background="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Search Header & Chips -->
            <RowDefinition Height="Auto" />
            <!-- 1: Main Content (Results & Detail) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: SEARCH BAR & QUICK SUGGESTION CHIPS               -->
        <!-- ======================================================== -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">
                <!-- Top Row: Back Button & Search Box -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back Button -->
                    <Button Grid.Column="0"
                            Command="{Binding BackCommand}"
                            ToolTip="Trở về Trang chủ"
                            Cursor="Hand"
                            Width="42" Height="42"
                            Background="#F1F5F9"
                            BorderThickness="0"
                            Margin="0,0,14,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                                    <TextBlock Text="←" FontSize="18" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E2E8F0" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Main Search Input Box -->
                    <Border Grid.Column="1"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1.5"
                            CornerRadius="16"
                            Padding="14,4"
                            Height="48">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     Foreground="#0F172A"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     KeyDown="SearchTextBox_KeyDown"
                                     CaretBrush="#2563EB" />

                            <!-- Watermark / Placeholder -->
                            <TextBlock Grid.Column="1"
                                       Text="Nhập chữ Hán (你好), Pinyin (nihao, xuexi) hoặc tiếng Việt (kế toán, học tập)..."
                                       FontSize="13.5"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Clear Button -->
                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCommand}"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="28" Height="28"
                                    Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="14" Background="#E2E8F0">
                                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Search Action Button -->
                    <Button Grid.Column="2"
                            Content="🔍 Tra từ"
                            Command="{Binding SearchCommand}"
                            Cursor="Hand"
                            Height="48"
                            Padding="22,0"
                            Margin="10,0,0,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#2563EB"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1D4ED8" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1E40AF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Bottom Row: Quick Suggestions & Auto-play Option -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Quick Suggestions Chips -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💡 Gợi ý nhanh:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ItemsControl ItemsSource="{Binding QuickSuggestions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.QuickSearchCommand}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Background="#F1F5F9"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            Padding="10,4"
                                            Margin="0,0,6,0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#334155">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#DBEAFE" />
                                                        <Setter TargetName="b" Property="BorderBrush" Value="#93C5FD" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Auto-Play Audio Checkbox -->
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsAutoPlayAudio, Mode=TwoWay}"
                              Content="🔊 Tự động phát âm"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Foreground="#475569"
                              VerticalAlignment="Center"
                              Cursor="Hand" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 1: CONTENT AREA (SPLIT OR HERO + EXAMPLES)           -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="28,20">
            <!-- State 1: Loading Spinner -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔄" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Đang tra từ qua API &amp; nạp câu ví dụ thực tế..." FontSize="15" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" />
                    <TextBlock Text="Đồng bộ nghĩa tiếng Việt, Hán Việt và phát âm chuẩn" FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- State 2: No Results Found -->
            <Border Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border Background="White" CornerRadius="20" Padding="36,32" BorderBrush="#E2E8F0" BorderThickness="1" MaxWidth="480">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔎" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Không tìm thấy từ phù hợp" FontSize="18" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" />
                        <TextBlock Text="Hãy thử tìm bằng chữ Hán giản thể, pinyin không dấu hoặc nghĩa tiếng Việt khác."
                                   FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,16" TextWrapping="Wrap" />
                        <Button Content="Tra lại từ '你好'"
                                Command="{Binding QuickSearchCommand}"
                                CommandParameter="你好"
                                Cursor="Hand"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center"
                                Padding="16,8" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- State 3: Search Results & Detailed Word View -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasResults}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <!-- Left: Match List Column -->
                    <ColumnDefinition Width="300" />
                    <!-- Right: Full Detail & Example Sentences -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT: MATCHED WORDS LIST ================= -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="12,14"
                        Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="6,2,6,10">
                            <TextBlock Text="KẾT QUẢ TÌM KIẾM" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock Text="{Binding SearchResults.Count, StringFormat='{}{0} từ vựng phù hợp'}" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,2,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.SelectWordCommand}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Margin="0,2"
                                                Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="cardBorder"
                                                            Background="#F8FAFC"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <!-- Word & Pinyin -->
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Simplified}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" />
                                                                    <TextBlock Text="{Binding Pinyin, StringFormat='  {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <!-- Han Viet & Meaning -->
                                                                <TextBlock Text="{Binding HanViet, StringFormat='Hán Việt: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0" />
                                                                <TextBlock Text="{Binding PrimaryMeaning}" FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            </StackPanel>

                                                            <!-- HSK Badge -->
                                                            <Border Grid.Column="1"
                                                                    Background="#EFF6FF"
                                                                    CornerRadius="8"
                                                                    Padding="6,3"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding HskBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="cardBorder" Property="Background" Value="#EFF6FF" />
                                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#93C5FD" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ================= RIGHT: HERO DETAIL & MULTIPLE EXAMPLES ================= -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <!-- 1. Hero Word Banner Card -->
                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="26,22"
                                Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#0F172A" Opacity="0.05" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Word, Pinyin, Hán Việt, Audio Buttons -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Typography -->
                                    <StackPanel Grid.Column="0">
                                        <!-- Main Hanzi Word -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedWord.Simplified}"
                                                       FontSize="48"
                                                       FontWeight="ExtraBold"
                                                       Foreground="#0F172A"
                                                       Margin="0,0,16,0" />

                                            <!-- Badges Stack -->
                                            <StackPanel VerticalAlignment="Center">
                                                <!-- Pinyin & Level Row -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SelectedWord.Pinyin}" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8" />
                                                    </Border>
                                                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="10,4">
                                                        <TextBlock Text="{Binding SelectedWord.HskBadgeText}" FontSize="12.5" FontWeight="ExtraBold" Foreground="#B45309" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Han Viet & Traditional Row -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#FFF7ED" CornerRadius="8" Padding="8,3" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SelectedWord.HanVietDisplay}" FontSize="12" FontWeight="Bold" Foreground="#C2410C" />
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectedWord.Traditional, StringFormat='Phồn thể: {0}'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Right: Pronunciation Audio Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Normal Speed Audio Button -->
                                        <Button Command="{Binding PlayWordNormalAudioCommand}"
                                                ToolTip="Nghe phát âm chuẩn (Tốc độ tự nhiên)"
                                                Cursor="Hand"
                                                Background="#E0F2FE"
                                                BorderBrush="#BAE6FD"
                                                BorderThickness="1.5,1.5,1.5,3.5"
                                                Padding="14,10"
                                                Height="48"
                                                Margin="0,0,8,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🔊" FontSize="18" Margin="0,0,6,0" />
                                                            <TextBlock Text="Nghe chuẩn" FontSize="13" FontWeight="Bold" Foreground="#0284C7" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#BAE6FD" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Slow Speed Audio Button -->
                                        <Button Command="{Binding PlayWordSlowAudioCommand}"
                                                ToolTip="Nghe phát âm chậm (-35% tốc độ) để luyện ngữ điệu"
                                                Cursor="Hand"
                                                Background="#E0F7FA"
                                                BorderBrush="#B2EBF2"
                                                BorderThickness="1.5,1.5,1.5,3.5"
                                                Padding="14,10"
                                                Height="48">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🐢" FontSize="18" Margin="0,0,6,0" />
                                                            <TextBlock Text="Nghe chậm" FontSize="13" FontWeight="Bold" Foreground="#0891B2" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#B2EBF2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Row: Radical & Stroke Info -->
                                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Bộ thủ: " FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding SelectedWord.Radical}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,16,0" />

                                        <TextBlock Text="Số nét: " FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding SelectedWord.StrokeCount, StringFormat='{}{0} nét'}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,16,0" />

                                        <TextBlock Text="Nguồn dữ liệu: " FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="API Từ điển Toàn diện &amp; SQL Server" FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 2. Meanings & Mnemonic Card -->
                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="24,20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📚 CÁC NGHĨA TIẾNG VIỆT CHI TIẾT" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,12" />

                                <!-- Meanings List -->
                                <ItemsControl ItemsSource="{Binding SelectedWord.Meanings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Part of speech pill -->
                                                    <Border Grid.Column="0" Background="#DBEAFE" CornerRadius="8" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PartOfSpeech}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" />
                                                    </Border>

                                                    <!-- Vietnamese definition -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Vietnamese}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Mnemonic Tip (Mẹo nhớ chữ Hán chiết tự) -->
                                <Border Background="#FEFCE8"
                                        BorderBrush="#FEF08A"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="16,12"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding SelectedWord.Mnemonic, Converter={StaticResource StringToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💡" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Mẹo ghi nhớ chữ Hán (Chiết tự):" FontSize="12" FontWeight="Bold" Foreground="#A16207" />
                                            <TextBlock Text="{Binding SelectedWord.Mnemonic}" FontSize="13.5" Foreground="#713F12" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="20" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 3. Multiple Example Sentences Card (KÈM NHIỀU VÍ DỤ THỰC TẾ) -->
                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="24,20"
                                Margin="0,0,0,24">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📖 CÂU VÍ DỤ THỰC TẾ &amp; ỨNG DỤNG" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding ExamplesCount, StringFormat='{}Có {0} câu ví dụ kèm phiên âm và phát âm chuẩn'}"
                                                   FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="✨ Nghe phát âm từng câu" FontSize="11.5" FontWeight="Bold" Foreground="#059669" />
                                    </Border>
                                </Grid>

                                <!-- List of Example Cards -->
                                <ItemsControl ItemsSource="{Binding SelectedWord.Examples}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="16,14"
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Hanzi, Pinyin & Meaning -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <!-- Chinese Sentence -->
                                                        <TextBlock Text="{Binding Hanzi}"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   Foreground="#0F172A"
                                                                   TextWrapping="Wrap" />

                                                        <!-- Pinyin -->
                                                        <TextBlock Text="{Binding Pinyin}"
                                                                   FontSize="13.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#2563EB"
                                                                   Margin="0,3,0,0"
                                                                   TextWrapping="Wrap" />

                                                        <!-- Vietnamese Translation -->
                                                        <TextBlock Text="{Binding Meaning}"
                                                                   FontSize="14"
                                                                   Foreground="#475569"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!-- Right: Audio Buttons & Level Tag -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <!-- Source Badge -->
                                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="6,2" Margin="0,0,0,8" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Source}" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                                        </Border>

                                                        <!-- Pronounce Sentence Button -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.PlayExampleAudioCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Nghe câu tốc độ chuẩn"
                                                                    Cursor="Hand"
                                                                    Background="#E0F2FE"
                                                                    BorderBrush="#BAE6FD"
                                                                    BorderThickness="1"
                                                                    Width="38" Height="36"
                                                                    Margin="0,0,6,0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                                            <TextBlock Text="🔊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="b" Property="Background" Value="#BAE6FD" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <!-- Slow Pronounce Sentence Button -->
                                                            <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.PlayExampleSlowAudioCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Nghe câu tốc độ chậm (-35%)"
                                                                    Cursor="Hand"
                                                                    Background="#E0F7FA"
                                                                    BorderBrush="#B2EBF2"
                                                                    BorderThickness="1"
                                                                    Width="38" Height="36">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                                            <TextBlock Text="🐢" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="b" Property="Background" Value="#B2EBF2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>