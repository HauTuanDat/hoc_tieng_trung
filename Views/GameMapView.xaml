<UserControl x:Class="QuizApp.Views.GameMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GameMapViewModel}"
             Background="#F8FAFC">

    <Grid>
        <!-- ============================================== -->
        <!-- MAIN SCROLLABLE GAME ARENA VIEW                -->
        <!-- ============================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,20,32,36" MaxWidth="1180">

                <!-- 1. TOP GAME HUD (ORIENTAL WATERCOLOR BANNER) -->
                <Border CornerRadius="20"
                        Margin="0,0,0,22"
                        Padding="24,18"
                        ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F0F8FF" Offset="0.0" />
                            <GradientStop Color="#E0F2FE" Offset="0.55" />
                            <GradientStop Color="#EBF5FF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Bamboo + Panda Avatar + Player Level & EXP -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Bamboo emoji decoration -->
                            <TextBlock Text="🎋" FontSize="26" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.8" />

                            <!-- Panda Avatar Badge -->
                            <Border Width="60" Height="60" CornerRadius="30"
                                    Background="#FFFFFF"
                                    BorderBrush="#0284C7"
                                    BorderThickness="2"
                                    Margin="0,0,14,0">
                                <TextBlock Text="🐼" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding PlayerName}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Border Background="#0284C7" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PlayerLevel, StringFormat='{}Cấp {0}'}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </StackPanel>

                                <!-- EXP Bar -->
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar Value="{Binding ExpPercent, Mode=OneWay}"
                                                 Width="150" Height="8"
                                                 Maximum="100"
                                                 Style="{StaticResource ModernProgressBarStyle}"
                                                 Foreground="#0284C7"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PlayerExp, StringFormat='{}{0:N0}'}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="10,0,2,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ExpToNextLevel, StringFormat='{}/ {0:N0} EXP'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Center: Game Tokens (Stars, Streak, Gems) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Total Stars -->
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1.2" CornerRadius="14" Padding="14,6" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⭐ " FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalStars}" FontSize="14.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Sao" FontSize="13" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Daily Streak Flame -->
                            <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1.2" CornerRadius="14" Padding="14,6" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔥 " FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StreakDays}" FontSize="14.5" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Ngày chuỗi" FontSize="13" FontWeight="SemiBold" Foreground="#991B1B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Gems / Kim Cương -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.2" CornerRadius="14" Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💎 " FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Gems}" FontSize="14.5" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Kim Cương" FontSize="13" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Pagoda art & Back Button -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏯" FontSize="44" VerticalAlignment="Center" Margin="0,0,14,0" Opacity="0.85" />
                            <Button Command="{Binding BackCommand}"
                                    Cursor="Hand"
                                    Height="38"
                                    Padding="16,0"
                                    Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="19"
                                                Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⮌ " FontSize="13" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                                                <TextBlock Text="Quay lại" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. HSK 1 - HSK 9 WORLD REALM SELECTOR (BÀN CHƠI CẤP ĐỘ) -->
                <StackPanel Margin="0,0,0,20">
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📖 " FontSize="18" Foreground="#0284C7" VerticalAlignment="Center" />
                            <TextBlock Text="Chọn Vương Quốc HSK (1 ➔ 9)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="👑 " FontSize="14" Foreground="#D97706" VerticalAlignment="Center" />
                            <TextBlock Text="Hệ thống 9 cấp độ HSK 3.0 • Mỗi cấp gồm 10 bài thi thách" FontSize="13" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Horizontal Realm Cards Scroll with < and > Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Arrow Button < -->
                        <Button Grid.Column="0"
                                Click="ScrollLeft_Click"
                                Cursor="Hand"
                                Width="36" Height="36"
                                Margin="0,0,8,0"
                                Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="18">
                                        <TextBlock Text="&lt;" FontSize="16" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-1,0,0,0" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ScrollViewer -->
                        <ScrollViewer Grid.Column="1"
                                      x:Name="RealmScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Padding="0,4,0,10">
                            <ItemsControl ItemsSource="{Binding Worlds}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectWorldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Margin="0,0,12,0"
                                                BorderThickness="0"
                                                Background="Transparent">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="realmCard"
                                                                        Width="180"
                                                                        CornerRadius="18"
                                                                        Padding="14,12"
                                                                        Background="#FFFFFF"
                                                                        BorderBrush="#E2E8F0"
                                                                        BorderThickness="1.5"
                                                                        Effect="{DynamicResource CardShadow}">
                                                                    <StackPanel>
                                                                        <!-- Top Row: Level Pill Badge + Selected Checkmark -->
                                                                        <Grid Margin="0,0,0,8">
                                                                            <Border Background="{Binding AccentColor}" CornerRadius="9" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding LevelKey}" FontWeight="ExtraBold" FontSize="11.5" Foreground="White" />
                                                                            </Border>
                                                                            <!-- Selected Checkmark Circle -->
                                                                            <Border Width="22" Height="22" CornerRadius="11" Background="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                                                                <TextBlock Text="✔" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </Grid>

                                                                        <!-- Oriental Architectural Illustration Container -->
                                                                        <Border Height="76" CornerRadius="14" Margin="0,0,0,8" ClipToBounds="True">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                    <GradientStop Color="#F0F9FF" Offset="0" />
                                                                                    <GradientStop Color="#E0F2FE" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                <TextBlock Text="{Binding Icon}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                <TextBlock Text="🌸" FontSize="12" Opacity="0.5" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Realm Title & Subtitle -->
                                                                        <TextBlock Text="{Binding WorldName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                                                                        <!-- Mini Progress Bar -->
                                                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                                     Maximum="100"
                                                                                     Height="5"
                                                                                     Foreground="#0284C7"
                                                                                     Background="#E2E8F0"
                                                                                     Margin="0,0,0,8" />

                                                                        <!-- Bottom Stats: Stars + Levels with Trophy -->
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding StarsText}" FontSize="12" FontWeight="Bold" Foreground="#D97706" />
                                                                            <TextBlock Text="{Binding TrophyText}" FontSize="12" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="realmCard" Property="BorderBrush" Value="#0284C7" />
                                                                        <Setter TargetName="realmCard" Property="Effect" Value="{StaticResource CardHoverShadow}" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="realmCard" Property="BorderBrush" Value="#0284C7" />
                                                                        <Setter TargetName="realmCard" Property="BorderThickness" Value="2" />
                                                                        <Setter TargetName="realmCard" Property="Background" Value="#F0F9FF" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Right Arrow Button > -->
                        <Button Grid.Column="2"
                                Click="ScrollRight_Click"
                                Cursor="Hand"
                                Width="36" Height="36"
                                Margin="8,0,0,0"
                                Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="18">
                                        <TextBlock Text="&gt;" FontSize="16" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 3. CURRENT SELECTED WORLD BANNER (HSK 1 • ĐẢO KHỞI NGUYÊN) -->
                <Border CornerRadius="20"
                        Margin="0,0,0,22"
                        Padding="24,20"
                        BorderBrush="#BAE6FD"
                        BorderThickness="1.2"
                        ClipToBounds="True"
                        Effect="{DynamicResource CardShadow}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F0F8FF" Offset="0.0" />
                            <GradientStop Color="#E0F2FE" Offset="0.55" />
                            <GradientStop Color="#F8FAFC" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Mountain with Flag Emblem -->
                        <Border Grid.Column="0" Width="68" Height="68" CornerRadius="18"
                                Background="#E0F2FE"
                                BorderBrush="#7DD3FC"
                                BorderThickness="2"
                                Margin="0,0,18,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🏔️" FontSize="30" HorizontalAlignment="Center" />
                                <TextBlock Text="🚩" FontSize="14" Margin="0,-16,-12,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Title, Badge & Description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding SelectedWorld.LevelKey}" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,0,8,0" />
                                <TextBlock Text="•" FontSize="20" Foreground="#64748B" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SelectedWorld.WorldName}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,12,0" />
                                <!-- 160 từ vựng Badge -->
                                <Border Background="#DCFCE7" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedWorld.VocabCount, StringFormat='{}{0} từ vựng'}" FontSize="12" FontWeight="Bold" Foreground="#16A34A" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedWorld.Description}" FontSize="13.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>

                        <!-- Right: Tiến độ Vương Quốc Summary -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" HorizontalAlignment="Center">
                            <TextBlock Text="Tiến độ Vương Quốc" FontSize="13" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding SelectedWorld.ProgressText}" FontSize="26" FontWeight="ExtraBold" Foreground="#0284C7" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <ProgressBar Value="{Binding SelectedWorld.ProgressPercent, Mode=OneWay}"
                                         Width="140" Height="7"
                                         Maximum="100"
                                         Foreground="#0284C7"
                                         Background="#CBD5E1"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedWorld.StarsText}" FontSize="13" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Far Right: "▶ Bắt đầu học" Action Button -->
                        <Button Grid.Column="3"
                                Command="{Binding PlayLevelCommand}"
                                Cursor="Hand"
                                Height="44"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="startBtn"
                                            Background="#0284C7"
                                            CornerRadius="22"
                                            Padding="24,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="▶ " FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="Bắt đầu học" FontSize="14.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="startBtn" Property="Background" Value="#0369A1" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="startBtn" Property="Background" Value="#075985" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 4. THE 10 MINI-LEVELS (10 ẢI THỬ THÁCH) -->
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚔️ " FontSize="18" Foreground="#0284C7" VerticalAlignment="Center" />
                            <TextBlock Text="Hành Trình 10 Ải Chinh Phục" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="🏆 " FontSize="14" Foreground="#D97706" VerticalAlignment="Center" />
                            <TextBlock Text="Vượt qua lần lượt từng ải để mở khóa Ải Trùm Cuối " FontSize="13" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center" />
                            <TextBlock Text="👑" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 10 Sub-Levels Grid (2 Columns Responsive Layout) -->
                    <ItemsControl ItemsSource="{Binding SelectedWorld.SubLevels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,16,16"
                                        CornerRadius="18"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1.2"
                                        Padding="18,16"
                                        Effect="{DynamicResource CardShadow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Rosette Ribbon Award Medal (#1, #2, #3, ...) -->
                                        <Grid Grid.Column="0" Width="52" Height="58" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <!-- Ribbon Tails -->
                                            <Path Data="M 16,36 L 8,56 L 18,50 L 26,56 L 24,36 Z" Fill="{Binding RibbonColor}" Opacity="0.85" />
                                            <Path Data="M 26,36 L 24,56 L 34,50 L 44,56 L 36,36 Z" Fill="{Binding RibbonColor}" Opacity="0.85" />

                                            <!-- Rosette Medal Circle -->
                                            <Border Width="44" Height="44" CornerRadius="22"
                                                    Background="{Binding MedalBg}"
                                                    BorderBrush="{Binding MedalBorder}"
                                                    BorderThickness="2"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding MedalNumberText}" FontSize="15" FontWeight="ExtraBold" Foreground="{Binding MedalFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Center: Title, Type Tag, Description & Stars + EXP -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                                <!-- Type Tag (Soft Blue Badge) -->
                                                <Border Background="#E0F2FE" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ChallengeType}" FontSize="11.5" FontWeight="Bold" Foreground="#0284C7" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />

                                            <!-- Stars & Rewards -->
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 3 Stars -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="★" FontSize="15" Margin="0,0,1,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#CBD5E1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Star1Active}" Value="True">
                                                                        <Setter Property="Foreground" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="★" FontSize="15" Margin="0,0,1,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#CBD5E1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Star2Active}" Value="True">
                                                                        <Setter Property="Foreground" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="★" FontSize="15">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#CBD5E1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Star3Active}" Value="True">
                                                                        <Setter Property="Foreground" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Rewards -->
                                                <TextBlock Text="{Binding RewardExp, StringFormat='+{0} EXP'}" FontSize="12.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding RewardGems, StringFormat='+{0} 💎'}" FontSize="12.5" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right: Action Button -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <!-- Completed State (Light Mint Green Pill) -->
                                            <Border Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}"
                                                    Background="#E8F5EE"
                                                    BorderBrush="#BEE5D0"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    Padding="14,7">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✓ " FontSize="13" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" />
                                                    <TextBlock Text="Đã qua ải" FontSize="13" Foreground="#16A34A" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Ready / Current State (Blue Button) -->
                                            <Button Command="{Binding DataContext.PlayLevelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"
                                                    Height="38"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#0284C7"
                                                                CornerRadius="19"
                                                                Padding="18,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="▶ " FontSize="11" Foreground="White" VerticalAlignment="Center" />
                                                                <TextBlock Text="CHƠI NGAY" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Locked State (Grey Pill) -->
                                            <Border Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"
                                                    Background="#F1F5F9"
                                                    CornerRadius="14"
                                                    Padding="14,7">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔒 Khóa" FontSize="12.5" Foreground="#94A3B8" FontWeight="Medium" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================================== -->
        <!-- 5. INTERACTIVE LEVEL POPUP DIALOG MODAL        -->
        <!-- ============================================== -->
        <Border Visibility="{Binding IsLevelDetailOpen, Converter={StaticResource BoolToVisibility}}"
                Background="#99000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="24"
                    Width="500"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{DynamicResource CardShadow}">
                <StackPanel>
                    <!-- Header with Icon & Close Button -->
                    <Grid Margin="0,0,0,16">
                        <Border Width="68" Height="68" CornerRadius="20" Background="#E0F2FE" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSubLevel.Icon}" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button Command="{Binding CloseLevelDetailCommand}"
                                Content="✕"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#94A3B8"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Title & Target HSK -->
                    <TextBlock Text="{Binding SelectedSubLevel.Title}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SelectedWorld.LevelKey, StringFormat='Vương Quốc: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center" Margin="0,0,0,14" />

                    <!-- Description -->
                    <Border Background="#F8FAFC" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                        <TextBlock Text="{Binding SelectedSubLevel.Description}" FontSize="14" Foreground="#475569" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                    </Border>

                    <!-- Mission Checklist -->
                    <TextBlock Text="Nhiệm vụ vượt ải:" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="✔ Trả lời đúng tối thiểu 8/10 câu hỏi thử thách" FontSize="13.5" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBlock Text="✔ Đạt 3 sao khi hoàn thành 100% không mắc lỗi" FontSize="13.5" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBlock Text="✔ Mở khóa ải kế tiếp trong hành trình" FontSize="13.5" Foreground="#475569" />
                    </StackPanel>

                    <!-- Rewards Card -->
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⚡ " FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedSubLevel.RewardExp, StringFormat='+{0} EXP'}" FontSize="15" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💎 " FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedSubLevel.RewardGems, StringFormat='+{0} Kim Cương'}" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Play Button -->
                    <Button Command="{Binding PlayLevelCommand}"
                            Height="48"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#0284C7" CornerRadius="24">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🚀 VÀO CHƠI NGAY" FontSize="15" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
