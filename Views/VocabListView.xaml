<UserControl x:Class="QuizApp.Views.VocabListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VocabListViewModel}"
             Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Header & Total Count -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Danh sách từ vựng" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" />
                <Border Background="{DynamicResource PrimaryTintBrush}" BorderBrush="{DynamicResource PrimaryLightBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4">
                    <TextBlock Text="{Binding TotalItems, StringFormat='{}Tổng cộng: {0:#,0} từ'}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Row 1: Filters Bar (Level, Status, OnlyLearned, Search) -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,14" Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Level Filter ComboBox -->
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding LevelList}"
                          SelectedItem="{Binding SelectedLevel}"
                          Margin="0,0,12,0"
                          Height="36"
                          VerticalContentAlignment="Center" />

                <!-- 2. Status Filter ComboBox -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding StatusList}"
                          SelectedItem="{Binding SelectedStatus}"
                          Margin="0,0,12,0"
                          Height="36"
                          VerticalContentAlignment="Center" />

                <!-- 3. Only Learned Checkbox -->
                <CheckBox Grid.Column="2"
                          Content="Chỉ từ đã học"
                          IsChecked="{Binding OnlyLearned}"
                          VerticalAlignment="Center"
                          FontSize="13"
                          Foreground="{DynamicResource TextSecondaryBrush}" />

                <!-- 4. Search Box -->
                <TextBox Grid.Column="3"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Height="36"
                         Padding="10,6"
                         FontSize="13" />
            </Grid>
        </Border>

        <!-- Row 2: Vocab Table View -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Effect="{DynamicResource CardShadow}">
            <DataGrid ItemsSource="{Binding Vocabularies}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderLightBrush}"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="44">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Background" Value="#FAF6F0" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <!-- STT -->
                    <DataGridTextColumn Header="STT" Binding="{Binding OrderNumber}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Chữ Hán -->
                    <DataGridTextColumn Header="Chữ Hán" Binding="{Binding Word}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="18" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Pinyin -->
                    <DataGridTextColumn Header="Pinyin" Binding="{Binding Pinyin}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Nghĩa tiếng Việt -->
                    <DataGridTextColumn Header="Nghĩa tiếng Việt" Binding="{Binding Meaning}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="13.5" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Cấp độ -->
                    <DataGridTextColumn Header="Cấp độ" Binding="{Binding Level}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Phát âm (Loa) -->
                    <DataGridTemplateColumn Header="Phát âm" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.PlayAudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Word}"
                                        Style="{StaticResource OutlineButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="🔊" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Trạng thái -->
                    <DataGridTemplateColumn Header="Trạng thái" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1EDE6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMastered}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="13" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Chưa học" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMastered}" Value="True">
                                                        <Setter Property="Text" Value="✔ Đã học" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Yêu thích ⭐ -->
                    <DataGridTemplateColumn Header="Yêu thích" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleMasteredCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="⭐" FontSize="15" Foreground="{StaticResource ImperialGoldBrush}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Row 3: Pagination Controls: < [1] [2] [3] [4] [5] > -->
        <Border Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding PrevPageCommand}" Content="‹" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,6,0" />
                <Button Command="{Binding GoToPageCommand}" CommandParameter="1" Content="1" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,6,0" />
                <Button Command="{Binding GoToPageCommand}" CommandParameter="2" Content="2" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,6,0" />
                <Button Command="{Binding GoToPageCommand}" CommandParameter="3" Content="3" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,6,0" />
                <Button Command="{Binding GoToPageCommand}" CommandParameter="4" Content="4" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,6,0" />
                <Button Command="{Binding GoToPageCommand}" CommandParameter="5" Content="5" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,6,0" />
                <Button Command="{Binding NextPageCommand}" Content="›" Style="{StaticResource OutlineButton}" Padding="12,6" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
