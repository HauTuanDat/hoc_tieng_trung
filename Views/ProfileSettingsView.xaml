<UserControl x:Class="QuizApp.Views.ProfileSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfileSettingsViewModel}"
             Background="{StaticResource WindowBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24" MaxWidth="1100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT COLUMN: Profile Card, Stats & Saved Vocab -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <!-- 1. Profile Header Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="{StaticResource PrimaryTintBrush}" BorderBrush="{StaticResource PrimaryLightBorderBrush}" BorderThickness="2" Margin="0,0,16,0">
                            <TextBlock Text="🐼" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- User Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FullName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Email}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                                <TextBlock Text="⭐ Thành viên Premium" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                            </Border>
                        </StackPanel>

                        <!-- Edit Profile Button -->
                        <Button Grid.Column="2" Command="{Binding SaveProfileCommand}" Style="{StaticResource OutlineButton}" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock Text="✏ Chỉnh sửa hồ sơ" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Learning Stats 4-Card UniformGrid -->
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Thống kê học tập" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                        <UniformGrid Columns="2">
                            <!-- Stat 1 -->
                            <Border Background="#FAF6F0" CornerRadius="12" Padding="14,12" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎙" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WordsCount, StringFormat='{}{0:#,0}'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Từ vựng đã học" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Stat 2 -->
                            <Border Background="#FAF6F0" CornerRadius="12" Padding="14,12" Margin="8,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎧" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ListeningCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Bài nghe" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Stat 3 -->
                            <Border Background="#FAF6F0" CornerRadius="12" Padding="14,12" Margin="0,8,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✍" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WritingCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Bài viết" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Stat 4 -->
                            <Border Background="#FAF6F0" CornerRadius="12" Padding="14,12" Margin="8,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ReadingCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Bài đọc" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 3. Saved Vocabulary Quick View -->
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Từ vựng đã lưu" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                        <!-- Sub tabs -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="{StaticResource PrimaryTintBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                                <TextBlock Text="Đang học (12)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                            <Border Background="#F6F1EA" CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                                <TextBlock Text="Đã học (1.248)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="#F6F1EA" CornerRadius="6" Padding="10,4">
                                <TextBlock Text="Đánh dấu (28)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Vocab Items List -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="你好" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                <TextBlock Text="nǐ hǎo" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
                                <TextBlock Text="Xin chào" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="›" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="谢谢" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                <TextBlock Text="xièxie" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
                                <TextBlock Text="Cảm ơn" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="›" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,8" />

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="学习" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                <TextBlock Text="xuéxí" FontSize="13" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0" />
                                <TextBlock Text="Học tập, học" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="›" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================================== -->
            <!-- RIGHT COLUMN: Preferences & Settings           -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="1">
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="24" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Tùy chọn &amp; Cài đặt" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <!-- Audio Toggle -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔊 " FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Âm thanh hiệu ứng" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding IsSoundEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Volume Slider -->
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Âm lượng" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding VolumeLevel, StringFormat='{}{0:0}%'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{Binding VolumeLevel}" Minimum="0" Maximum="100" />
                        </StackPanel>

                        <!-- SQL Server Connection Setting -->
                        <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="Cơ sở dữ liệu SQL Server Localhost" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" FontSize="11.5" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,14">
                            <Button Command="{Binding TestDbConnectionCommand}" Content="Kiểm tra kết nối SQL" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Padding="12,6" FontSize="12" />
                            <TextBlock Text="{Binding DbStatusMessage}" FontSize="11.5" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Change Password Form -->
                        <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="Đổi mật khẩu tài khoản" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                        <TextBlock Text="Mật khẩu hiện tại" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding OldPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,8" />

                        <TextBlock Text="Mật khẩu mới (tối thiểu 6 ký tự)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,8" />

                        <TextBlock Text="Xác nhận mật khẩu mới" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ConfirmNewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,14">
                            <Button Command="{Binding ChangePasswordCommand}" Content="Cập nhật mật khẩu" Style="{StaticResource PrimaryButton}" Padding="16,8" FontSize="12.5" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding PasswordMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Logout Button -->
                        <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,16" />
                        <Button Command="{Binding LogoutCommand}"
                                Style="{StaticResource OutlineButton}"
                                Height="42"
                                BorderBrush="{StaticResource PrimaryLightBorderBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➜] " FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Đăng xuất tài khoản" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

