<UserControl x:Class="QuizApp.Views.SpeakingPracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SpeakingPracticeViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24" MaxWidth="1050">
            <!-- Level Selector Horizontal Tabs -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Command="{Binding SelectLevelCommand}" CommandParameter="HSK 1" Content="📕 HSK 1" Style="{StaticResource NavPillButton}" Margin="0,0,8,0" />
                <Button Command="{Binding SelectLevelCommand}" CommandParameter="HSK 2" Content="📗 HSK 2" Style="{StaticResource NavPillButton}" Margin="0,0,8,0" />
                <Button Command="{Binding SelectLevelCommand}" CommandParameter="Công xưởng" Content="🏭 Công xưởng" Style="{StaticResource NavPillButton}" Margin="0,0,8,0" />
                <Button Command="{Binding SelectLevelCommand}" CommandParameter="Kế toán" Content="🧮 Kế toán" Style="{StaticResource NavPillButton}" Margin="0,0,8,0" />
                <Button Command="{Binding SelectLevelCommand}" CommandParameter="Xuất nhập khẩu" Content="🚢 XNK" Style="{StaticResource NavPillButton}" />
            </StackPanel>

            <!-- Main Speaking Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="32,28"
                    Effect="{DynamicResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Header: Bài 1 • HSK 1 [ HSK 1 ] -->
                    <Grid Grid.Row="0" Margin="0,0,0,22">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LessonTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" />
                            <Border Background="{DynamicResource PrimaryTintBrush}" BorderBrush="{DynamicResource PrimaryLightBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                <TextBlock Text="{Binding CurrentLevel}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Center 2-Column: Left Large Word & Mic | Right AI Score Card -->
                    <Grid Grid.Row="1" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Large Character Box & Mic -->
                        <Border Background="#FAF6F0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,0,20,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Hanzi -->
                                <TextBlock Text="{Binding CurrentHanzi}" FontSize="58" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                <!-- Pinyin -->
                                <TextBlock Text="{Binding CurrentPinyin}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />

                                <!-- Meaning -->
                                <TextBlock Text="{Binding CurrentMeaning}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20" />

                                <!-- Mic & Play Audio Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <!-- Play Audio Button -->
                                    <Button Command="{Binding PlayAudioCommand}"
                                            Style="{StaticResource OutlineButton}"
                                            ToolTip="Nghe phát âm chuẩn"
                                            Padding="14,10"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="🔊 Nghe mẫu" FontSize="13" FontWeight="SemiBold" />
                                    </Button>

                                    <!-- Record Button (Real Microphone & AI check) -->
                                    <Button Command="{Binding ToggleRecordCommand}"
                                            Padding="22,10"
                                            Cursor="Hand"
                                            BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="recBorder"
                                                                    CornerRadius="12"
                                                                    Background="{DynamicResource PrimaryButtonGradientBrush}">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#208B58" Opacity="0.3" />
                                                                </Border.Effect>
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                    <Setter TargetName="recBorder" Property="Background" Value="#DC2626" />
                                                                    <Setter TargetName="recBorder" Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#DC2626" Opacity="0.6" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="recBorder" Property="Opacity" Value="0.9" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding RecordButtonText}" FontSize="13" FontWeight="Bold" Foreground="White" />
                                    </Button>
                                </StackPanel>

                                <!-- Playback User Recording Button -->
                                <Button Command="{Binding PlayUserRecordingCommand}"
                                        Style="{StaticResource OutlineButton}"
                                        Visibility="{Binding HasRecorded, Converter={StaticResource BoolToVisibility}}"
                                        Padding="14,6"
                                        Margin="0,0,0,12"
                                        ToolTip="Nghe lại âm thanh giọng bạn vừa thu">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶ " Foreground="{DynamicResource PrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Nghe lại giọng của bạn" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Recording & Analysis Status Text -->
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Right: AI Pronunciation Assessment Score Card -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Đánh giá phát âm AI" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />

                                <!-- Score Circle -->
                                <Border Width="106" Height="106" CornerRadius="53" BorderThickness="4" Background="#F8FAF8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Score}" Value="0">
                                                    <Setter Property="BorderBrush" Value="#D1D5DB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Score}" FontSize="38" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Điểm AI" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Grade Text -->
                                <TextBlock Text="{Binding ScoreText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,4" />

                                <!-- Stars -->
                                <TextBlock Text="{Binding StarsDisplay}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,12" />

                                <!-- Detailed AI Feedback Box -->
                                <Border Background="#FAF7F2" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" MaxWidth="260">
                                    <TextBlock Text="{Binding FeedbackMessage}" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Sample Dialogue with audio button -->
                    <Border Grid.Row="2" Background="#FFFDFB" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lời thoại mẫu:" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SampleDialogue}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding PlayDialogueAudioCommand}"
                                    Style="{StaticResource OutlineButton}"
                                    Padding="10,6"
                                    VerticalAlignment="Center"
                                    ToolTip="Nghe phát âm câu thoại">
                                <TextBlock Text="🔊" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 3: Bottom Nav Action Buttons -->
                    <Grid Grid.Row="3">
                        <Button Command="{Binding SkipWordCommand}" Content="Bỏ qua" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Padding="20,10" />
                        <Button Command="{Binding NextWordCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Right" Padding="26,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bài tiếp theo " FontWeight="Bold" />
                                <TextBlock Text="➜" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
