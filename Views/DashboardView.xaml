<UserControl x:Class="QuizApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="#EFF6FE">

    <UserControl.Resources>
        <!-- ===== SHADOWS ===== -->
        <DropShadowEffect x:Key="ModernCardShadow"
                          BlurRadius="14" ShadowDepth="1.5" Direction="270"
                          Color="#0F172A" Opacity="0.05" />
        <DropShadowEffect x:Key="ButtonSoftShadow"
                          BlurRadius="8" ShadowDepth="1.5" Direction="270"
                          Color="#000000" Opacity="0.12" />
        <DropShadowEffect x:Key="FlameGlowSmall"
                          BlurRadius="8" ShadowDepth="0" Direction="0"
                          Color="#F97316" Opacity="0.4" />
        <DropShadowEffect x:Key="FlameGlowMedium"
                          BlurRadius="12" ShadowDepth="0" Direction="0"
                          Color="#EF4444" Opacity="0.5" />
        <DropShadowEffect x:Key="FlameGlowLarge"
                          BlurRadius="18" ShadowDepth="0" Direction="0"
                          Color="#FF4500" Opacity="0.65" />

        <!-- ===== LUCIDE ICON PATHS (24x24 standard viewBox) ===== -->
        <!-- book-open -->
        <Geometry x:Key="LucideBookOpen">M 2,3 H 8 C 9.1,3 10,3.5 10.6,4.2 L 12,6 L 13.4,4.2 C 14,3.5 14.9,3 16,3 H 22 V 18 C 22,19.1 21.1,20 20,20 H 16 C 14.9,20 14,20.5 13.4,21.2 L 12,23 L 10.6,21.2 C 10,20.5 9.1,20 8,20 H 4 C 2.9,20 2,19.1 2,18 Z M 12,6 V 23</Geometry>
        <!-- headphones -->
        <Geometry x:Key="LucideHeadphones">M 3,14 V 11 C 3,6 7.03,2 12,2 C 16.97,2 21,6 21,11 V 14 M 5,19 C 3.9,19 3,18.1 3,17 V 14 C 3,12.9 3.9,12 5,12 C 6.1,12 7,12.9 7,14 V 17 C 7,18.1 6.1,19 5,19 Z M 19,19 C 17.9,19 17,18.1 17,17 V 14 C 17,12.9 17.9,12 19,12 C 20.1,12 21,12.9 21,14 V 17 C 21,18.1 20.1,19 19,19 Z</Geometry>
        <!-- pencil-line -->
        <Geometry x:Key="LucidePencil">M 18,2 L 22,6 L 7.5,20.5 L 2,22 L 3.5,16.5 Z M 15,5 L 19,9 M 2,22 H 22</Geometry>
        <!-- volume-2 -->
        <Geometry x:Key="LucideVolume2">M 11,5 L 6,9 H 2 V 15 H 6 L 11,19 Z M 15.54,8.46 C 16.48,9.4 17,10.67 17,12 C 17,13.33 16.48,14.6 15.54,15.54 M 19.07,4.93 C 20.95,6.81 22,9.35 22,12 C 22,14.65 20.95,17.19 19.07,19.07</Geometry>
        <!-- calendar -->
        <Geometry x:Key="LucideCalendar">M 3,6 C 3,4.9 3.9,4 5,4 H 19 C 20.1,4 21,4.9 21,6 V 20 C 21,21.1 20.1,22 19,22 H 5 C 3.9,22 3,21.1 3,20 Z M 3,10 H 21 M 8,2 V 6 M 16,2 V 6 M 8,14 H 8.01 M 12,14 H 12.01 M 16,14 H 16.01 M 8,18 H 8.01 M 12,18 H 12.01 M 16,18 H 16.01</Geometry>
        <!-- target -->
        <Geometry x:Key="LucideTarget">M 12,12 m -1,0 a 1,1 0 1,0 2,0 a 1,1 0 1,0 -2,0 M 12,8 A 4,4 0 1,0 16,12 A 4,4 0 1,0 12,8 Z M 12,4 A 8,8 0 1,0 20,12 A 8,8 0 1,0 12,4 Z M 12,2 V 4 M 12,20 V 22 M 2,12 H 4 M 20,12 H 22</Geometry>
        <!-- graduation-cap -->
        <Geometry x:Key="LucideGraduationCap">M 2,10 L 12,5 L 22,10 L 12,15 Z M 6,12 V 16 C 6,16 9,19 12,19 C 15,19 18,16 18,16 V 12 M 22,10 V 16</Geometry>
        <!-- flame outer -->
        <Geometry x:Key="LucideFlameOuter">M 12,2 C 12,2 5,8.5 5,14 C 5,17.9 8.1,21 12,21 C 15.9,21 19,17.9 19,14 C 19,8.5 12,2 12,2 Z</Geometry>
        <!-- flame inner core -->
        <Geometry x:Key="LucideFlameInner">M 12,9 C 12,9 8,13 8,15.5 C 8,17.7 9.8,19.5 12,19.5 C 14.2,19.5 16,17.7 16,15.5 C 16,13 12,9 12,9 Z</Geometry>
        <!-- flame stroke line (Lucide default) -->
        <Geometry x:Key="LucideFlameStroke">M 8.5,14.5 C 8.5,16.4 9.6,18 12,18 C 14.4,18 15.5,16.4 15.5,14.5 C 15.5,11.5 12,8 12,8 C 12,8 8.5,11.5 8.5,14.5 Z M 12,2 C 12,2 6,8.5 6,14 C 6,17.3 8.7,20 12,20 C 15.3,20 18,17.3 18,14 C 18,8.5 12,2 12,2 Z</Geometry>
        <!-- bar-chart-3 -->
        <Geometry x:Key="LucideBarChart3">M 12,20 V 10 M 18,20 V 4 M 6,20 V 16</Geometry>
        <!-- award -->
        <Geometry x:Key="LucideAward">M 12,2 A 5,5 0 1,0 17,7 A 5,5 0 1,0 12,2 Z M 8.21,13.89 L 7,23 L 12,20 L 17,23 L 15.79,13.88</Geometry>
        <!-- trending-up -->
        <Geometry x:Key="LucideTrendingUp">M 22,7 L 13.5,15.5 L 8.5,10.5 L 2,17 M 16,7 H 22 V 13</Geometry>
        <!-- zap -->
        <Geometry x:Key="LucideZap">M 13,2 L 3,14 H 12 L 11,22 L 21,10 H 12 Z</Geometry>
        <!-- clock -->
        <Geometry x:Key="LucideClock">M 12,2 A 10,10 0 1,0 22,12 A 10,10 0 1,0 12,2 Z M 12,6 V 12 L 16,14</Geometry>

        <!-- ===== METRIC CARD BUTTON STYLE ===== -->
        <Style x:Key="MetricCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource ModernCardShadow}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#93C5FD" />
                                <Setter TargetName="cardBorder" Property="Background" Value="#FAFDFE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== SIDEBAR CARD STYLE ===== -->
        <Style x:Key="SidebarCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Effect" Value="{StaticResource ModernCardShadow}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,28" MaxWidth="1260">

            <!-- ================================================================ -->
            <!-- 1. TOP HEADER BANNER (SEAMLESS GRADIENT & PERFECT CIRCLES)       -->
            <!-- ================================================================ -->
            <Border CornerRadius="16"
                    Margin="0,0,0,18"
                    ClipToBounds="True"
                    Height="128"
                    Effect="{StaticResource ModernCardShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#349CFD" Offset="0.0" />
                        <GradientStop Color="#3A87FD" Offset="0.2" />
                        <GradientStop Color="#4E76FC" Offset="0.4" />
                        <GradientStop Color="#7A72FC" Offset="0.6" />
                        <GradientStop Color="#9573FD" Offset="0.8" />
                        <GradientStop Color="#BEA5FA" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Soft Purple Cloud Silhouettes at Bottom Right (from Image 1) -->
                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="360" Height="65" IsHitTestVisible="False" Opacity="0.35">
                        <Ellipse Canvas.Left="20" Canvas.Top="20" Width="140" Height="80" Fill="#C084FC" />
                        <Ellipse Canvas.Left="100" Canvas.Top="10" Width="150" Height="85" Fill="#A855F7" />
                        <Ellipse Canvas.Left="190" Canvas.Top="15" Width="170" Height="85" Fill="#C084FC" />
                    </Canvas>

                    <!-- Right: 100% Mathematically Perfect Circular Panda Avatar with Glowing Halo -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,32,0">
                        <!-- Outer Soft Glowing Purple Halo -->
                        <Ellipse Width="112" Height="112"
                                 Fill="#30FFFFFF"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#A855F7" Opacity="0.55" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Circular Panda Badge (Strictly 1:1, Never Oval) -->
                        <Border Width="88" Height="88" CornerRadius="44"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Image Source="/Assets/panda_avatar_round.png"
                                   Width="88" Height="88"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Grid>

                    <!-- Left: Typography & Action Button with Balanced Badge -->
                    <Grid Margin="26,0,26,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Balanced Left Badge: Matches the Right Panda in Size, Style & Soft Glow -->
                        <Grid Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                            <!-- Outer Soft Glowing Halo (matching right panda halo) -->
                            <Ellipse Width="74" Height="74"
                                     Fill="#25FFFFFF"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#60A5FA" Opacity="0.45" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- Circular Badge with Sky/Mint Tint & Border (matching right panda circle) -->
                            <Border Width="62" Height="62" CornerRadius="31"
                                    Background="#E0F2FE"
                                    BorderBrush="#BAE6FD"
                                    BorderThickness="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path Data="{StaticResource LucideGraduationCap}"
                                      Stroke="#0284C7"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="28" Height="28"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,3"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType">
                                <Run Text="Chào mừng bạn trở lại, " /><Run Text="{Binding CurrentUser.FullName, TargetNullValue='Minh Đạt'}" /><Run Text="!" />
                            </TextBlock>

                            <TextBlock Text="Học tiếng Trung mỗi ngày, tiến bộ từng chút một nhé!"
                                       FontSize="13"
                                       Foreground="#E0E7FF"
                                       FontWeight="Medium"
                                       Margin="0,0,0,10"
                                       TextOptions.TextFormattingMode="Display" />

                            <!-- Pill Button: Tiếp tục học → -->
                            <Button Command="{Binding ContinueLearningCommand}"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    BorderThickness="0" Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder"
                                                Background="#FFFFFF"
                                                CornerRadius="18"
                                                Padding="18,6.5"
                                                Effect="{StaticResource ButtonSoftShadow}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Tiếp tục học"
                                                           FontSize="12.5"
                                                           FontWeight="Bold"
                                                           Foreground="#1E3A8A"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text=" →"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#1E3A8A"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.88" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- 2. TWO-COLUMN LAYOUT BELOW BANNER                                 -->
            <!-- ================================================================ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.85*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" MinWidth="340" MaxWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- ============================================================ -->
                <!-- LEFT COLUMN: Main Content (Metric Cards, Courses, HSK tracks) -->
                <!-- ============================================================ -->
                <StackPanel Grid.Column="0">

                    <!-- A. 5 LEARNING METRIC CARDS IN 1 CLEAN ROW -->
                    <UniformGrid Columns="5" Margin="0,0,0,16">

                        <!-- 1. Từ vựng đã học -->
                        <Button Command="{Binding OpenVocabListCommand}"
                                CommandParameter="ALL"
                                Style="{StaticResource MetricCardButtonStyle}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Từ vựng đã học"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border HorizontalAlignment="Right"
                                            Width="28" Height="28" CornerRadius="8"
                                            Background="#DCFCE7">
                                        <Path Data="{StaticResource LucideBookOpen}"
                                              Stroke="#16A34A"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding MasteredVocabularies, TargetNullValue=0, StringFormat='{}{0:#,0}'}"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="#0F172A" Margin="0,0,0,1" />
                                <TextBlock Text="/ 3.000 từ"
                                           FontSize="11.5" Foreground="#94A3B8"
                                           Margin="0,0,0,10" />
                                <Grid Height="4">
                                    <Border Background="#E2EAF4" CornerRadius="2" />
                                    <Border HorizontalAlignment="Left" Width="20" Background="#93C5FD" CornerRadius="2" />
                                </Grid>
                            </StackPanel>
                        </Button>

                        <!-- 2. Luyện nghe -->
                        <Button Command="{Binding StartQuizHanziCommand}"
                                CommandParameter="HSK 1"
                                Style="{StaticResource MetricCardButtonStyle}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Luyện nghe"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border HorizontalAlignment="Right"
                                            Width="28" Height="28" CornerRadius="8"
                                            Background="#E0F2FE">
                                        <Path Data="{StaticResource LucideHeadphones}"
                                              Stroke="#0284C7"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding ListeningCount, TargetNullValue=0}"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="#0F172A" Margin="0,0,0,1" />
                                <TextBlock Text="/ 50 bài"
                                           FontSize="11.5" Foreground="#94A3B8"
                                           Margin="0,0,0,10" />
                                <Grid Height="4">
                                    <Border Background="#E2EAF4" CornerRadius="2" />
                                    <Border HorizontalAlignment="Left" Width="16" Background="#93C5FD" CornerRadius="2" />
                                </Grid>
                            </StackPanel>
                        </Button>

                        <!-- 3. Luyện viết -->
                        <Button Command="{Binding OpenTypingPracticeCommand}"
                                CommandParameter="HSK 1"
                                Style="{StaticResource MetricCardButtonStyle}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Luyện viết"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border HorizontalAlignment="Right"
                                            Width="28" Height="28" CornerRadius="8"
                                            Background="#DCFCE7">
                                        <Path Data="{StaticResource LucidePencil}"
                                              Stroke="#16A34A"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding WritingCount, TargetNullValue=0}"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="#0F172A" Margin="0,0,0,1" />
                                <TextBlock Text="/ 40 bài"
                                           FontSize="11.5" Foreground="#94A3B8"
                                           Margin="0,0,0,10" />
                                <Grid Height="4">
                                    <Border Background="#E2EAF4" CornerRadius="2" />
                                    <Border HorizontalAlignment="Left" Width="16" Background="#93C5FD" CornerRadius="2" />
                                </Grid>
                            </StackPanel>
                        </Button>

                        <!-- 4. Luyện đọc -->
                        <Button Command="{Binding StartQuizCommand}"
                                CommandParameter="HSK 1"
                                Style="{StaticResource MetricCardButtonStyle}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Luyện đọc"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border HorizontalAlignment="Right"
                                            Width="28" Height="28" CornerRadius="8"
                                            Background="#E0F2FE">
                                        <Path Data="{StaticResource LucideVolume2}"
                                              Stroke="#0284C7"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding ReadingCount, TargetNullValue=0}"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="#0F172A" Margin="0,0,0,1" />
                                <TextBlock Text="/ 40 bài"
                                           FontSize="11.5" Foreground="#94A3B8"
                                           Margin="0,0,0,10" />
                                <Grid Height="4">
                                    <Border Background="#E2EAF4" CornerRadius="2" />
                                    <Border HorizontalAlignment="Left" Width="16" Background="#93C5FD" CornerRadius="2" />
                                </Grid>
                            </StackPanel>
                        </Button>

                        <!-- 5. Sắp xếp câu -->
                        <Button Command="{Binding OpenSentenceScrambleCommand}"
                                CommandParameter="HSK 1"
                                Style="{StaticResource MetricCardButtonStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Sắp xếp câu"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border HorizontalAlignment="Right"
                                            Width="28" Height="28" CornerRadius="8"
                                            Background="#DCFCE7">
                                        <Path Data="{StaticResource LucideCalendar}"
                                              Stroke="#16A34A"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding SentenceCount, TargetNullValue=0}"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="#0F172A" Margin="0,0,0,1" />
                                <TextBlock Text="/ 30 bài"
                                           FontSize="11.5" Foreground="#94A3B8"
                                           Margin="0,0,0,10" />
                                <Grid Height="4">
                                    <Border Background="#E2EAF4" CornerRadius="2" />
                                    <Border HorizontalAlignment="Left" Width="16" Background="#93C5FD" CornerRadius="2" />
                                </Grid>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- B. TIẾP TỤC HỌC (CONTINUE LEARNING PROMINENT CARD) -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1.2"
                            CornerRadius="16"
                            Padding="20,18"
                            Margin="0,0,0,16"
                            Effect="{StaticResource ModernCardShadow}">
                        <StackPanel>
                            <!-- Section Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Data="{StaticResource LucideGraduationCap}"
                                      Stroke="#16A34A"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Tiếp tục học"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Course Action Banner -->
                            <Border Background="#F0FDF4"
                                    BorderBrush="#DCFCE7"
                                    BorderThickness="1.2"
                                    CornerRadius="14"
                                    Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Hanzi Badge -->
                                    <Border Grid.Column="0"
                                            Width="46" Height="46" CornerRadius="12"
                                            Background="#DCFCE7"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="汉"
                                                   FontFamily="{StaticResource ChineseFontFamily}"
                                                   FontSize="22" FontWeight="Bold"
                                                   Foreground="#16A34A"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Course Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="HSK 3 - Bài 12: Gia đình"
                                                   FontSize="14.5" FontWeight="Bold"
                                                   Foreground="#0F172A"
                                                   Margin="0,0,0,3"
