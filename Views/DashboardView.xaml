<UserControl x:Class="QuizApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             xmlns:views="clr-namespace:QuizApp.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="#F2F6FF">

    <UserControl.Resources>
        <!-- Soft Elevation Shadows -->
        <DropShadowEffect x:Key="HeroShadow"
                          BlurRadius="25"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#6988BB"
                          Opacity="0.14" />

        <DropShadowEffect x:Key="QuickCardShadow"
                          BlurRadius="18"
                          ShadowDepth="5"
                          Direction="270"
                          Color="#5677A5"
                          Opacity="0.16" />

        <DropShadowEffect x:Key="PanelShadow"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#304B70"
                          Opacity="0.08" />

        <DropShadowEffect x:Key="StreakPillShadow"
                          BlurRadius="16"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#D8A85C"
                          Opacity="0.18" />

        <!-- Lucide Monoline Vector Geometries (24x24) -->
        <Geometry x:Key="IconSparkles">M 9.937,15.5 A 2,2 0 0 0 8.5,14.063 L 2.35,12.482 A 0.5,0.5 0 0 1 2.35,11.518 L 8.5,9.937 A 2,2 0 0 0 9.937,8.5 L 11.518,2.35 A 0.5,0.5 0 0 1 12.482,2.35 L 14.063,8.5 A 2,2 0 0 0 15.5,9.937 L 21.65,11.518 A 0.5,0.5 0 0 1 21.65,12.482 L 15.5,14.063 A 2,2 0 0 0 14.063,15.5 L 12.482,21.65 A 0.5,0.5 0 0 1 11.518,21.65 Z M 20,3 V 7 M 22,5 H 18 M 4,17 V 19 M 5,18 H 3</Geometry>
        <Geometry x:Key="IconBookOpen">M 2,3 H 8 A 4,4 0 0 1 12,7 V 21 A 3,3 0 0 0 9,18 H 2 Z M 22,3 H 16 A 4,4 0 0 0 12,7 V 21 A 3,3 0 0 1 15,18 H 22 Z</Geometry>
        <Geometry x:Key="IconRocket">M 4.5,16.5 C 3,17.76 2.5,21.5 2.5,21.5 C 2.5,21.5 6.24,21 7.5,19.5 C 8.21,18.66 8.2,17.37 7.41,16.59 C 7.02,16.21 6.5,16 5.96,16 C 5.42,16 4.91,16.21 4.5,16.5 Z M 12,15 L 9,12 C 9.53,10.62 10.2,9.3 11,8.07 C 13.36,4.28 17.5,2.24 22,2 C 22,4.72 21.22,9.5 16,13 C 14.74,13.79 13.4,14.46 12,15 Z M 9,12 H 4 C 4,12 4.55,8.97 6,8 C 7.62,6.92 11,8 11,8 M 12,15 V 20 C 12,20 15.03,19.45 16,18 C 17.08,16.38 16,13 16,13</Geometry>
        <Geometry x:Key="IconTrophy">M 6,9 H 4.5 A 2.5,2.5 0 0 1 4.5,4 H 6 M 18,9 H 19.5 A 2.5,2.5 0 0 0 19.5,4 H 18 M 4,22 H 20 M 10,14.66 V 17 C 10,17.55 9.53,17.98 9.03,18.21 C 7.85,18.75 7,20.24 7,22 M 14,14.66 V 17 C 14,17.55 14.47,17.98 14.97,18.21 C 16.15,18.75 17,20.24 17,22 M 18,2 H 6 V 9 A 6,6 0 0 0 18,9 Z</Geometry>
        <Geometry x:Key="IconBot">M 12,8 V 4 H 8 M 4,8 H 20 V 20 H 4 Z M 2,14 H 4 M 20,14 H 22 M 15,13 V 15 M 9,13 V 15</Geometry>
        <Geometry x:Key="IconArrowRight">M 5,12 H 19 M 12,5 L 19,12 L 12,19</Geometry>
        <Geometry x:Key="IconTrendingUp">M 22,7 L 13.5,15.5 L 8.5,10.5 L 2,17 M 16,7 H 22 V 13</Geometry>
        <Geometry x:Key="IconGift">M 20,12 V 22 H 4 V 12 M 2,7 H 22 V 12 H 2 Z M 12,22 V 7 M 12,7 H 7.5 A 2.5,2.5 0 0 1 7.5,2 C 11,2 12,7 12,7 Z M 12,7 H 16.5 A 2.5,2.5 0 0 0 16.5,2 C 13,2 12,7 12,7 Z</Geometry>
        <Geometry x:Key="IconTarget">M 12,2 A 10,10 0 1,0 22,12 A 10,10 0 1,0 12,2 Z M 12,6 A 6,6 0 1,0 18,12 A 6,6 0 1,0 12,6 Z M 12,10 A 2,2 0 1,0 14,12 A 2,2 0 1,0 12,10 Z</Geometry>
        <Geometry x:Key="IconFlame">M 8.5,14.5 A 2.5,2.5 0 0 0 11,12 C 11,10.62 10.5,9.5 10,8 C 12.2,9 14,11 14,13.5 C 14,15.71 12.21,17.5 10,17.5 C 7.79,17.5 6,15.71 6,13.5 C 6,11.8 6.8,10.2 8,9 C 8,10.5 8.5,12.5 8.5,14.5 Z M 12,2 C 12,2 5,8.5 5,14 C 5,17.87 8.13,21 12,21 C 15.87,21 19,17.87 19,14 C 19,8.5 12,2 12,2 Z</Geometry>

        <!-- Focus Visual -->
        <Style x:Key="DashboardFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#2584E9" BorderThickness="2" CornerRadius="16" Margin="-3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Gradient Card Button -->
        <Style x:Key="QuickActionCardStyle" TargetType="Button">
            <Setter Property="Height" Value="92" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="7" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DashboardFocusVisual}" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-4" Duration="0:0:0.20">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="1" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text Link Button ("Xem chi tiết ->", "Xem tất cả ->") -->
        <Style x:Key="TextLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#4778B6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DashboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel x:Name="linkStack" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" />
                            <Viewbox Width="15" Height="15" Margin="5,1,0,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconArrowRight}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1D5CC0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="linkStack" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel White Card Container -->
        <Style x:Key="WhitePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5EBF5" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
        </Style>

        <!-- Featured Course Pastel Card Button -->
        <Style x:Key="FeaturedCourseCardStyle" TargetType="Button">
            <Setter Property="Height" Value="148" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DashboardFocusVisual}" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-3" Duration="0:0:0.20">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="{Binding PagePadding, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel MaxWidth="1560" HorizontalAlignment="Stretch">

                <!-- ============================================================ -->
                <!-- 1. HERO WELCOME BANNER                                       -->
                <!-- ============================================================ -->
                <Grid Margin="0,0,0,16">
                    <!-- Unclipped Shadow & Gradient Shell -->
                    <Border CornerRadius="22" Effect="{StaticResource HeroShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                <GradientStop Color="#E8F5FF" Offset="0.0" />
                                <GradientStop Color="#E8EDFF" Offset="0.48" />
                                <GradientStop Color="#FBE8F2" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Clipped Inner Hero Content -->
                    <Border CornerRadius="22"
                            MinHeight="214"
                            views:DashboardView.RoundedClipRadius="22"
                            Background="Transparent">
                        <Grid>
                            <!-- Vector Landscape + Pagoda + Blossoms + Panda Art -->
                            <views:DashboardArtworkControl ArtworkKey="hero" />

                            <!-- Left Copy & Streak Pill -->
                            <StackPanel Margin="34,26,34,24" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="540">
                                <!-- Eyebrow -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSparkles}"
                                              Stroke="#5283B6"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Viewbox>
                                    <TextBlock Text="MỖI NGÀY MỘT CHÚT"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#5283B6"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Main Greeting -->
                                <TextBlock FontSize="30"
                                           FontWeight="ExtraBold"
                                           Foreground="#18345C"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4">
                                    <Run Text="Xin chào, " /><Run Text="{Binding CurrentUser.FullName, TargetNullValue='Minh Đạt'}" /><Run Text="!" />
                                </TextBlock>

                                <TextBlock Text="Học hôm nay – Vững vàng tương lai"
                                           FontSize="15"
                                           FontWeight="Medium"
                                           Foreground="#577392"
                                           Margin="0,0,0,18" />

                                <!-- Streak Pill + Quote Row -->
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#F2FFF9ED"
                                            CornerRadius="18"
                                            Padding="16,10"
                                            Margin="0,0,16,4"
                                            Effect="{StaticResource StreakPillShadow}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Vector Flame Icon -->
                                            <Viewbox Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconFlame}"
                                                      Stroke="#EA580C"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round">
                                                    <Path.Fill>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="#FDE047" Offset="0.0" />
                                                            <GradientStop Color="#F97316" Offset="0.65" />
                                                            <GradientStop Color="#EA580C" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Path.Fill>
                                                </Path>
                                            </Viewbox>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="23" FontWeight="ExtraBold" Foreground="#263D61" LineHeight="24">
                                                    <Run Text="{Binding CurrentStreak, TargetNullValue=0}" /><Run Text=" ngày" FontSize="14" FontWeight="Bold" />
                                                </TextBlock>
                                                <TextBlock Text="Chuỗi ngày học" FontSize="11" Foreground="#657B97" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#99FFFFFF"
                                            CornerRadius="14"
                                            Padding="14,9"
                                            Margin="0,0,0,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="“Kiên trì hôm nay,&#x0a;thành công ngày mai!”"
                                                   FontSize="12"
                                                   FontStyle="Italic"
                                                   Foreground="#546D8D"
                                                   LineHeight="17" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================================ -->
                <!-- 2. 4 QUICK ACTION GRADIENT CARDS                             -->
                <!-- ============================================================ -->
                <UniformGrid Columns="{Binding QuickGridColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Margin="-7,0,-7,14">

                    <!-- 1. Bắt đầu học (Green) -->
                    <Button Style="{StaticResource QuickActionCardStyle}"
                            Command="{Binding OpenVocabStudyCommand}"
                            CommandParameter="HSK 1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="19" Effect="{StaticResource QuickCardShadow}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                            <GradientStop Color="#38C987" Offset="0" />
                                            <GradientStop Color="#16A86D" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border CornerRadius="19" views:DashboardView.RoundedClipRadius="19">
                                        <Grid Margin="15,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.ColumnSpan="3" Width="135" Height="135" Stroke="#45FFFFFF" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,-95" />
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="15" Background="#36FFFFFF" Margin="0,0,12,0">
                                                <Viewbox Width="26" Height="26">
                                                    <Path Data="{StaticResource IconBookOpen}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Bắt đầu học" FontSize="15" FontWeight="ExtraBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="HSK 1 →" FontSize="12" Foreground="#EBFFFFFF" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" Background="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Data="{StaticResource IconArrowRight}" Stroke="#16A86D" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 2. Luyện phản xạ (Purple) -->
                    <Button Style="{StaticResource QuickActionCardStyle}"
                            Command="{Binding DataContext.NavigateToSpeakingCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="19" Effect="{StaticResource QuickCardShadow}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                            <GradientStop Color="#B06AF3" Offset="0" />
                                            <GradientStop Color="#8249E6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border CornerRadius="19" views:DashboardView.RoundedClipRadius="19">
                                        <Grid Margin="15,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.ColumnSpan="3" Width="135" Height="135" Stroke="#45FFFFFF" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,-95" />
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="15" Background="#36FFFFFF" Margin="0,0,12,0">
                                                <Viewbox Width="26" Height="26">
                                                    <Path Data="{StaticResource IconRocket}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Luyện phản xạ" FontSize="15" FontWeight="ExtraBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Nói tiếng Trung" FontSize="12" Foreground="#EBFFFFFF" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" Background="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Data="{StaticResource IconArrowRight}" Stroke="#8249E6" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 3. Đấu trường HSK (Orange) -->
                    <Button Style="{StaticResource QuickActionCardStyle}"
                            Command="{Binding DataContext.NavigateToGameMapCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="19" Effect="{StaticResource QuickCardShadow}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                            <GradientStop Color="#FFC45E" Offset="0" />
                                            <GradientStop Color="#F58B35" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border CornerRadius="19" views:DashboardView.RoundedClipRadius="19">
                                        <Grid Margin="15,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.ColumnSpan="3" Width="135" Height="135" Stroke="#45FFFFFF" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,-95" />
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="15" Background="#36FFFFFF" Margin="0,0,12,0">
                                                <Viewbox Width="26" Height="26">
                                                    <Path Data="{StaticResource IconTrophy}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Đấu trường HSK" FontSize="15" FontWeight="ExtraBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Thử thách ngay" FontSize="12" Foreground="#EBFFFFFF" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" Background="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Data="{StaticResource IconArrowRight}" Stroke="#F58B35" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 4. Trợ lý AI (Blue) -->
                    <Button Style="{StaticResource QuickActionCardStyle}"
                            Command="{Binding OpenDictionaryCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="19" Effect="{StaticResource QuickCardShadow}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                            <GradientStop Color="#5BC8F2" Offset="0" />
                                            <GradientStop Color="#4A83EE" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border CornerRadius="19" views:DashboardView.RoundedClipRadius="19">
                                        <Grid Margin="15,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.ColumnSpan="3" Width="135" Height="135" Stroke="#45FFFFFF" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,-95" />
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="15" Background="#36FFFFFF" Margin="0,0,12,0">
                                                <Viewbox Width="26" Height="26">
                                                    <Path Data="{StaticResource IconBot}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Trợ lý AI" FontSize="15" FontWeight="ExtraBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Hỏi đáp thông minh" FontSize="12" Foreground="#EBFFFFFF" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" Background="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Data="{StaticResource IconArrowRight}" Stroke="#4A83EE" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </UniformGrid>

                <!-- ============================================================ -->
                <!-- 3. TWO-COLUMN MAIN DASHBOARD CONTENT                         -->
                <!-- ============================================================ -->
                <Grid x:Name="MainColumnsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.85*" />
                        <ColumnDefinition x:Name="ColGap" Width="18" />
                        <ColumnDefinition x:Name="ColRight" Width="0.95*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- LEFT PRIMARY COLUMN -->
                    <StackPanel Grid.Column="0" Grid.Row="0">

                        <!-- A. TIẾN ĐỘ HỌC TẬP -->
                        <Border Style="{StaticResource WhitePanelStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconTrendingUp}"
                                                  Stroke="#2584E9"
                                                  StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Viewbox>
                                        <TextBlock Text="Tiến độ học tập"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#203653"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Content="Xem chi tiết"
                                            Style="{StaticResource TextLinkButtonStyle}"
                                            Command="{Binding OpenLearnedVocabCommand}"
                                            CommandParameter="HSK 1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Circular Progress Ring -->
                                    <Grid Grid.Column="0" Width="140" Height="140" VerticalAlignment="Center">
                                        <Ellipse Width="122" Height="122"
                                                 Stroke="#E8EEF5"
                                                 StrokeThickness="11"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                        <Path Stroke="#24B77C"
                                              StrokeThickness="11"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              views:DashboardView.ProgressArcPercent="{Binding OverallProgressPercent}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OverallProgressPercent, StringFormat='{}{0}%'}"
                                                       FontSize="28"
                                                       FontWeight="ExtraBold"
                                                       Foreground="#1B4560"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Tổng tiến độ"
                                                       FontSize="11"
                                                       Foreground="#8292A8"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Current Lesson Banner Card -->
                                    <Border Grid.Column="2"
                                            CornerRadius="17"
                                            MinHeight="144"
                                            views:DashboardView.RoundedClipRadius="17">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F7FBFF" Offset="0" />
                                                <GradientStop Color="#ECF5FF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <views:DashboardArtworkControl ArtworkKey="lesson" />

                                            <StackPanel Margin="20,18" VerticalAlignment="Center">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                                    <TextBlock Text="HSK 3 – Bài 12: Gia đình"
                                                               FontSize="15.5"
                                                               FontWeight="Bold"
                                                               Foreground="#1E3453"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0" />
                                                    <Border Background="#DCF8EB" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                                        <TextBlock Text="Đang học" FontSize="11" FontWeight="Bold" Foreground="#159A63" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Linear Progress Track (60%) -->
                                                <Grid Height="8" MaxWidth="360" HorizontalAlignment="Left" Width="280" Margin="0,0,0,14">
                                                    <Border Background="#E4EBF4" CornerRadius="4" />
                                                    <Border Width="168" HorizontalAlignment="Left" CornerRadius="4">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#28B879" Offset="0" />
                                                                <GradientStop Color="#62D5A0" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Từ vựng • 12 phút • Hoàn thành 60%"
                                                               FontSize="12"
                                                               Foreground="#6C809B"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,12,0" />

                                                    <Button Grid.Column="1"
                                                            Command="{Binding ContinueLearningCommand}"
                                                            Cursor="Hand"
                                                            BorderThickness="0"
                                                            FocusVisualStyle="{StaticResource DashboardFocusVisual}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="btnCont" CornerRadius="20" Padding="18,10">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                                                            <GradientStop Color="#20B779" Offset="0" />
                                                                            <GradientStop Color="#0E9C69" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="Tiếp tục học" FontSize="12.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                                        <Viewbox Width="15" Height="15" Margin="6,1,0,0" VerticalAlignment="Center">
                                                                            <Path Data="{StaticResource IconArrowRight}" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                                        </Viewbox>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="btnCont" Property="Opacity" Value="0.92" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="btnCont" Property="Opacity" Value="0.8" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- B. KHÓA HỌC NỔI BẬT -->
                        <Border Style="{StaticResource WhitePanelStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconBookOpen}"
                                                  Stroke="#2584E9"
                                                  StrokeThickness="2.1"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Viewbox>
                                        <TextBlock Text="Khóa học nổi bật"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#203653"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Content="Xem tất cả"
                                            Style="{StaticResource TextLinkButtonStyle}"
                                            Command="{Binding DataContext.NavigateToCoursesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <UniformGrid Columns="{Binding FeaturedGridColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Margin="-6,0,-6,0">

                                    <!-- Featured 1: HSK 1 -->
                                    <Button Style="{StaticResource FeaturedCourseCardStyle}"
                                            Command="{Binding OpenVocabStudyCommand}"
                                            CommandParameter="HSK 1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="17"
                                                        BorderBrush="#C6E3FF"
                                                        BorderThickness="1"
                                                        views:DashboardView.RoundedClipRadius="17">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#E3F3FF" Offset="0" />
                                                            <GradientStop Color="#C8E4FF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                        <views:DashboardArtworkControl ArtworkKey="featured-hsk1" />
                                                        <StackPanel Margin="16,16,46,16" VerticalAlignment="Top">
                                                            <TextBlock Text="HSK 1" FontSize="20" FontWeight="ExtraBold" Foreground="#1454A3" />
                                                            <TextBlock Text="Cơ bản" FontSize="13" FontWeight="Bold" Foreground="#1454A3" Margin="0,2,0,6" />
                                                            <TextBlock Text="Bắt đầu hành trình tiếng Trung" FontSize="10.5" Foreground="#53739B" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Width="32" Height="32" CornerRadius="16" Background="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12">
                                                            <Viewbox Width="16" Height="16">
                                                                <Path Data="{StaticResource IconArrowRight}" Stroke="#1454A3" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                            </Viewbox>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Featured 2: HSK 4 -->
                                    <Button Style="{StaticResource FeaturedCourseCardStyle}"
                                            Command="{Binding OpenVocabStudyCommand}"
                                            CommandParameter="HSK 4">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="17"
                                                        BorderBrush="#E4CAFF"
                                                        BorderThickness="1"
                                                        views:DashboardView.RoundedClipRadius="17">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#F4E4FF" Offset="0" />
                                                            <GradientStop Color="#E2C9FF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                        <views:DashboardArtworkControl ArtworkKey="featured-hsk4" />
                                                        <StackPanel Margin="16,16,46,16" VerticalAlignment="Top">
                                                            <TextBlock Text="HSK 4" FontSize="20" FontWeight="ExtraBold" Foreground="#6426A8" />
                                                            <TextBlock Text="Trung cao cấp" FontSize="13" FontWeight="Bold" Foreground="#6426A8" Margin="0,2,0,6" />
                                                            <TextBlock Text="Nâng cao khả năng sử dụng" FontSize="10.5" Foreground="#6B548E" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Width="32" Height="32" CornerRadius="16" Background="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12">
                                                            <Viewbox Width="16" Height="16">
                                                                <Path Data="{StaticResource IconArrowRight}" Stroke="#6426A8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                            </Viewbox>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Featured 3: Xuất nhập khẩu (XNK) -->
                                    <Button Style="{StaticResource FeaturedCourseCardStyle}"
                                            Command="{Binding OpenVocabStudyCommand}"
                                            CommandParameter="Xuất nhập khẩu">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="17"
                                                        BorderBrush="#C9EFD8"
                                                        BorderThickness="1"
                                                        views:DashboardView.RoundedClipRadius="17">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#E5F9ED" Offset="0" />
                                                            <GradientStop Color="#C9F0D9" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                        <views:DashboardArtworkControl ArtworkKey="featured-xnk" />
                                                        <StackPanel Margin="16,16,46,16" VerticalAlignment="Top">
                                                            <TextBlock Text="Xuất nhập khẩu" FontSize="18" FontWeight="ExtraBold" Foreground="#16764D" />
                                                            <TextBlock Text="(XNK)" FontSize="13" FontWeight="Bold" Foreground="#16764D" Margin="0,2,0,6" />
                                                            <TextBlock Text="Logistics, hải quan &amp; thanh toán" FontSize="10.5" Foreground="#4A7A64" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Width="32" Height="32" CornerRadius="16" Background="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12">
                                                            <Viewbox Width="16" Height="16">
                                                                <Path Data="{StaticResource IconArrowRight}" Stroke="#16764D" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                            </Viewbox>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT SECONDARY COLUMN -->
                    <StackPanel x:Name="SecondaryColumnPanel" Grid.Column="2" Grid.Row="0">

                        <!-- S1. BẢNG XẾP HẠNG -->
                        <Border Style="{StaticResource WhitePanelStyle}" Padding="18,16,18,10" Margin="0,0,0,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconTrophy}"
                                                  Stroke="#F0A52B"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Viewbox>
                                        <TextBlock Text="Bảng xếp hạng" FontSize="16" FontWeight="Bold" Foreground="#203653" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ComboBox ItemsSource="{Binding LeaderboardPeriods}"
                                              SelectedItem="{Binding SelectedLeaderboardPeriod}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              FontSize="11"
                                              Padding="8,4"
                                              Background="#F8FAFD"
                                              BorderBrush="#E7EDF5"
                                              Foreground="#4E6380" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding LeaderboardEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F0F3F7" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Rank}"
                                                               FontSize="14"
                                                               FontWeight="ExtraBold"
                                                               Foreground="{Binding RankColor}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />

                                                    <views:DashboardArtworkControl Grid.Column="1"
                                                                                   ArtworkKey="{Binding AvatarKind}"
                                                                                   Width="28" Height="28"
                                                                                   HorizontalAlignment="Left"
                                                                                   VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#334967"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconFlame}"
                                                                  Fill="#FB923C"
                                                                  Stroke="#EA580C"
                                                                  StrokeThickness="1.5" />
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding StreakDays, StringFormat='{}{0} ngày'}"
                                                                   FontSize="11.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="#ED7C36"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- S2. PHẦN THƯỞNG -->
                        <Border CornerRadius="20"
                                BorderBrush="#FFE0D9"
                                BorderThickness="1"
                                MinHeight="168"
                                Margin="0,0,0,15"
                                Effect="{StaticResource PanelShadow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                    <GradientStop Color="#FFF1E9" Offset="0" />
                                    <GradientStop Color="#FFE3ED" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                        <Viewbox Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconGift}" Stroke="#D47A36" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Viewbox>
                                        <TextBlock Text="PHẦN THƯỞNG" FontSize="11" FontWeight="ExtraBold" Foreground="#D47A36" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="Hoàn thành mục tiêu hôm nay!"
                                               FontSize="14.5"
                                               FontWeight="Bold"
                                               Foreground="#5B3E43"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,5" />

                                    <TextBlock Text="Nhận ngay 50 điểm kinh nghiệm và mở khóa huy hiệu mới!"
                                               FontSize="11"
                                               Foreground="#987A7B"
                                               TextWrapping="Wrap"
                                               LineHeight="16"
                                               Margin="0,0,0,11" />

                                    <Button Command="{Binding OpenLearnedVocabCommand}"
                                            CommandParameter="HSK 1"
                                            HorizontalAlignment="Left"
                                            Cursor="Hand"
                                            BorderThickness="0"
                                            FocusVisualStyle="{StaticResource DashboardFocusVisual}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnReward" CornerRadius="18" Padding="15,8">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                                            <GradientStop Color="#FF8B91" Offset="0" />
                                                            <GradientStop Color="#ED5571" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Nhận thưởng" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                        <Viewbox Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconGift}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                        </Viewbox>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnReward" Property="Opacity" Value="0.92" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnReward" Property="Opacity" Value="0.82" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <views:DashboardArtworkControl Grid.Column="1"
                                                               ArtworkKey="reward-medal"
                                                               Width="96" Height="96"
                                                               VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- S3. MỤC TIÊU HÔM NAY -->
                        <Border Style="{StaticResource WhitePanelStyle}" Padding="18,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="19" Height="19" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconTarget}" Stroke="#318BE8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Viewbox>
                                        <TextBlock Text="Mục tiêu hôm nay" FontSize="15.5" FontWeight="Bold" Foreground="#203653" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DailyGoalPercent, StringFormat='{}{0}%'}"
                                               FontSize="14"
                                               FontWeight="ExtraBold"
                                               Foreground="#159C69"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{Binding DailyGoalStatusText}"
                                           FontSize="11.5"
                                           Foreground="#8392A8"
                                           Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="9" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#F6F9FC" CornerRadius="11" Padding="10,9">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DailyGoalVocabText}" FontSize="15" FontWeight="Bold" Foreground="#304866" HorizontalAlignment="Center" />
                                            <TextBlock Text="Từ vựng" FontSize="10.5" Foreground="#8998AD" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#F6F9FC" CornerRadius="11" Padding="10,9">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DailyGoalExerciseText}" FontSize="15" FontWeight="Bold" Foreground="#304866" HorizontalAlignment="Center" />
                                            <TextBlock Text="Bài tập" FontSize="10.5" Foreground="#8998AD" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ProgressBar Height="5"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding DailyGoalPercent, Mode=OneWay}"
                                             Background="#E4EBF4"
                                             Foreground="#22B77A"
                                             BorderThickness="0">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid>
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2.5" />
                                                <Border x:Name="PART_Track" CornerRadius="2.5" ClipToBounds="True">
                                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2.5" />
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- 4. FOOTER SLOGAN                                             -->
                <!-- ============================================================ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,4">
                    <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconSparkles}" Stroke="#E5AD62" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Viewbox>
                    <TextBlock Text="Học tiếng Trung – Mở rộng cơ hội, vươn tới tương lai"
                               FontSize="12.5"
