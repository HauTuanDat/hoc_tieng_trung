<UserControl x:Class="QuizApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20" MaxWidth="1100">

            <!-- ============================================== -->
            <!-- 1. WELCOME BANNER (Mộc Ngữ Traditional Theme)   -->
            <!-- ============================================== -->
            <Border CornerRadius="18"
                    Background="White"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    Padding="26,22"
                    Margin="0,0,0,20"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Xin chào, " FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding CurrentUser.FullName}" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="!" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Học tiếng Trung hôm nay, mở ra nhiều cơ hội ngày mai!"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="Medium"
                                   Margin="0,0,0,14" />

                        <!-- Quick Level Tag & Action -->
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource PrimaryTintBrush}" BorderBrush="{StaticResource PrimaryLightBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                                <TextBlock Text="Cấp độ hiện tại: HSK 3" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                            <Button Command="{Binding ContinueLearningCommand}" Style="{StaticResource PrimaryButton}" Padding="16,6" FontSize="12.5">
                                <TextBlock Text="Tiếp tục bài học ➜" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Mascot Panda on right -->
                    <Border Grid.Column="1" Width="80" Height="80" CornerRadius="40" Background="#FAF6F0" BorderBrush="{StaticResource PrimaryLightBorderBrush}" BorderThickness="2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="🐼" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 2. 5 LEARNING METRIC CARDS                     -->
            <!-- ============================================== -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <!-- 1. Từ vựng đã học -->
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,10,0" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📖 " FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Từ vựng đã học" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding MasteredVocabularies, StringFormat='{}{0:#,0}'}" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="/ 3.000 từ" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ProgressBar Value="0" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Height="5" />
                    </StackPanel>
                </Border>

                <!-- 2. Luyện nghe -->
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,10,0" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🎧 " FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Luyện nghe" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ListeningCount}" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="/ 50 bài" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ProgressBar Value="0" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Height="5" />
                    </StackPanel>
                </Border>

                <!-- 3. Luyện viết -->
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,10,0" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="✍ " FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Luyện viết" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding WritingCount}" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="/ 40 bài" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ProgressBar Value="0" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Height="5" />
                    </StackPanel>
                </Border>

                <!-- 4. Luyện đọc -->
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,10,0" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📖 " FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Luyện đọc" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ReadingCount}" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="/ 40 bài" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ProgressBar Value="0" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Height="5" />
                    </StackPanel>
                </Border>

                <!-- 5. Sắp xếp câu -->
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🧩 " FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Sắp xếp câu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SentenceCount}" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="/ 30 bài" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ProgressBar Value="0" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Height="5" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================================== -->
            <!-- 3. 3 MIDDLE PROGRESS CARDS                     -->
            <!-- ============================================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Mục tiêu hôm nay -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" CornerRadius="32" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="4" Background="{StaticResource PrimaryTintBrush}" Margin="0,0,14,0">
                            <TextBlock Text="0/5" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Mục tiêu hôm nay" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Chưa hoàn thành bài học nào hôm nay" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Chuỗi ngày học -->
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🔥 " FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Chuỗi ngày học" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentStreak, StringFormat='{}{0} ngày liên tiếp'}" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="T2  T3  T4  T5  T6  T7  CN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Tiến độ HSK -->
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Effect="{StaticResource CardShadow}">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Tiến độ HSK 1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="0%" FontSize="14" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Value="0" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Height="7" Margin="0,0,0,8" />
                        <TextBlock Text="Đã học 0 bài" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- 4. BOTTOM 2 CARDS: Continue & Recent Activity  -->
            <!-- ============================================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Tiếp tục học -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,16,0" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Tiếp tục học" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                        <Border Background="#FAF6F0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="46" Height="46" CornerRadius="10" Background="{StaticResource PrimaryTintBrush}" Margin="0,0,14,0">
                                    <TextBlock Text="🏯" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="HSK 3 - Bài 12: Gia đình" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="Từ vựng • 12 phút • Hoàn thành 60%" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Command="{Binding ContinueLearningCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="14,8"
                                        FontSize="12.5"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Tiếp tục ➜" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Hoạt động gần đây -->
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Hoạt động gần đây" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />

                        <!-- Activity 1 -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌱 " FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="Bạn đã học 10 từ vựng mới" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="2 giờ trước" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,10" />

                        <!-- Activity 2 -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎧 " FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="Hoàn thành bài luyện nghe HSK 2" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="5 giờ trước" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,10" />

                        <!-- Activity 3 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✍ " FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="Đạt 90% trong bài luyện viết" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="1 ngày trước" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
