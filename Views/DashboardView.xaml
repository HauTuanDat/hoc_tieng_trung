                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="HSK 2" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" />
                                    <TextBlock Text="0%" FontSize="12.5" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Height="5">
                                    <Border Background="#E8EFF8" CornerRadius="2.5" />
                                    <Border HorizontalAlignment="Left" Width="0" Background="#0284C7" CornerRadius="2.5" />
                                </Grid>
                            </StackPanel>

                            <!-- HSK 3 -->
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="HSK 3" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" />
                                    <TextBlock Text="0%" FontSize="12.5" FontWeight="SemiBold" Foreground="#7C3AED" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Height="5">
                                    <Border Background="#E8EFF8" CornerRadius="2.5" />
                                    <Border HorizontalAlignment="Left" Width="0" Background="#7C3AED" CornerRadius="2.5" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- S4. HOẠT ĐỘNG GẦN ĐÂY -->
                    <Border Style="{StaticResource SidebarCardStyle}">
                        <StackPanel>
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Data="{StaticResource LucideClock}"
                                      Stroke="#16A34A"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Hoạt động gần đây"
                                           FontSize="14.5" FontWeight="Bold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Activity 1 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="28" Height="28" CornerRadius="7"
                                        Background="#DCFCE7"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource LucideBookOpen}"
                                          Stroke="#16A34A"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="Học 10 từ vựng mới"
                                               FontSize="12.5" FontWeight="Medium"
                                               Foreground="#334155"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="2 giờ trước"
                                               FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                                <Path Grid.Column="2"
                                      Data="{StaticResource LucideZap}"
                                      Fill="#FBBF24"
                                      Stroke="#F59E0B"
                                      StrokeThickness="1"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                            </Grid>

                            <!-- Separator -->
                            <Border Height="1" Background="#F1F5F9" Margin="0,0,0,10" />

                            <!-- Activity 2 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="28" Height="28" CornerRadius="7"
                                        Background="#E0F2FE"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource LucideHeadphones}"
                                          Stroke="#0284C7"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="Luyện nghe HSK 2"
                                               FontSize="12.5" FontWeight="Medium"
                                               Foreground="#334155"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="5 giờ trước"
                                               FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                                <Path Grid.Column="2"
                                      Data="{StaticResource LucideZap}"
                                      Fill="#A5F3FC"
                                      Stroke="#06B6D4"
                                      StrokeThickness="1"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                            </Grid>

                            <!-- Separator -->
                            <Border Height="1" Background="#F1F5F9" Margin="0,0,0,10" />

                            <!-- Activity 3 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="28" Height="28" CornerRadius="7"
                                        Background="#EDE9FE"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource LucidePencil}"
                                          Stroke="#7C3AED"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="Đạt 90% luyện viết"
                                               FontSize="12.5" FontWeight="Medium"
                                               Foreground="#334155"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="1 ngày trước"
                                               FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                                <Path Grid.Column="2"
                                      Data="{StaticResource LucideZap}"
                                      Fill="#DDD6FE"
                                      Stroke="#8B5CF6"
                                      StrokeThickness="1"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
