<UserControl x:Class="QuizApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20" MaxWidth="1100">

            <!-- ============================================== -->
            <!-- 1. WELCOME BANNER (Page Title: 28px - Bold 700)-->
            <!-- ============================================== -->
            <Border CornerRadius="18"
                    Background="{DynamicResource HeroBannerBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="1"
                    Padding="28,24"
                    Margin="0,0,0,20"
                    ClipToBounds="True"
                    Effect="{DynamicResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Content: Greeting & Quick Action -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Greeting Page Title: 28px Bold -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Xin chào, " FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding CurrentUser.FullName, TargetNullValue='Minh Đạt'}" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource BannerNameBrush}" />
                            <TextBlock Text="!" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Subtitle: 15px - Medium 500 -->
                        <TextBlock Text="Học tiếng Trung hôm nay, mở ra nhiều cơ hội ngày mai!"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="Medium"
                                   Margin="0,0,0,16" />

                        <!-- Quick Level Tag & Action Button -->
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource PrimaryTintBrush}" BorderBrush="{DynamicResource PrimaryLightBorderBrush}" BorderThickness="1.2" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🪪 " FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="Cấp độ hiện tại: HSK 3" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button Command="{Binding ContinueLearningCommand}" Style="{DynamicResource PrimaryButton}" Padding="18,8" FontSize="14.5">
                                <TextBlock Text="Tiếp tục bài học ➔" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Mascot Panda on right (Clean White Circular Card) -->
                    <Border Grid.Column="1" Width="82" Height="82" CornerRadius="41" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource PrimaryLightBorderBrush}" BorderThickness="2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.12" />
                        </Border.Effect>
                        <TextBlock Text="🐼" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 2. 5 LEARNING METRIC CARDS (Stats: 26px - 700) -->
            <!-- ============================================== -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <!-- 1. Từ vựng đã học -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,10,0" Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📖 " FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Từ vựng đã học" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding MasteredVocabularies, StringFormat='{}{0:#,0}'}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="/ 3.000 từ" FontSize="13.5" FontWeight="Regular" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ProgressBar Value="0" Maximum="100" Style="{DynamicResource ModernProgressBarStyle}" Height="6" />
                    </StackPanel>
                </Border>

                <!-- 2. Luyện nghe -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,10,0" Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🎧 " FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Luyện nghe" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ListeningCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="/ 50 bài" FontSize="13.5" FontWeight="Regular" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ProgressBar Value="0" Maximum="100" Style="{DynamicResource ModernProgressBarStyle}" Height="6" />
                    </StackPanel>
                </Border>

                <!-- 3. Luyện viết -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,10,0" Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="✍ " FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Luyện viết" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding WritingCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="/ 40 bài" FontSize="13.5" FontWeight="Regular" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ProgressBar Value="0" Maximum="100" Style="{DynamicResource ModernProgressBarStyle}" Height="6" />
                    </StackPanel>
                </Border>

                <!-- 4. Luyện đọc -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,10,0" Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🔊 " FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Luyện đọc" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ReadingCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="/ 40 bài" FontSize="13.5" FontWeight="Regular" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ProgressBar Value="0" Maximum="100" Style="{DynamicResource ModernProgressBarStyle}" Height="6" />
                    </StackPanel>
                </Border>

                <!-- 5. Sắp xếp câu -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14" Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🗂 " FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Sắp xếp câu" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SentenceCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="/ 30 bài" FontSize="13.5" FontWeight="Regular" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                        <ProgressBar Value="0" Maximum="100" Style="{DynamicResource ModernProgressBarStyle}" Height="6" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================================== -->
            <!-- 3. 3 MIDDLE PROGRESS CARDS (Card Title: 16px)  -->
            <!-- ============================================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Mục tiêu hôm nay -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,12,0" Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Donut Progress Ring -->
                        <Grid Width="64" Height="64" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource ProgressBarTrackBrush}" StrokeThickness="5" Width="58" Height="58" />
                            <Ellipse Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="5" StrokeDashArray="0.01 100" Width="58" Height="58" />
                            <TextBlock Text="0%" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Mục tiêu hôm nay" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Chưa hoàn thành bài học nào hôm nay" FontSize="14" FontWeight="Regular" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Chuỗi ngày học -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,12,0" Effect="{DynamicResource CardShadow}">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🔥 " FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Chuỗi ngày học" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentStreak, StringFormat='{}{0} ngày liên tiếp'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource StreakGreenBrush}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="T2  T3  T4  T5  T6  T7  CN" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Tiến độ HSK -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Effect="{DynamicResource CardShadow}">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Tiến độ HSK 1" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="0%" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Value="0" Maximum="100" Style="{DynamicResource ModernProgressBarStyle}" Height="7" Margin="0,0,0,8" />
                        <TextBlock Text="Đã học 0 bài" FontSize="13.5" FontWeight="Regular" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- 4. BOTTOM 2 CARDS (Section Title: 19px - 700)  -->
            <!-- ============================================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Tiếp tục học -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="22,20" Margin="0,0,16,0" Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🎓 " FontSize="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Tiếp tục học" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Chinese Character Badge 汉 -->
                                <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource PrimaryTintBrush}" BorderBrush="{DynamicResource PrimaryLightBorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                                    <TextBlock Text="汉" FontFamily="{StaticResource ChineseFontFamily}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="HSK 3 - Bài 12: Gia đình" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                    <TextBlock Text="Từ vựng • 12 phút • Hoàn thành 60%" FontSize="13.5" FontWeight="Regular" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Command="{Binding ContinueLearningCommand}"
                                        Style="{DynamicResource PrimaryButton}"
                                        Padding="16,8"
                                        FontSize="14"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Tiếp tục ➔" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Hoạt động gần đây -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="22,20" Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="📊 " FontSize="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Hoạt động gần đây" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Activity 1 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="🏆 " FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Bạn đã học 10 từ vựng mới" FontSize="14.5" FontWeight="Regular" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="2 giờ trước" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10" />

                        <!-- Activity 2 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="🎧 " FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Hoàn thành bài luyện nghe HSK 2" FontSize="14.5" FontWeight="Regular" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="5 giờ trước" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10" />

                        <!-- Activity 3 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="✍ " FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Đạt 90% trong bài luyện viết" FontSize="14.5" FontWeight="Regular" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="1 ngày trước" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
