<UserControl x:Class="QuizApp.Views.TypingPracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:TypingPracticeViewModel}"
             d:DesignHeight="950" d:DesignWidth="1050">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,20,24,40">
            <Border Width="860" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="22" Padding="36,30" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <!-- Top Bar: Header & Exit -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Phòng Luyện Viết &amp; Gõ HSK" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LevelName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="✕ Thoát bài học" Command="{Binding BackCommand}" Style="{StaticResource OutlineButton}" />
                        </StackPanel>
                    </Grid>

                    <!-- Control Panel 1: Level Selector Tabs -->
                    <Border Margin="0,18,0,0" Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Cấp độ HSK:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- HSK 1 -->
                                <Button Content="HSK 1" Command="{Binding FilterLevelCommand}" CommandParameter="HSK 1" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="14,6" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLevel}" Value="HSK 1">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Effect" Value="{StaticResource ButtonGlowShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- HSK 2 -->
                                <Button Content="HSK 2" Command="{Binding FilterLevelCommand}" CommandParameter="HSK 2" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="14,6" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLevel}" Value="HSK 2">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Effect" Value="{StaticResource ButtonGlowShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- HSK 3 -->
                                <Button Content="HSK 3" Command="{Binding FilterLevelCommand}" CommandParameter="HSK 3" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="14,6" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLevel}" Value="HSK 3">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Effect" Value="{StaticResource ButtonGlowShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- HSK 4 -->
                                <Button Content="HSK 4" Command="{Binding FilterLevelCommand}" CommandParameter="HSK 4" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="14,6" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLevel}" Value="HSK 4">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Effect" Value="{StaticResource ButtonGlowShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- HSK 5 -->
                                <Button Content="HSK 5" Command="{Binding FilterLevelCommand}" CommandParameter="HSK 5" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="14,6" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLevel}" Value="HSK 5">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Effect" Value="{StaticResource ButtonGlowShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- HSK 6 -->
                                <Button Content="HSK 6" Command="{Binding FilterLevelCommand}" CommandParameter="HSK 6" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="14,6" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLevel}" Value="HSK 6">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Effect" Value="{StaticResource ButtonGlowShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Kế toán -->
                                <Button Content="🧮 Kế toán" Command="{Binding FilterLevelCommand}" CommandParameter="Kế toán" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="14,6" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLevel}" Value="Kế toán">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Effect" Value="{StaticResource ButtonGlowShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Xuất nhập khẩu -->
                                <Button Content="🚢 Xuất nhập khẩu" Command="{Binding FilterLevelCommand}" CommandParameter="Xuất nhập khẩu" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="14,6" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLevel}" Value="Xuất nhập khẩu">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Effect" Value="{StaticResource ButtonGlowShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Công xưởng -->
                                <Button Content="🏭 Công xưởng" Command="{Binding FilterLevelCommand}" CommandParameter="Công xưởng" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="14,6" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLevel}" Value="Công xưởng">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Effect" Value="{StaticResource ButtonGlowShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- ALL -->
                                <Button Content="Toàn bộ" Command="{Binding FilterLevelCommand}" CommandParameter="ALL">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="14,6" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLevel}" Value="ALL">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Effect" Value="{StaticResource ButtonGlowShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Control Panel 2: Word Count Limit & Filter Mode -->
                    <Border Margin="0,10,0,0" Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Filter Mode -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Bộ lọc:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <Button Content="Tất cả từ" Command="{Binding FilterModeCommand}" CommandParameter="ALL" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="12,5" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFilterMode}" Value="ALL">
                                                    <Setter Property="Background" Value="#4F46E5" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="#4F46E5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Chỉ từ chưa viết" Command="{Binding FilterModeCommand}" CommandParameter="Unmastered" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="12,5" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFilterMode}" Value="Unmastered">
                                                    <Setter Property="Background" Value="#059669" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="#059669" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Từ đã thuộc" Command="{Binding FilterModeCommand}" CommandParameter="Mastered">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="12,5" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFilterMode}" Value="Mastered">
                                                    <Setter Property="Background" Value="#D97706" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="#D97706" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- Right: Word Count Limit Selection -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Số lượng từ:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <Button Content="50 từ" Command="{Binding SelectLimitCommand}" CommandParameter="50" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="10,5" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLimit}" Value="50">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="100 từ" Command="{Binding SelectLimitCommand}" CommandParameter="100" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="10,5" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLimit}" Value="100">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="200 từ" Command="{Binding SelectLimitCommand}" CommandParameter="200" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="10,5" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLimit}" Value="200">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="500 từ" Command="{Binding SelectLimitCommand}" CommandParameter="500" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="10,5" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLimit}" Value="500">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Toàn bộ (Tất cả từ)" Command="{Binding SelectLimitCommand}" CommandParameter="5000">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                            <Setter Property="Padding" Value="10,5" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLimit}" Value="5000">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Auto-Save & Resume Progress Banner -->
                    <Border Margin="0,14,0,0"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16,10"
                            Visibility="{Binding IsResumedSession, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ResumeNotice}" FontSize="13" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="🔄 Bắt đầu lại từ từ 1"
                                    Command="{Binding RestartFromBeginningCommand}"
                                    Style="{StaticResource OutlineButton}"
                                    Padding="12,5"
                                    FontSize="12"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Progress Bar & Navigation Controls Bar -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Progress Text & AutoPlay Audio Toggle -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProgressText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <CheckBox Content="🔊 Tự đọc từ mới" IsChecked="{Binding IsAutoPlayAudio, Mode=TwoWay}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" ToolTip="Tự động phát âm giọng Xiaoxiao khi chuyển sang từ mới" />
                        </StackPanel>

                        <!-- Center: Quick Word Jump -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Đến từ số:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="JumpInputBox"
                                     Text="{Binding JumpTargetIndexText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="65"
                                     FontSize="13"
                                     Padding="6,4"
                                     TextAlignment="Center"
                                     Style="{StaticResource ModernTextBox}"
                                     KeyDown="JumpBox_KeyDown" />
                            <Button Content="Đi ➔" Command="{Binding JumpToWordCommand}" Style="{StaticResource OutlineButton}" Padding="10,4" Margin="6,0,0,0" FontSize="12" />
                        </StackPanel>

                        <!-- Right: Previous / Next Word Navigation -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀ Từ trước" Command="{Binding PreviousWordCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" Margin="0,0,8,0" FontSize="12" />
                            <Button Content="Từ sau ▶" Command="{Binding NextWordCommand}" Style="{StaticResource OutlineButton}" Padding="12,5" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Margin="0,10,0,0" Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Height="7" />

                    <!-- Prompt Card (The Word to Practice) -->
                    <Border Margin="0,18,0,0" Background="{StaticResource SubCardBackgroundBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1.5" CornerRadius="18" Padding="28,22">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Mastery & Save Badge -->
                            <Border HorizontalAlignment="Center" Margin="0,0,0,10" CornerRadius="8" Padding="12,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F1F5F9" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentVocabMastered}" Value="True">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding VocabMasteryStatusText}" FontSize="12" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentVocabMastered}" Value="True">
                                                    <Setter Property="Foreground" Value="#059669" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Target Word (Hanzi) with Pronunciation Button -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CurrentVocab.Word}" FontSize="48" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Content="🔊"
                                        Command="{Binding PlayWordAudioCommand}"
                                        Style="{StaticResource OutlineButton}"
                                        Padding="12,6"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        ToolTip="Phát âm chuẩn (zh-CN-XiaoxiaoNeural)" />
                            </StackPanel>

                            <!-- Pinyin with tones -->
                            <TextBlock Text="{Binding CurrentVocab.Pinyin}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />

                            <!-- Vietnamese Meaning -->
                            <TextBlock Text="{Binding CurrentVocab.Meaning}" FontSize="16" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />

                            <!-- Pronunciation Helper Action Button -->
                            <Button Content="🔊 Nghe phát âm chuẩn (Xiaoxiao)"
                                    Command="{Binding PlayWordAudioCommand}"
                                    Style="{StaticResource OutlineButton}"
                                    Padding="14,6"
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    BorderBrush="{StaticResource PrimaryBrush}"
                                    ToolTip="Nghe giọng AI Xiaoxiao đọc chuẩn bản xứ" />

                            <!-- Example Box -->
                            <Border Margin="0,14,0,0" Background="White" CornerRadius="12" Padding="18,12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" MaxWidth="680" HorizontalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentVocab.ExampleHanzi}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CurrentVocab.ExamplePinyin}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CurrentVocab.ExampleMeaning}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0" FontStyle="Italic" TextWrapping="Wrap" />
                                    <Button Content="🔊 Nghe đọc câu ví dụ"
                                            Command="{Binding PlaySentenceAudioCommand}"
                                            Style="{StaticResource OutlineButton}"
                                            Padding="10,4"
                                            FontSize="11"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center"
                                            ToolTip="Nghe toàn bộ câu ví dụ với giọng Xiaoxiao" />
                                </StackPanel>
                            </Border>

                            <!-- History record (if user wrote this word previously) -->
                            <Border Margin="0,10,0,0" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Center"
                                    Visibility="{Binding LastSavedRecordInfo, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding LastSavedRecordInfo}" FontSize="12" FontWeight="SemiBold" Foreground="#92400E" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Input 1: Write New Word -->
                    <Grid Margin="0,20,0,8">
                        <TextBlock Text="1. Luyện viết từ mới (Nhập Chữ Hán hoặc Pinyin):" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="* Bắt buộc" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Border CornerRadius="8" BorderThickness="1.5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox x:Name="WordInputBox"
                                 Text="{Binding InputWord, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 FontSize="17"
                                 Padding="14,12"
                                 BorderThickness="0"
                                 KeyDown="InputBox_KeyDown" />
                    </Border>

                    <!-- Input 2: Write Example Sentence -->
                    <Grid Margin="0,16,0,8">
                        <TextBlock Text="2. Luyện viết cả câu ví dụ (Không bắt buộc):" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBox Text="{Binding InputSentence, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             FontSize="15"
                             Padding="14,12"
                             KeyDown="InputBox_KeyDown" />

                    <!-- ERROR ALERT BANNER -->
                    <Border Margin="0,16,0,0"
                            Background="{StaticResource ErrorBgBrush}"
                            BorderBrush="{StaticResource ErrorBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="14"
                            Padding="20,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="❌" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Chưa chính xác! Bạn đã viết sai từ này." FontSize="15" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" />
                                <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="#991B1B" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="✍ Viết lại ngay"
                                    Command="{Binding RetryCommand}"
                                    Style="{StaticResource OutlineButton}"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    Foreground="{StaticResource ErrorBrush}"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- SUCCESS ALERT BANNER (Shown when written correctly & saved to DB) -->
                    <Border Margin="0,16,0,0"
                            Background="{StaticResource SuccessBgBrush}"
                            BorderBrush="{StaticResource SuccessBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="14"
                            Padding="20,16"
                            Visibility="{Binding IsCorrect, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🎉" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Chính xác tuyệt vời! Đã lưu kết quả thành công." FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="{Binding SuccessMessage}" FontSize="13" Foreground="#065F46" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Controls Bar -->
                    <Grid Margin="0,22,0,0">
                        <!-- Left helper buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="💡 Xem gợi ý" Command="{Binding FillHintCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,10,0" />
                            <Button Content="Bỏ qua từ này" Command="{Binding SkipWordCommand}" Style="{StaticResource OutlineButton}" />
                        </StackPanel>

                        <!-- Right primary action button: Check or Next -->
                        <Button HorizontalAlignment="Right"
                                Command="{Binding CheckOrNextCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Content="{Binding ActionButtonText}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
