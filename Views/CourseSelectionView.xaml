<UserControl x:Class="QuizApp.Views.CourseSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             xmlns:views="clr-namespace:QuizApp.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CourseSelectionViewModel}"
             Background="#F7F9FC">

    <UserControl.Resources>
        <!-- Soft card elevation matching design -->
        <DropShadowEffect x:Key="CourseCardShadow"
                          BlurRadius="20"
                          ShadowDepth="5"
                          Direction="270"
                          Color="#1C3454"
                          Opacity="0.09" />

        <DropShadowEffect x:Key="CourseCardHoverShadow"
                          BlurRadius="28"
                          ShadowDepth="9"
                          Direction="270"
                          Color="#1C3454"
                          Opacity="0.14" />

        <!-- Lucide BookOpen Geometry -->
        <Geometry x:Key="IconBookOpen">M 2,3 H 8 A 4,4 0 0 1 12,7 V 21 A 3,3 0 0 0 9,18 H 2 Z M 22,3 H 16 A 4,4 0 0 0 12,7 V 21 A 3,3 0 0 1 15,18 H 22 Z</Geometry>

        <!-- Lucide BarChart3 Geometry -->
        <Geometry x:Key="IconBarChart3">M 3,3 V 21 H 21 M 18,17 V 9 M 13,17 V 5 M 8,17 V 14</Geometry>

        <!-- Lucide ArrowRight Geometry -->
        <Geometry x:Key="IconArrowRight">M 5,12 H 19 M 12,5 L 19,12 L 12,19</Geometry>

        <!-- Lucide Trophy Geometry -->
        <Geometry x:Key="IconTrophy">M 6,9 H 4.5 A 2.5,2.5 0 0 1 4.5,4 H 6 M 18,9 H 19.5 A 2.5,2.5 0 0 0 19.5,4 H 18 M 4,22 H 20 M 10,14.66 V 17 C 10,17.55 9.53,17.98 9.03,18.21 C 7.85,18.75 7,20.24 7,22 M 14,14.66 V 17 C 14,17.55 14.47,17.98 14.97,18.21 C 16.15,18.75 17,20.24 17,22 M 18,2 H 6 V 9 A 6,6 0 0 0 18,9 Z</Geometry>

        <!-- Clean FocusVisualStyle for keyboard accessibility -->
        <Style x:Key="CourseFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#2864E8"
                                BorderThickness="2"
                                CornerRadius="16"
                                Margin="-3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card container with smooth hover lift (200ms enter / 140ms exit) -->
        <Style x:Key="CourseCardWrapperStyle" TargetType="Grid">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-4" Duration="0:0:0.20">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card shadow shell with subtle hover border & shadow lift -->
        <Style x:Key="CourseCardShellStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E0E8F2" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Effect" Value="{StaticResource CourseCardShadow}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                    <Setter Property="BorderBrush" Value="#C7D6EA" />
                    <Setter Property="Effect" Value="{StaticResource CourseCardHoverShadow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Gradient CTA Button ("Vào học ngay ->") -->
        <Style x:Key="LearnCtaButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CourseFocusVisual}" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBg"
                                CornerRadius="14"
                                Background="{Binding ButtonBrush}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Vào học ngay"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center" />
                                <Viewbox Width="18" Height="18" Margin="8,1,0,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconArrowRight}"
                                          Stroke="White"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBg" Property="Background" Value="{Binding ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBg" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="1.5" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Circular Arrow Quick Button on Specialty Card Header -->
        <Style x:Key="CircleArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CourseFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circleBg"
                                CornerRadius="21"
                                Background="{Binding SoftBrush}"
                                BorderBrush="{Binding IconBorderBrush}"
                                BorderThickness="1">
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconArrowRight}"
                                      Stroke="{Binding AccentBrush}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circleBg" Property="Background" Value="{Binding IconBgBrush}" />
                                <Setter TargetName="circleBg" Property="BorderBrush" Value="{Binding AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circleBg" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="circleBg" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin Course Progress Bar -->
        <Style x:Key="CourseProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#EDF1F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Track" CornerRadius="3" ClipToBounds="True">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="{Binding PagePadding, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel MaxWidth="1240"
                        HorizontalAlignment="Stretch">

            <!-- ========================================================== -->
            <!-- 1. LỘ TRÌNH CHUẨN HSK (6 CARDS, 6 DISTINCT COLORS)         -->
            <!-- ========================================================== -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18" VerticalAlignment="Center">
                <Border Width="5" Height="25" Background="#2864E8" CornerRadius="2.5" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="Lộ trình Chuẩn HSK"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#10213E"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding HskCourses}" Margin="-11,0,-11,22">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="11" Style="{StaticResource CourseCardWrapperStyle}">
                            <!-- Outer Shadow Shell (kept unclipped so shadow renders cleanly) -->
                            <Border Style="{StaticResource CourseCardShellStyle}" />

                            <!-- Inner Clipped Card Surface -->
                            <Border CornerRadius="22"
                                    MinHeight="274"
                                    views:CourseSelectionView.RoundedClipRadius="22"
                                    Background="Transparent">
                                <Grid>
                                    <!-- Scenic Background Artwork (bottom-right) -->
                                    <views:CourseIllustrationControl IllustrationKey="{Binding IllustrationKey}"
                                                                     Margin="0,30,0,42"
                                                                     Opacity="0.92" />

                                    <!-- Card Foreground Content -->
                                    <Grid Margin="24,22,24,22">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Badge + Title + Level | Icon Box -->
                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <Border Background="{Binding SoftBrush}"
                                                        CornerRadius="12"
                                                        Padding="12,4"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding LevelKey}"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding AccentBrush}" />
                                                </Border>

                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="26"
                                                           FontWeight="Bold"
                                                           Foreground="#10213E"
                                                           Margin="0,0,0,2" />

                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="15"
                                                           FontWeight="Normal"
                                                           Foreground="#70809E" />
                                            </StackPanel>

                                            <!-- Top-Right Rounded Square Lucide Icon Box -->
                                            <Border Grid.Column="1"
                                                    Width="56"
                                                    Height="56"
                                                    CornerRadius="17"
                                                    Background="{Binding IconBgBrush}"
                                                    BorderBrush="{Binding IconBorderBrush}"
                                                    BorderThickness="1.2"
                                                    VerticalAlignment="Top"
                                                    Margin="10,0,0,0">
                                                <Viewbox Width="25" Height="25" Stretch="Uniform">
                                                    <Path Data="{Binding IconPathData}"
                                                          Stroke="{Binding AccentBrush}"
                                                          StrokeThickness="1.9"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Border>
                                        </Grid>

                                        <!-- Middle: Lesson Count & Progress -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                                <Viewbox Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconBookOpen}"
                                                          Stroke="#637795"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Viewbox>
                                                <TextBlock Text="{Binding LessonCountText}"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="#637795"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Viewbox Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconBarChart3}"
                                                              Stroke="#637795"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round" />
                                                    </Viewbox>
                                                    <TextBlock Text="TIẾN ĐỘ HỌC"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#637795"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProgressPercent, StringFormat='{}{0}%'}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#10213E"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <ProgressBar Style="{StaticResource CourseProgressBarStyle}"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         Foreground="{Binding ButtonBrush}" />
                                        </StackPanel>

                                        <!-- Bottom: Full-width Gradient CTA Button -->
                                        <Button Grid.Row="2"
                                                Style="{StaticResource LearnCtaButtonStyle}"
                                                Command="{Binding DataContext.SelectCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding LevelKey}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ========================================================== -->
            <!-- 2. KHÓA HỌC CHUYÊN NGÀNH THỰC CHIẾN (3 LARGE CARDS)        -->
            <!-- ========================================================== -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,18" VerticalAlignment="Center">
                <Border Width="5" Height="25" Background="#2864E8" CornerRadius="2.5" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="Khóa học Chuyên ngành Thực chiến"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#10213E"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding SpecializedCourses}" Margin="-11,0,-11,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="11" Style="{StaticResource CourseCardWrapperStyle}">
                            <!-- Outer Shadow Shell -->
                            <Border Style="{StaticResource CourseCardShellStyle}" />

                            <!-- Inner Card Content -->
                            <Border CornerRadius="22"
                                    MinHeight="306"
                                    Padding="22"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header: Icon Box + Title/Subtitle + Circular Arrow Button -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="62"
                                                Height="62"
                                                CornerRadius="18"
                                                Background="{Binding SoftBrush}"
                                                BorderBrush="{Binding IconBorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center">
                                            <Viewbox Width="28" Height="28" Stretch="Uniform">
                                                <Path Data="{Binding IconPathData}"
                                                      Stroke="{Binding AccentBrush}"
                                                      StrokeThickness="1.85"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#10213E"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="13.5"
                                                       Foreground="#71809B"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource CircleArrowButtonStyle}"
                                                Command="{Binding DataContext.SelectCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding LevelKey}"
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0"
                                                ToolTip="Mở khóa học" />
                                    </Grid>

                                    <!-- Center Vector Illustration Stage -->
                                    <Border Grid.Row="1"
                                            CornerRadius="18"
                                            Margin="0,6,0,14"
                                            MinHeight="120"
                                            views:CourseSelectionView.RoundedClipRadius="18"
                                            Background="{Binding IllustrationGlowBrush}">
                                        <views:CourseIllustrationControl IllustrationKey="{Binding IllustrationKey}"
                                                                         Height="122"
                                                                         VerticalAlignment="Bottom" />
                                    </Border>

                                    <!-- Bottom: Full-width Gradient CTA Button -->
                                    <Button Grid.Row="2"
                                            Style="{StaticResource LearnCtaButtonStyle}"
                                            Command="{Binding DataContext.SelectCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding LevelKey}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ========================================================== -->
            <!-- 3. FOOTER MOTIVATIONAL SLOGAN                              -->
            <!-- ========================================================== -->
            <Grid Margin="0,24,0,8" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="55" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="1" Background="#D9E2EE" VerticalAlignment="Center" Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTrophy}"
                              Stroke="#7183A5"
                              StrokeThickness="1.9"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                    <TextBlock Text="Học tiếng Trung – Mở rộng cơ hội, vươn tới tương lai"
                               FontSize="14.5"
                               FontStyle="Italic"
                               Foreground="#7183A5"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Height="1" Background="#D9E2EE" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
