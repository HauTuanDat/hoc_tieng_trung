<UserControl x:Class="QuizApp.Views.CourseSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CourseSelectionViewModel}"
             Background="#F8FAFC">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20,32,32" MaxWidth="1180">

            <!-- ============================================== -->
            <!-- 1. TOP HEADER BANNER (VIBRANT BLUE-PURPLE)     -->
            <!-- ============================================== -->
            <Border CornerRadius="20"
                    Margin="0,0,0,24"
                    ClipToBounds="True"
                    Padding="28,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1D4ED8" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="0.28" />
                        <GradientStop Color="#4F46E5" Offset="0.6" />
                        <GradientStop Color="#7C3AED" Offset="0.88" />
                        <GradientStop Color="#8B5CF6" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Graduation Icon + Title + Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="48" Height="48" CornerRadius="24"
                                    Background="#3B82F6"
                                    BorderBrush="#93C5FD"
                                    BorderThickness="2"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="🎓" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Chọn khóa học" FontSize="26" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Hành trình chinh phục tiếng Trung của bạn bắt đầu từ đây! Lộ trình chuẩn&#x0a;hóa theo từng cấp bậc với thiết kế trực quan và sinh động."
                                   FontSize="13.5"
                                   Foreground="#E0E7FF"
                                   LineHeight="20"
                                   FontWeight="Medium" />
                    </StackPanel>

                    <!-- Right: Paper Airplane & Oriental Pagoda Silhouette -->
                    <Grid Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16,0,0,-18">
                        <!-- Paper Airplane -->
                        <Viewbox Width="32" Height="32" Margin="0,-48,82,0" VerticalAlignment="Top">
                            <Path Data="M 2,12 L 22,2 L 14,22 L 11,15 Z M 22,2 L 11,15"
                                  Fill="#EDE9FE"
                                  Opacity="0.85" />
                        </Viewbox>

                        <!-- Pagoda & Trees Silhouette -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Viewbox Width="80" Height="90">
                                <Path Fill="#1E1B4B"
                                      Opacity="0.95"
                                      Data="M 38,2 L 38,8 M 32,8 C 35,9.5 38,10 40,10 C 42,10 45,9.5 48,8 L 45,14 H 35 Z M 27,15 C 33,17.5 40,18 40,18 C 40,18 47,17.5 53,15 L 48,24 H 32 Z M 34,24 V 30 H 46 V 24 M 20,30 C 30,33 40,34 40,34 C 40,34 50,33 60,30 L 54,44 H 26 Z M 28,44 V 52 H 52 V 44 M 10,52 C 25,56 40,57 40,57 C 40,57 55,56 70,52 L 63,72 H 17 Z M 20,72 V 82 H 60 V 72 M 12,82 H 68 V 85 H 12 Z" />
                            </Viewbox>
                            <!-- Shrub/Flower next to pagoda -->
                            <Viewbox Width="32" Height="40" Margin="-8,0,0,0" VerticalAlignment="Bottom">
                                <Path Fill="#312E81"
                                      Opacity="0.9"
                                      Data="M 12,30 C 8,24 10,16 16,14 C 18,10 24,10 27,14 C 33,13 36,20 33,26 C 36,29 32,35 26,34 C 22,36 15,35 12,30 Z" />
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 2. HSK 1 ~ 6 COURSES GRID SECTION              -->
            <!-- ============================================== -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                <Border Width="4.5" Height="22" Background="#2563EB" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Lộ trình Chuẩn HSK 1 ~ 6" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding HskCourses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1.2"
                                CornerRadius="18"
                                Padding="22,18"
                                Margin="0,0,18,18"
                                Effect="{DynamicResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top: Left (Badge, Title, Subtitle) & Right (Icon Outline Box) -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Details -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <!-- Pill Badge (HSK 1, HSK 2, etc.) -->
                                        <Border Background="{Binding BadgeBg}"
                                                CornerRadius="10"
                                                Padding="10,3"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,8">
                                            <TextBlock Text="{Binding LevelKey}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding BadgeFg}" />
                                        </Border>

                                        <!-- Title (HSK 1) -->
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A"
                                                   Margin="0,0,0,2" />

                                        <!-- Subtitle (Cơ bản) -->
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="13.5"
                                                   FontWeight="Normal"
                                                   Foreground="#64748B" />
                                    </StackPanel>

                                    <!-- Right Architectural Icon Container -->
                                    <Border Grid.Column="1"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="14"
                                            Background="{Binding IconBg}"
                                            BorderBrush="{Binding IconBorder}"
                                            BorderThickness="1.2"
                                            VerticalAlignment="Top"
                                            Margin="8,0,0,0">
                                        <Viewbox Width="24" Height="24" Stretch="Uniform">
                                            <Path Data="{Binding IconPathData}"
                                                  Stroke="{Binding IconColor}"
                                                  StrokeThickness="2.2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Viewbox>
                                    </Border>
                                </Grid>

                                <!-- Middle 1: Lesson Count -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="📖 " FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LessonCountText}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="#64748B"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Middle 2: Progress -->
                                <Grid Grid.Row="2" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ılı " FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,2,0" />
                                        <TextBlock Text="TIẾN ĐỘ HỌC"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#64748B"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ProgressPercent, StringFormat='{}{0}%'}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Bottom: Colored Rounded Button -->
                                <Button Grid.Row="3"
                                        Command="{Binding DataContext.SelectCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding LevelKey}"
                                        Height="40"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    CornerRadius="12"
                                                    Background="{Binding ButtonBrush}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Vào học ngay"
                                                               FontSize="13.5"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text=" →"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.88" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.75" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============================================== -->
            <!-- 3. SPECIALIZED INDUSTRY COURSES SECTION        -->
            <!-- ============================================== -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,16" VerticalAlignment="Center">
                <Border Width="4.5" Height="22" Background="#2563EB" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Khóa học Chuyên ngành Thực chiến" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding SpecializedCourses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding LevelKey}"
                                Cursor="Hand"
                                Margin="0,0,18,14"
                                BorderThickness="0"
                                Padding="0"
                                Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="specCard"
                                            Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1.2"
                                            CornerRadius="20"
                                            Padding="18,14"
                                            Effect="{DynamicResource CardShadow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Rounded Square Icon Badge -->
                                            <Border Grid.Column="0"
                                                    Width="46"
                                                    Height="46"
                                                    CornerRadius="14"
                                                    Background="{Binding BgTint}"
                                                    Margin="0,0,14,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}"
                                                           FontSize="22"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Center Title & Subtitle -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="12.5"
                                                           Foreground="#64748B"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Right Circular Arrow Button -->
                                            <Border Grid.Column="2"
                                                    Width="36"
                                                    Height="36"
                                                    CornerRadius="18"
                                                    Background="{Binding BadgeBg}"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="→"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding BadgeFg}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="specCard" Property="BorderBrush" Value="{Binding AccentColor}" />
                                            <Setter TargetName="specCard" Property="Effect" Value="{StaticResource CardHoverShadow}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="specCard" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============================================== -->
            <!-- 4. FOOTER MOTIVATIONAL SLOGAN                  -->
            <!-- ============================================== -->
            <Grid Margin="0,18,0,8" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="1" Background="#E2E8F0" VerticalAlignment="Center" Margin="0,0,14,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏆 " FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="Học tiếng Trung – Mở rộng cơ hội, vươn tới tương lai"
                               FontSize="13.5"
                               FontStyle="Italic"
                               Foreground="#64748B"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Height="1" Background="#E2E8F0" VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>