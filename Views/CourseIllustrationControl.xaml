                <Path Fill="#D9C3FA" Opacity="0.72" Data="M 88,194 Q 175,138 265,164 Q 318,140 360,156 L 360,210 L 88,210 Z" />

                <!-- Pagoda -->
                <Path Fill="#8D55E8" Opacity="0.5"
                      Data="M 255,76 L 258,84 H 252 Z
                            M 241,88 Q 255,93 269,88 L 263,98 H 247 Z
                            M 248,98 H 262 V 107 H 248 Z
                            M 234,107 Q 255,114 276,107 L 268,119 H 242 Z
                            M 244,119 H 266 V 131 H 244 Z
                            M 227,131 Q 255,140 283,131 L 274,146 H 236 Z
                            M 239,146 H 271 V 168 H 239 Z" />

                <!-- Cherry blossom branch -->
                <Path Stroke="#7A42D4" StrokeThickness="3" StrokeStartLineCap="Round" Opacity="0.52"
                      Data="M 358,64 Q 318,74 282,66 Q 258,60 242,50 M 318,72 Q 302,88 286,95" />
                <!-- Blossoms -->
