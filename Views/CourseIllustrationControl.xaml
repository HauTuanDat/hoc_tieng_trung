                <Ellipse Canvas.Left="296" Canvas.Top="64" Width="16" Height="16" Fill="#EE92DC" Opacity="0.82" />
                <Ellipse Canvas.Left="326" Canvas.Top="52" Width="15" Height="15" Fill="#F5A6E6" Opacity="0.85" />
                <Ellipse Canvas.Left="248" Canvas.Top="44" Width="12" Height="12" Fill="#F8BEEF" Opacity="0.85" />
                <Ellipse Canvas.Left="284" Canvas.Top="86" Width="12" Height="12" Fill="#EE92DC" Opacity="0.8" />
                <Ellipse Canvas.Left="340" Canvas.Top="72" Width="13" Height="13" Fill="#F8BEEF" Opacity="0.8" />
                <Ellipse Canvas.Left="310" Canvas.Top="110" Width="7" Height="7" Fill="#F5A6E6" Opacity="0.7" />
                <Ellipse Canvas.Left="222" Canvas.Top="74" Width="6" Height="6" Fill="#F5A6E6" Opacity="0.6" />
            </Canvas>
        </Viewbox>

        <!-- ========================================================== -->
        <!-- HSK 5: Aqua-Teal Layered Misty Peaks                       -->
        <!-- ========================================================== -->
        <Viewbox x:Name="Hsk5Art" Visibility="Collapsed" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Canvas Width="360" Height="210">
                <Canvas.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0.4" EndPoint="0.85,0.65">
                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                        <GradientStop Color="#AAFFFFFF" Offset="0.45" />
                        <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Canvas.OpacityMask>

                <Path Fill="#D1F4F2" Data="M 0,175 L 75,126 L 138,156 L 218,86 L 288,136 L 342,98 L 360,115 L 360,210 L 0,210 Z" />
                <Path Fill="#9CE6DF" Opacity="0.75" Data="M 85,198 L 165,122 L 222,155 L 295,88 L 360,136 L 360,210 L 85,210 Z" />
                <Path Fill="#56C9C1" Opacity="0.45" Data="M 155,210 Q 228,150 296,174 Q 330,156 360,168 L 360,210 Z" />
                <Path Fill="#FFFFFF" Opacity="0.6" Data="M 178,138 Q 222,124 270,138 Q 295,132 318,142 Q 252,152 178,138 Z" />
            </Canvas>
        </Viewbox>

        <!-- ========================================================== -->
        <!-- HSK 6: Rose-Coral Great Wall Fortress & Peaks              -->
        <!-- ========================================================== -->
        <Viewbox x:Name="Hsk6Art" Visibility="Collapsed" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Canvas Width="360" Height="210">
                <Canvas.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0.4" EndPoint="0.85,0.65">
                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                        <GradientStop Color="#AAFFFFFF" Offset="0.45" />
                        <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Canvas.OpacityMask>

                <Path Fill="#FFE0E7" Data="M 0,175 Q 90,124 176,154 Q 260,108 360,136 L 360,210 L 0,210 Z" />
                <Path Fill="#FBC3CF" Opacity="0.72" Data="M 92,196 Q 180,136 272,162 Q 320,138 360,150 L 360,210 L 92,210 Z" />

                <!-- Great wall ridge -->
                <Path Fill="#E85A78" Opacity="0.46"
                      Data="M 158,185 L 214,146 L 266,118 L 292,126 L 292,144 L 228,176 L 172,202 Z" />
                <!-- Fortress towers -->
                <Path Fill="#DB3F61" Opacity="0.56"
                      Data="M 262,84 H 296 V 128 H 262 Z
                            M 260,78 H 268 V 84 H 260 Z
                            M 272,78 H 280 V 84 H 272 Z
                            M 284,78 H 292 V 84 H 284 Z
                            M 206,120 H 232 V 148 H 206 Z
                            M 205,115 H 212 V 120 H 205 Z
                            M 216,115 H 223 V 120 H 216 Z
                            M 226,115 H 233 V 120 H 226 Z" />
                <Path Fill="#F693A7" Opacity="0.45" Data="M 162,210 Q 252,160 360,176 L 360,210 Z" />
            </Canvas>
        </Viewbox>

        <!-- ========================================================== -->
        <!-- SPECIALTY 1: Factory Complex (Từ vựng công xưởng)          -->
        <!-- ========================================================== -->
        <Viewbox x:Name="FactoryArt" Visibility="Collapsed" Stretch="Uniform" VerticalAlignment="Bottom">
            <Canvas Width="320" Height="130">
                <!-- Soft distant blue mountains -->
                <Path Fill="#D5E5FF" Opacity="0.7" Data="M 12,118 Q 75,68 145,98 Q 218,58 308,118 Z" />
                <Path Fill="#BFD6FE" Opacity="0.55" Data="M 48,120 Q 125,78 196,102 Q 255,74 312,120 Z" />

                <!-- Steam puffs -->
                <Ellipse Canvas.Left="104" Canvas.Top="14" Width="18" Height="10" Fill="#DCE9FE" />
                <Ellipse Canvas.Left="116" Canvas.Top="8" Width="22" Height="12" Fill="#EBF2FF" />
                <Ellipse Canvas.Left="184" Canvas.Top="10" Width="20" Height="11" Fill="#DCE9FE" />
                <Ellipse Canvas.Left="196" Canvas.Top="4" Width="24" Height="12" Fill="#EBF2FF" />

                <!-- Chimneys -->
                <Path Fill="#2457C5" Data="M 102,32 H 114 V 85 H 102 Z M 182,26 H 196 V 85 H 182 Z" />
                <Path Fill="#559BFF" Data="M 100,32 H 116 V 37 H 100 Z M 180,26 H 198 V 32 H 180 Z" />

                <!-- Left Silo -->
                <Path Fill="#4B84F0" Data="M 58,64 A 18,10 0 0 1 94,64 V 116 H 58 Z" />
                <Path Fill="#93C5FD" Opacity="0.6" Data="M 64,66 V 114 H 71 V 66 Z" />

                <!-- Main Sawtooth Factory Hall -->
                <Path Fill="#1E46A3" Data="M 94,116 V 62 L 126,46 V 62 L 158,46 V 62 L 190,46 V 116 Z" />
                <Path Fill="#3B72DF" Data="M 188,116 V 58 H 242 V 116 Z" />
                <Path Fill="#2457C5" Data="M 242,116 V 74 H 272 V 116 Z" />

                <!-- Factory Windows & Doors -->
                <Path Fill="#BFDBFE"
                      Data="M 106,74 H 122 V 88 H 106 Z
                            M 136,74 H 152 V 88 H 136 Z
                            M 166,74 H 182 V 88 H 166 Z
                            M 200,72 H 214 V 84 H 200 Z
                            M 220,72 H 234 V 84 H 220 Z
                            M 200,90 H 214 V 102 H 200 Z
                            M 220,90 H 234 V 102 H 220 Z" />
                <Path Fill="#93C5FD" Data="M 130,96 H 158 V 116 H 130 Z" />

                <!-- Ground shadow line -->
                <Rectangle Canvas.Left="32" Canvas.Top="115" Width="256" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#93B8F8" Opacity="0.6" />
            </Canvas>
        </Viewbox>

        <!-- ========================================================== -->
        <!-- SPECIALTY 2: Accounting (Kế toán doanh nghiệp)             -->
        <!-- ========================================================== -->
        <Viewbox x:Name="AccountingArt" Visibility="Collapsed" Stretch="Uniform" VerticalAlignment="Bottom">
            <Canvas Width="320" Height="130">
                <!-- Back Invoice / Tax Document -->
                <Grid Canvas.Left="152" Canvas.Top="14" Width="106" Height="102">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="6" CenterX="53" CenterY="51" />
                    </Grid.RenderTransform>
                    <Border Background="#FFFFFF" BorderBrush="#E9B8E2" BorderThickness="1.8" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <Rectangle Width="44" Height="6" RadiusX="3" RadiusY="3" Fill="#C026A8" HorizontalAlignment="Left" Margin="0,0,0,10" />
                            <Rectangle Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#EBC3E5" Margin="0,0,0,7" />
                            <Rectangle Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#F3D8EF" Margin="0,0,16,7" />
                            <Rectangle Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#EBC3E5" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,0">
                                <Rectangle Width="12" Height="18" RadiusX="3" RadiusY="3" Fill="#EA79D5" Margin="0,0,6,0" />
                                <Rectangle Width="12" Height="26" RadiusX="3" RadiusY="3" Fill="#C026A8" Margin="0,0,6,0" />
                                <Rectangle Width="12" Height="14" RadiusX="3" RadiusY="3" Fill="#F2AEE7" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Angled Purple Calculator -->
                <Grid Canvas.Left="68" Canvas.Top="24" Width="82" Height="94">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="-6" CenterX="41" CenterY="47" />
                    </Grid.RenderTransform>
                    <Border Background="#9327D4" CornerRadius="12" Padding="9">
                        <StackPanel>
                            <Border Background="#F5E8FD" CornerRadius="6" Height="22" Margin="0,0,0,8" Padding="6,0">
                                <TextBlock Text="12,500" FontSize="10" FontWeight="Bold" Foreground="#7E1CB8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                            <UniformGrid Columns="3" Rows="3">
                                <Border Background="#D8B4FE" CornerRadius="3" Height="11" Margin="2" />
                                <Border Background="#D8B4FE" CornerRadius="3" Height="11" Margin="2" />
                                <Border Background="#F472B6" CornerRadius="3" Height="11" Margin="2" />
                                <Border Background="#D8B4FE" CornerRadius="3" Height="11" Margin="2" />
                                <Border Background="#D8B4FE" CornerRadius="3" Height="11" Margin="2" />
                                <Border Background="#F472B6" CornerRadius="3" Height="11" Margin="2" />
                                <Border Background="#D8B4FE" CornerRadius="3" Height="11" Margin="2" />
                                <Border Background="#D8B4FE" CornerRadius="3" Height="11" Margin="2" />
                                <Border Background="#EC4899" CornerRadius="3" Height="11" Margin="2" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Gold Coins Stack -->
                <Canvas Canvas.Left="138" Canvas.Top="64">
                    <!-- Stack 1 -->
                    <Ellipse Canvas.Left="0" Canvas.Top="40" Width="34" Height="12" Fill="#D97706" />
                    <Ellipse Canvas.Left="0" Canvas.Top="36" Width="34" Height="12" Fill="#F59E0B" />
                    <Ellipse Canvas.Left="0" Canvas.Top="30" Width="34" Height="12" Fill="#D97706" />
                    <Ellipse Canvas.Left="0" Canvas.Top="26" Width="34" Height="12" Fill="#FBBF24" />
                    <Ellipse Canvas.Left="0" Canvas.Top="20" Width="34" Height="12" Fill="#D97706" />
                    <Ellipse Canvas.Left="0" Canvas.Top="16" Width="34" Height="12" Fill="#FDE047" />
                    <!-- Stack 2 (lower front) -->
                    <Ellipse Canvas.Left="26" Canvas.Top="44" Width="34" Height="12" Fill="#B45309" />
                    <Ellipse Canvas.Left="26" Canvas.Top="40" Width="34" Height="12" Fill="#F59E0B" />
                    <Ellipse Canvas.Left="26" Canvas.Top="34" Width="34" Height="12" Fill="#D97706" />
                    <Ellipse Canvas.Left="26" Canvas.Top="30" Width="34" Height="12" Fill="#FDE047" />
                </Canvas>

                <!-- Ground shadow -->
                <Rectangle Canvas.Left="54" Canvas.Top="118" Width="212" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#E9B8E2" Opacity="0.65" />
            </Canvas>
        </Viewbox>

        <!-- ========================================================== -->
        <!-- SPECIALTY 3: Export/Import Cargo Ship & Port Crane (XNK)   -->
        <!-- ========================================================== -->
        <Viewbox x:Name="ShippingArt" Visibility="Collapsed" Stretch="Uniform" VerticalAlignment="Bottom">
            <Canvas Width="320" Height="130">
                <!-- Port Gantry Crane in background -->
                <Path Stroke="#8AB753" StrokeThickness="3.2" StrokeLineJoin="Round" Opacity="0.7"
                      Data="M 192,106 V 26 L 236,26 M 236,26 V 106 M 170,38 H 274 M 192,26 L 236,56 M 236,26 L 192,56 M 260,38 V 56" />
                <!-- Suspended container -->
                <Rectangle Canvas.Left="248" Canvas.Top="56" Width="24" Height="13" RadiusX="2" RadiusY="2" Fill="#F59E0B" Opacity="0.9" />

                <!-- Ship Bridge / Cabin -->
                <Path Fill="#FFFFFF" Stroke="#4B6A30" StrokeThickness="1.5"
                      Data="M 86,52 H 116 V 86 H 86 Z M 92,38 H 112 V 52 H 92 Z" />
                <Rectangle Canvas.Left="96" Canvas.Top="43" Width="12" Height="5" Fill="#60A5FA" />
                <Rectangle Canvas.Left="92" Canvas.Top="58" Width="18" Height="5" Fill="#93C5FD" />
                <Rectangle Canvas.Left="100" Canvas.Top="28" Width="4" Height="10" Fill="#EA580C" />

                <!-- Shipping Containers on deck -->
                <Rectangle Canvas.Left="120" Canvas.Top="70" Width="28" Height="15" RadiusX="2" RadiusY="2" Fill="#EF4444" />
                <Rectangle Canvas.Left="150" Canvas.Top="70" Width="28" Height="15" RadiusX="2" RadiusY="2" Fill="#3B82F6" />
                <Rectangle Canvas.Left="180" Canvas.Top="70" Width="28" Height="15" RadiusX="2" RadiusY="2" Fill="#10B981" />
                <Rectangle Canvas.Left="124" Canvas.Top="54" Width="28" Height="14" RadiusX="2" RadiusY="2" Fill="#F59E0B" />
                <Rectangle Canvas.Left="154" Canvas.Top="54" Width="28" Height="14" RadiusX="2" RadiusY="2" Fill="#06B6D4" />

                <!-- Cargo Ship Hull -->
                <Path Fill="#1E3A5F" Data="M 62,84 H 236 L 216,112 H 74 Z" />
                <Path Fill="#2563EB" Opacity="0.45" Data="M 66,84 H 236 L 231,91 H 68 Z" />
                <Path Fill="#DC2626" Data="M 71,105 H 221 L 216,112 H 74 Z" />

                <!-- Water waves -->
                <Path Stroke="#4D94D4" StrokeThickness="2.5" StrokeStartLineCap="Round" Opacity="0.7"
                      Data="M 44,114 Q 80,108 116,114 Q 152,120 188,114 Q 224,108 260,114" />
                <Path Stroke="#70A91C" StrokeThickness="2.2" StrokeStartLineCap="Round" Opacity="0.45"
                      Data="M 68,121 Q 108,116 148,121 Q 188,126 232,121" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
