<UserControl x:Class="QuizApp.Views.CourseIllustrationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Grid>
        <!-- ========================================================== -->
        <!-- HSK 1: Misty Green Hills & Bamboo Leaves                   -->
        <!-- ========================================================== -->
        <Viewbox x:Name="Hsk1Art" Visibility="Collapsed" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Canvas Width="360" Height="210">
                <Canvas.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0.4" EndPoint="0.85,0.65">
                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                        <GradientStop Color="#AAFFFFFF" Offset="0.48" />
                        <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Canvas.OpacityMask>

                <!-- Back hills -->
                <Path Fill="#DDF5E7" Data="M 0,165 Q 85,112 175,148 Q 255,105 360,132 L 360,210 L 0,210 Z" />
                <Path Fill="#BFEAD0" Opacity="0.72" Data="M 60,185 Q 155,126 245,154 Q 305,128 360,148 L 360,210 L 60,210 Z" />
                <Path Fill="#99DDB5" Opacity="0.55" Data="M 145,210 Q 225,155 305,172 Q 338,162 360,168 L 360,210 Z" />

                <!-- Bamboo stalks -->
                <Path Stroke="#48BB78" StrokeThickness="4.5" StrokeStartLineCap="Round" Opacity="0.72"
                      Data="M 308,195 L 322,38 M 332,200 L 344,58 M 288,200 L 298,82" />
                <!-- Bamboo nodes -->
                <Path Stroke="#2F855A" StrokeThickness="2" Opacity="0.65"
                      Data="M 309,156 H 316 M 313,118 H 320 M 317,80 H 324 M 333,162 H 340 M 336,122 H 343 M 340,86 H 347 M 290,152 H 297 M 293,115 H 300" />
                <!-- Bamboo leaves -->
                <Path Fill="#38A169" Opacity="0.62"
                      Data="M 320,82 C 296,72 276,82 268,94 C 285,93 305,89 320,82 Z
                            M 320,82 C 304,60 288,52 272,54 C 288,65 305,74 320,82 Z
                            M 314,116 C 288,108 265,118 254,132 C 275,130 296,124 314,116 Z
                            M 341,90 C 352,70 356,55 358,42 C 344,55 338,72 341,90 Z
                            M 296,112 C 272,96 250,96 238,106 C 258,112 278,114 296,112 Z
                            M 336,128 C 350,115 358,108 360,100 C 345,108 338,118 336,128 Z" />
            </Canvas>
        </Viewbox>

        <!-- ========================================================== -->
        <!-- HSK 2: Sky-Blue Mountains, Pagoda & Clouds                 -->
        <!-- ========================================================== -->
        <Viewbox x:Name="Hsk2Art" Visibility="Collapsed" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Canvas Width="360" Height="210">
                <Canvas.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0.4" EndPoint="0.85,0.65">
                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                        <GradientStop Color="#AAFFFFFF" Offset="0.45" />
                        <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Canvas.OpacityMask>

                <!-- Distant mountains -->
                <Path Fill="#D9EEFF" Data="M 0,175 Q 70,126 140,155 Q 225,110 315,146 L 360,136 L 360,210 L 0,210 Z" />
                <Path Fill="#B9DDFB" Opacity="0.72" Data="M 70,192 Q 155,134 240,162 Q 305,132 360,152 L 360,210 L 70,210 Z" />

                <!-- Pagoda Silhouette -->
                <Path Fill="#5DA9E9" Opacity="0.58"
                      Data="M 278,42 L 281,52 H 275 Z
                            M 262,56 Q 278,62 294,56 L 287,67 H 269 Z
                            M 270,67 H 286 V 76 H 270 Z
                            M 254,76 Q 278,84 302,76 L 293,89 H 263 Z
                            M 265,89 H 291 V 100 H 265 Z
                            M 246,100 Q 278,109 310,100 L 299,115 H 257 Z
                            M 260,115 H 296 V 128 H 260 Z
                            M 238,128 Q 278,139 318,128 L 306,146 H 250 Z
                            M 254,146 H 302 V 165 H 254 Z" />

                <!-- Soft mist & foreground hill -->
                <Path Fill="#95CAF6" Opacity="0.55" Data="M 135,210 Q 220,160 298,176 Q 332,168 360,175 L 360,210 Z" />
                <Path Fill="#FFFFFF" Opacity="0.65" Data="M 190,150 Q 218,142 246,150 Q 262,146 276,153 Q 230,162 190,150 Z" />
            </Canvas>
        </Viewbox>

        <!-- ========================================================== -->
        <!-- HSK 3: Warm Amber Great Wall & Sun                         -->
        <!-- ========================================================== -->
        <Viewbox x:Name="Hsk3Art" Visibility="Collapsed" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Canvas Width="360" Height="210">
                <Canvas.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0.4" EndPoint="0.85,0.65">
                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                        <GradientStop Color="#AAFFFFFF" Offset="0.45" />
                        <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Canvas.OpacityMask>

                <!-- Glowing sun -->
                <Ellipse Canvas.Left="248" Canvas.Top="44" Width="56" Height="56" Fill="#FFE1BA" Opacity="0.78" />
                <Ellipse Canvas.Left="257" Canvas.Top="53" Width="38" Height="38" Fill="#FFCE8C" Opacity="0.65" />

                <!-- Warm hills -->
                <Path Fill="#FFEAD4" Data="M 0,175 Q 90,128 178,154 Q 265,112 360,138 L 360,210 L 0,210 Z" />
                <Path Fill="#FDD3AA" Opacity="0.75" Data="M 95,195 Q 190,136 285,160 Q 325,142 360,152 L 360,210 L 95,210 Z" />

                <!-- Great Wall & Watchtower -->
                <Path Fill="#EA8C42" Opacity="0.48"
                      Data="M 168,175 L 222,142 L 266,118 L 288,125 L 288,140 L 235,168 L 178,195 Z" />
                <!-- Watchtower -->
                <Path Fill="#E27B2B" Opacity="0.58"
                      Data="M 262,88 H 294 V 126 H 262 Z
                            M 260,82 H 267 V 88 H 260 Z
                            M 271,82 H 278 V 88 H 271 Z
                            M 282,82 H 289 V 88 H 282 Z
                            M 291,82 H 296 V 88 H 291 Z" />
                <!-- Foreground slope -->
                <Path Fill="#F6B982" Opacity="0.45" Data="M 155,210 Q 245,162 360,178 L 360,210 Z" />
            </Canvas>
        </Viewbox>

        <!-- ========================================================== -->
        <!-- HSK 4: Lavender Pagoda & Cherry Blossoms                   -->
        <!-- ========================================================== -->
