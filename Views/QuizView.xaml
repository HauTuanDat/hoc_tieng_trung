<UserControl x:Class="QuizApp.Views.QuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuizApp.Views"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:QuizViewModel}"
             d:DesignHeight="750" d:DesignWidth="900">
    <Grid>
        <!-- Loading State -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="6" Style="{StaticResource ModernProgressBarStyle}" />
                <TextBlock Text="Đang tải dữ liệu từ SQL Server..." 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           FontSize="14" Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Error State -->
        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="600" Background="White" CornerRadius="16" Padding="32"
                Effect="{StaticResource CardShadow}">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource ErrorBgBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Không thể tải câu hỏi" FontSize="18" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="Thử lại" Command="{Binding RetryLoadingCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
                    <Button Content="✕ Thoát" Command="{Binding ExitCommand}" Style="{StaticResource OutlineButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area when loaded -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,32">
                <!-- Main Quiz Card matching the screenshot -->
                <Border Width="760"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="36,32"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Title & Category Badge -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Luyện tập từ vựng"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />

                                <Border Background="#EEF2FF"
                                        BorderBrush="#E0E7FF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentQuestion.Category, TargetNullValue='CƠ BẢN'}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Right: Question Index & Timer -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QuestionNumberText}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />

                                <TextBlock Text=" • ⏱ " 
                                           FontSize="13" 
                                           Foreground="{StaticResource TextMutedBrush}" 
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TimeElapsedText}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Progress Bar Under Header -->
                        <ProgressBar Margin="0,16,0,0"
                                     Value="{Binding ProgressPercentage, Mode=OneWay}"
                                     Maximum="100"
                                     Style="{StaticResource ModernProgressBarStyle}" />

                        <!-- Review Phase Notification Banner -->
                        <Border Margin="0,14,0,0"
                                Background="#FEF3C7"
                                BorderBrush="#FCD34D"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="14,10"
                                Visibility="{Binding IsReviewPhase, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🔄 " FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="VÒNG ÔN TẬP CÂU SAI: Hãy trả lời lại các câu bạn đã làm chưa đúng để ghi nhớ nhé!"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#92400E"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Question Highlight Sub-card -->
                        <Border Margin="0,22,0,0"
                                Background="{StaticResource SubCardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                Padding="28,24">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Badge: ✨ NGHĨA CỦA TỪ -->
                                <Border Background="{StaticResource PurpleBadgeBgBrush}"
                                        CornerRadius="12"
                                        Padding="14,4"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentQuestion.Tag, TargetNullValue='✨ NGHĨA CỦA TỪ'}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PurpleBadgeTextBrush}" />
                                </Border>

                                <!-- Big Main Prompt (Hanzi or Meaning) with Pronunciation Button -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <TextBlock Text="{Binding CurrentQuestion.Prompt, TargetNullValue='Chăm chỉ, siêng năng'}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Content="🔊"
                                            Command="{Binding PlayAudioCommand}"
                                            Style="{StaticResource OutlineButton}"
                                            Padding="8,4"
                                            Margin="10,0,0,0"
                                            FontSize="15"
                                            VerticalAlignment="Center"
                                            ToolTip="Nghe phát âm chuẩn giọng Xiaoxiao" />
                                </StackPanel>

                                <!-- Meaning Explanation Sentence -->
                                <TextBlock Text="{Binding CurrentQuestion.Explanation, TargetNullValue='Luôn nỗ lực và cẩn thận trong công việc hoặc học tập.'}"
                                           FontSize="15"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />

                                <!-- Part of Speech / Grammar Note -->
                                <TextBlock Text="{Binding CurrentQuestion.PartOfSpeech, TargetNullValue='Tính từ • Mô tả tính cách'}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Answer Instruction Line -->
                        <Grid Margin="0,22,0,10">
                            <TextBlock Text="{Binding CurrentQuestion.QuestionText, TargetNullValue='Từ tiếng Anh nào phù hợp với nghĩa trên?'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <TextBlock Text="Chọn 1 đáp án"
                                       HorizontalAlignment="Right"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- 2x2 Grid of Answer Options -->
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Option A -->
                            <local:OptionCardControl Grid.Row="0" Grid.Column="0"
                                                     DataContext="{Binding OptionA}"
                                                     SelectCommand="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.SelectOptionCommand}" />

                            <!-- Option B -->
                            <local:OptionCardControl Grid.Row="0" Grid.Column="1"
                                                     DataContext="{Binding OptionB}"
                                                     SelectCommand="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.SelectOptionCommand}" />

                            <!-- Option C -->
                            <local:OptionCardControl Grid.Row="1" Grid.Column="0"
                                                     DataContext="{Binding OptionC}"
                                                     SelectCommand="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.SelectOptionCommand}" />

                            <!-- Option D -->
                            <local:OptionCardControl Grid.Row="1" Grid.Column="1"
                                                     DataContext="{Binding OptionD}"
                                                     SelectCommand="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.SelectOptionCommand}" />
                        </Grid>

                        <!-- Explanation Feedback Card (shown when checked) -->
                        <Border Margin="0,16,0,0"
                                CornerRadius="12"
                                Padding="16,12"
                                Visibility="{Binding IsAnswerChecked, Converter={StaticResource BoolToVisibility}}"
                                Background="{Binding IsCurrentAnswerCorrect, Converter={x:Null}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentAnswerCorrect}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrentAnswerCorrect}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource ErrorBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FeedbackExplanation}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentAnswerCorrect}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrentAnswerCorrect}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1"
                                        Content="🔊 Nghe đọc"
                                        Command="{Binding PlayAudioCommand}"
                                        Style="{StaticResource OutlineButton}"
                                        Padding="10,5"
                                        Margin="12,0,0,0"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        ToolTip="Nghe phát âm chuẩn giọng Xiaoxiao" />
                            </Grid>
                        </Border>

                        <!-- Card Footer Controls -->
                        <Grid Margin="0,22,0,0">
                            <!-- Left: Keyboard Shortcut Hint -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⌨" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Dùng phím A–D để chọn đáp án (Enter để tiếp tục)"
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right: Check / Next Button -->
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding CheckOrNextCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="{Binding CheckButtonText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Footer Text Below Card -->
                <TextBlock Text="Một từ mới mỗi ngày, một bước tiến mỗi lần học."
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
