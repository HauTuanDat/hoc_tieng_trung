<UserControl x:Class="QuizApp.Views.VocabStudyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VocabStudyViewModel}"
             Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Banner with Brand & Level Dropdown -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,14" Effect="{DynamicResource CardShadow}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                        <TextBlock Text="语" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Học từ vựng" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Học từ vựng mới mỗi ngày, tích lũy từng chút để chinh phục tiếng Trung!" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Level Pill Switcher -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding SelectLevelCommand}" CommandParameter="HSK 1" Content="HSK 1" Style="{StaticResource NavPillButton}" Margin="0,0,4,0" />
                    <Button Command="{Binding SelectLevelCommand}" CommandParameter="HSK 2" Content="HSK 2" Style="{StaticResource NavPillButton}" Margin="0,0,4,0" />
                    <Button Command="{Binding SelectLevelCommand}" CommandParameter="HSK 3" Content="HSK 3" Style="{StaticResource NavPillButton}" Margin="0,0,4,0" />
                    <Button Command="{Binding SelectLevelCommand}" CommandParameter="Công xưởng" Content="Công xưởng" Style="{StaticResource NavPillButton}" Margin="0,0,4,0" />
                    <Button Command="{Binding SelectLevelCommand}" CommandParameter="Kế toán" Content="Kế toán" Style="{StaticResource NavPillButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: 4 Sub-Tabs: [Học từ mới] | [Ôn tập] | [Đã học] | [Từ đánh dấu] -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Padding="16,8" Margin="0,0,8,0">
                <TextBlock Text="📖 Học từ mới" FontSize="13" FontWeight="Bold" Foreground="White" />
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16,8" Margin="0,0,8,0">
                <TextBlock Text="🔄 Ôn tập" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16,8" Margin="0,0,8,0">
                <TextBlock Text="✅ Đã học" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16,8">
                <TextBlock Text="⭐ Từ đánh dấu" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </StackPanel>

        <!-- Row 2: 3 Columns Main Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- COLUMN 1: Lesson List Navigation               -->
            <!-- ============================================== -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,14,0" Effect="{DynamicResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Current Level Header -->
                        <Border Background="{DynamicResource PrimaryTintBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="{Binding CurrentLevel}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="45%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Lessons in Level -->
                        <ItemsControl ItemsSource="{Binding Lessons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectLessonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Margin="0,0,0,5"
                                            BorderThickness="0"
                                            Background="Transparent">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="itemBorder"
                                                                    CornerRadius="8"
                                                                    Padding="12,9"
                                                                    Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="1.5">
                                                                <Grid>
                                                                    <TextBlock x:Name="itemText" Text="{Binding Title}" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,38,0" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="itemProg" Text="{Binding ProgressText}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <!-- 1. Mouse Over Hover Effect (Theme Jade Green) -->
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
                                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryLightBorderBrush}" />
                                                                    <Setter TargetName="itemText" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter TargetName="itemText" Property="FontWeight" Value="SemiBold" />
                                                                </Trigger>
                                                                <!-- 2. Selected Active State (Solid Jade Green) -->
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
                                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter TargetName="itemText" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter TargetName="itemText" Property="FontWeight" Value="Bold" />
                                                                    <Setter TargetName="itemProg" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter TargetName="itemProg" Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                                <!-- 3. Locked State -->
                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Setter TargetName="itemBorder" Property="Opacity" Value="0.5" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Other Levels Divider -->
                        <Border Height="1" Background="{DynamicResource BorderLightBrush}" Margin="0,10,0,10" />

                        <!-- Quick Level Switch Links -->
                        <TextBlock Text="Các cấp độ khác" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,6" />
                        <Button Command="{Binding SelectLevelCommand}" CommandParameter="HSK 2" Content="📘 HSK 2 (Sơ cấp)" Style="{StaticResource SidebarNavButton}" FontSize="13.5" Padding="8,6" />
                        <Button Command="{Binding SelectLevelCommand}" CommandParameter="HSK 3" Content="📙 HSK 3 (Trung cấp)" Style="{StaticResource SidebarNavButton}" FontSize="13.5" Padding="8,6" />
                        <Button Command="{Binding SelectLevelCommand}" CommandParameter="HSK 4" Content="📗 HSK 4 (Nâng cao)" Style="{StaticResource SidebarNavButton}" FontSize="13.5" Padding="8,6" />
                        <Button Command="{Binding SelectLevelCommand}" CommandParameter="Công xưởng" Content="🏭 Công xưởng" Style="{StaticResource SidebarNavButton}" FontSize="13.5" Padding="8,6" />
                        <Button Command="{Binding SelectLevelCommand}" CommandParameter="Kế toán" Content="🧮 Kế toán" Style="{StaticResource SidebarNavButton}" FontSize="13.5" Padding="8,6" />
                        <Button Command="{Binding SelectLevelCommand}" CommandParameter="Xuất nhập khẩu" Content="🚢 Xuất nhập khẩu" Style="{StaticResource SidebarNavButton}" FontSize="13.5" Padding="8,6" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================================== -->
            <!-- COLUMN 2: Center Vocab Interactive Study Card   -->
            <!-- ============================================== -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="24" Effect="{DynamicResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header with Lesson Title & Progress Steps -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{Binding LessonHeaderTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProgressStepText}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <ProgressBar Value="{Binding ProgressStepValue, Mode=OneWay}" Width="80" Height="6" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 1. Big Vocab Word Card -->
                        <Border Background="#FAF6F0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="16" Padding="24,18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Badges -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                        <TextBlock Text="Từ vựng mới" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <Border Background="#F6E7D2" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="Học" FontSize="13" FontWeight="SemiBold" Foreground="#8C5311" />
                                    </Border>
                                </StackPanel>

                                <!-- Large Hanzi and Pinyin (Đã bỏ nghĩa để không bị lộ đáp án trắc nghiệm) -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentWord}" FontFamily="{StaticResource ChineseFontFamily}" FontSize="54" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding CurrentPinyin}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Round Audio Button -->
                                <Button Grid.Column="2"
                                        Command="{Binding PlayWordAudioCommand}"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        BorderThickness="0"
                                        Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PrimaryBrush}" Effect="{StaticResource ButtonGlowShadow}">
                                                <TextBlock Text="🔊" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 2. Example Sentence Box -->
                        <Border Background="#FFFDFB" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,16">
                            <Grid>
                                <StackPanel Margin="0,0,40,0">
                                    <TextBlock Text="📖 Ví dụ câu thực tế:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding ExampleHanzi}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding ExamplePinyin}" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding ExampleMeaning}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>

                                <!-- Play Example Audio -->
                                <Button Command="{Binding PlayExampleAudioCommand}"
                                        Style="{StaticResource OutlineButton}"
                                        Padding="10,6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        ToolTip="Nghe câu ví dụ">
                                    <TextBlock Text="🔊" FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 3. Interactive Quiz Question Check -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="❓ " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding QuestionPrompt}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding QuestionNumberText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- 4 Options (A, B, C, D) -->
                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Margin="0,0,0,8"
                                                    BorderThickness="0"
                                                    Background="Transparent">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="optBorder"
                                                                            Background="#FAF6F0"
                                                                            BorderBrush="{DynamicResource BorderLightBrush}"
                                                                            BorderThickness="1.5"
                                                                            CornerRadius="10"
                                                                            Padding="14,10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Margin="0,0,12,0">
                                                                                <TextBlock Text="{Binding Key}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>

                                                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                                                            <TextBlock x:Name="statusIcon" Grid.Column="2" Text="" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                                            <Setter TargetName="optBorder" Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                                                            <Setter TargetName="optBorder" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                                            <Setter TargetName="statusIcon" Property="Text" Value="✔" />
                                                                            <Setter TargetName="statusIcon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsWrong}" Value="True">
                                                                            <Setter TargetName="optBorder" Property="Background" Value="{StaticResource ErrorBgBrush}" />
                                                                            <Setter TargetName="optBorder" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                                                            <Setter TargetName="statusIcon" Property="Text" Value="✖" />
                                                                            <Setter TargetName="statusIcon" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="optBorder" Property="BorderBrush" Value="{DynamicResource PrimaryLightBorderBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Bottom Action Navigation Buttons -->
                        <Grid>
                            <Button Command="{Binding PlayWordAudioCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Padding="18,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔊 " FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Nghe lại" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NextWordCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Right" Padding="26,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tiếp theo " FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="➜" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================================== -->
            <!-- COLUMN 3: Right Study Progress & Encouragement  -->
            <!-- ============================================== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0">
                <StackPanel>
                    <!-- Progress Card with Circle Gauge -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12" Effect="{DynamicResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Tiến độ học từ vựng" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                            <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Border Width="76" Height="76" CornerRadius="38" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="4" Background="{DynamicResource PrimaryTintBrush}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="45%" FontSize="16" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Đã học" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="12 / 25 từ hoàn thành" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />

                            <Grid Background="#FAF6F0" Margin="0,4,0,0">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Grid>
                                        <TextBlock Text="🌱 Từ mới hôm nay: 5" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="⚠️ Cần ôn: 3" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Today's Schedule Checklist -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12" Effect="{DynamicResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="📅 Lịch học hôm nay" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Hôm nay • Luyện đều tay" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" />

                            <!-- Item 1 -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="✔ Học từ mới (5 từ)" FontSize="13.5" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Hoàn thành" FontSize="13" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Item 2 -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="✔ Luyện tập (5 câu)" FontSize="13.5" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Hoàn thành" FontSize="13" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Item 3 -->
                            <Grid>
                                <TextBlock Text="⏳ Ôn tập từ cũ (5 từ)" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Đang làm" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Medium" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Panda Mascot Encouragement Card -->
                    <Border Background="#FDF8F2" BorderBrush="{DynamicResource PrimaryLightBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🐼 Cố lên!" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="&quot;Học mỗi ngày là một bước tiến gần hơn đến ước mơ!&quot;" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Display Options: Text size -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Cỡ chữ hiển thị" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="3">
                                <Button Content="A-" Style="{StaticResource OutlineButton}" Padding="4" FontSize="13" Margin="0,0,2,0" />
                                <Button Content="A" Style="{StaticResource OutlineButton}" Padding="4" FontSize="13" Margin="2,0,2,0" />
                                <Button Content="A+" Style="{StaticResource OutlineButton}" Padding="4" FontSize="13" Margin="2,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

