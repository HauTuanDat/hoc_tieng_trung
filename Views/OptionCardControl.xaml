<UserControl x:Class="QuizApp.Views.OptionCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="340">
    <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectCommand}"
            CommandParameter="{Binding Key}"
            Cursor="Hand"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Margin="6">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="CardBorder"
                        Background="#FFFFFF"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="18,14"
                        SnapsToDevicePixels="True"
                        Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Key Badge (A, B, C, D) -->
                        <Border x:Name="KeyBadge"
                                Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="12"
                                Background="#F1F5F9"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="KeyText"
                                       Text="{Binding Key}"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- Option Word Text (Bold Chinese Characters) -->
                        <TextBlock x:Name="WordText"
                                   Grid.Column="1"
                                   Text="{Binding Text}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,10,0"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Right Status Indicator (Radio / Check / Cross) -->
                        <Border x:Name="IndicatorCircle"
                                Grid.Column="2"
                                Width="26" Height="26"
                                CornerRadius="13"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1.5"
                                Background="Transparent"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="IndicatorIcon"
                                       Text=""
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <ControlTemplate.Triggers>
                    <!-- Mouse Over when not checked and not selected -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            <Condition Binding="{Binding IsSelected}" Value="False" />
                            <Condition Binding="{Binding IsAnswerChecked}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC" />
                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryLightBorderBrush}" />
                        <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource CardHoverShadow}" />
                    </MultiDataTrigger>

                    <!-- Selected State (before checking) -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected}" Value="True" />
                            <Condition Binding="{Binding IsAnswerChecked}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                        <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource SelectedOptionShadow}" />
                        <Setter TargetName="KeyBadge" Property="Background" Value="{DynamicResource PrimaryGradientBrush}" />
                        <Setter TargetName="KeyText" Property="Foreground" Value="White" />
                        <Setter TargetName="IndicatorCircle" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                        <Setter TargetName="IndicatorCircle" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        <Setter TargetName="IndicatorIcon" Property="Text" Value="✓" />
                    </MultiDataTrigger>

                    <!-- Checked: Correct Answer (Vibrant Emerald Glow) -->
                    <DataTrigger Binding="{Binding IsCorrectHighlight}" Value="True">
                        <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SuccessBgBrush}" />
                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                        <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource SuccessGlowShadow}" />
                        <Setter TargetName="WordText" Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                        <Setter TargetName="KeyBadge" Property="Background" Value="{StaticResource SuccessGradientBrush}" />
                        <Setter TargetName="KeyText" Property="Foreground" Value="White" />
                        <Setter TargetName="IndicatorCircle" Property="Background" Value="{StaticResource SuccessBrush}" />
                        <Setter TargetName="IndicatorCircle" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                        <Setter TargetName="IndicatorIcon" Property="Text" Value="✓" />
                    </DataTrigger>

                    <!-- Checked: User chose Wrong Answer (Vibrant Rose Glow) -->
                    <DataTrigger Binding="{Binding IsWrongHighlight}" Value="True">
                        <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource ErrorBgBrush}" />
                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                        <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource ErrorGlowShadow}" />
                        <Setter TargetName="WordText" Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                        <Setter TargetName="KeyBadge" Property="Background" Value="{StaticResource ErrorBrush}" />
                        <Setter TargetName="KeyText" Property="Foreground" Value="White" />
                        <Setter TargetName="IndicatorCircle" Property="Background" Value="{StaticResource ErrorBrush}" />
                        <Setter TargetName="IndicatorCircle" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                        <Setter TargetName="IndicatorIcon" Property="Text" Value="✕" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
