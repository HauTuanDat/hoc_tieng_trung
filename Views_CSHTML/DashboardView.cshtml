@model QuizApp.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Trang tổng quan HSK";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Hero Banner with Mascot & Quick Stats -->
    <div class="relative bg-gradient-to-r from-[#15965B] to-[#10B981] rounded-3xl p-6 sm:p-8 text-white overflow-hidden shadow-lg">
        <div class="relative z-10 max-w-2xl space-y-3">
            <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold text-white">
                <span>🌟 Lộ trình toàn diện HSK 1 ~ 6</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Chào mừng bạn trở lại, Minh Đạt! 👋</h1>
            <p class="text-emerald-50 text-sm sm:text-base leading-relaxed">
                Hôm nay là một ngày tuyệt vời để nạp thêm 20 từ vựng mới và duy trì chuỗi học tập của bạn!
            </p>
            <div class="pt-2 flex flex-wrap gap-3">
                <a href="/PracticeCenterView" class="px-5 py-2.5 bg-white text-[#15965B] font-bold text-sm rounded-xl hover:bg-emerald-50 shadow-md transition-all inline-flex items-center gap-2">
                    <span>🎯 Luyện tập ngay</span>
                </a>
                <a href="/VocabStudyView" class="px-5 py-2.5 bg-black/20 hover:bg-black/30 text-white font-semibold text-sm rounded-xl backdrop-blur-sm transition-all inline-flex items-center gap-2">
                    <span>📖 Học từ mới</span>
                </a>
            </div>
        </div>

        <!-- Mascot Illustration -->
        <div class="absolute -right-4 -bottom-6 hidden md:block w-56 h-56 opacity-95">
            <img src="/Assets/panda_hero_art_hd.png" alt="Panda Hero" class="w-full h-full object-contain" />
        </div>
    </div>

    <!-- 4 Key Stat Metric Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Metric 1: Total Vocab -->
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#15965B] flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            </div>
            <div>
                <span class="text-xs text-gray-500 font-medium">Tổng từ vựng</span>
                <p class="text-2xl font-bold text-[#203B3A]">5,002 <span class="text-xs text-gray-400 font-normal">từ</span></p>
            </div>
        </div>

        <!-- Metric 2: Mastered Vocab -->
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <span class="text-xs text-gray-500 font-medium">Đã thuộc làu</span>
                <p class="text-2xl font-bold text-blue-600">348 <span class="text-xs text-gray-400 font-normal">từ</span></p>
            </div>
        </div>

        <!-- Metric 3: Streak Flame -->
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2c-.5 2-2 3.5-3 5.5-1.5 3-1 6.5 1.5 8.5 1.5-1 2-2.5 2-4.5 2 2 3.5 3 3.5 6 0 4-3 6.5-6 6.5s-6-2.5-6-6.5c0-4 3-7.5 5-9.5 1-1 2-2.5 2.5-4 0-.5.5-.5.5-.5z"/></svg>
            </div>
            <div>
                <span class="text-xs text-gray-500 font-medium">Chuỗi ngày học</span>
                <p class="text-2xl font-bold text-orange-500">7 <span class="text-xs text-gray-400 font-normal">ngày 🔥</span></p>
            </div>
        </div>

        <!-- Metric 4: Daily Goal -->
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <span class="text-xs text-gray-500 font-medium">Thời gian học</span>
                <p class="text-2xl font-bold text-purple-600">45 <span class="text-xs text-gray-400 font-normal">phút/ngày</span></p>
            </div>
        </div>
    </div>

    <!-- HSK 1 to 6 Roadmap Section -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-xl font-bold text-[#203B3A]">Lộ trình các cấp độ HSK</h2>
                <p class="text-xs text-gray-500">Từ vựng chuẩn Hanban theo từng cấp bậc</p>
            </div>
            <a href="/CourseSelectionView" class="text-xs font-bold text-[#15965B] hover:underline">Xem tất cả khóa &gt;</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <!-- HSK 1 Card -->
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-shadow space-y-4">
                <div class="flex items-center justify-between">
                    <span class="px-2.5 py-1 rounded-lg bg-emerald-100 text-[#15965B] text-xs font-bold">HSK 1 • Sơ cấp</span>
                    <span class="text-xs font-semibold text-gray-400">149 từ</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[#203B3A]">Khởi đầu căn bản</h3>
                    <p class="text-xs text-gray-500 mt-1">Chào hỏi, gia đình, chữ số, thời gian thường nhật.</p>
                </div>
                <div>
                    <div class="flex justify-between text-xs font-medium text-gray-500 mb-1">
                        <span>Tiến độ</span>
                        <span class="font-bold text-[#15965B]">100%</span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2">
                        <div class="bg-[#15965B] h-2 rounded-full w-full"></div>
                    </div>
                </div>
                <div class="pt-2 flex gap-2">
                    <a href="/QuizView" class="flex-1 py-2 text-center rounded-xl bg-[#15965B] text-white text-xs font-bold hover:bg-[#11804D]">Luyện thi</a>
                    <a href="/TypingPracticeView" class="flex-1 py-2 text-center rounded-xl bg-gray-100 text-[#203B3A] text-xs font-semibold hover:bg-gray-200">Luyện gõ</a>
                </div>
            </div>

            <!-- HSK 2 Card -->
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-shadow space-y-4">
                <div class="flex items-center justify-between">
                    <span class="px-2.5 py-1 rounded-lg bg-teal-100 text-teal-700 text-xs font-bold">HSK 2 • Giao tiếp</span>
                    <span class="text-xs font-semibold text-gray-400">150 từ</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[#203B3A]">Giao tiếp thường nhật</h3>
                    <p class="text-xs text-gray-500 mt-1">Mua sắm, ăn uống, hỏi đường, sở thích cá nhân.</p>
                </div>
                <div>
                    <div class="flex justify-between text-xs font-medium text-gray-500 mb-1">
                        <span>Tiến độ</span>
                        <span class="font-bold text-teal-600">75%</span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2">
                        <div class="bg-teal-500 h-2 rounded-full w-3/4"></div>
                    </div>
                </div>
                <div class="pt-2 flex gap-2">
                    <a href="/QuizView" class="flex-1 py-2 text-center rounded-xl bg-teal-600 text-white text-xs font-bold hover:bg-teal-700">Luyện thi</a>
                    <a href="/TypingPracticeView" class="flex-1 py-2 text-center rounded-xl bg-gray-100 text-[#203B3A] text-xs font-semibold hover:bg-gray-200">Luyện gõ</a>
                </div>
            </div>

            <!-- HSK 3 Card -->
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-shadow space-y-4">
                <div class="flex items-center justify-between">
                    <span class="px-2.5 py-1 rounded-lg bg-blue-100 text-blue-700 text-xs font-bold">HSK 3 • Trung cấp 1</span>
                    <span class="text-xs font-semibold text-gray-400">295 từ</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[#203B3A]">Đàm thoại tự tin</h3>
                    <p class="text-xs text-gray-500 mt-1">Công việc, du lịch, cảm xúc, biểu đạt suy nghĩ mạch lạc.</p>
                </div>
                <div>
                    <div class="flex justify-between text-xs font-medium text-gray-500 mb-1">
                        <span>Tiến độ</span>
                        <span class="font-bold text-blue-600">30%</span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2">
                        <div class="bg-blue-600 h-2 rounded-full w-1/3"></div>
                    </div>
                </div>
                <div class="pt-2 flex gap-2">
                    <a href="/QuizView" class="flex-1 py-2 text-center rounded-xl bg-blue-600 text-white text-xs font-bold hover:bg-blue-700">Luyện thi</a>
                    <a href="/TypingPracticeView" class="flex-1 py-2 text-center rounded-xl bg-gray-100 text-[#203B3A] text-xs font-semibold hover:bg-gray-200">Luyện gõ</a>
                </div>
            </div>
        </div>
    </div>
</div>
