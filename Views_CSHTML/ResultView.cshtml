@model QuizApp.ViewModels.ResultViewModel
@{
    ViewData["Title"] = "Kết quả bài thi";
}
<div class="max-w-xl mx-auto px-4 py-12 text-center space-y-6">
    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-xl space-y-6">
        <div class="w-24 h-24 mx-auto rounded-full bg-emerald-50 text-[#15965B] flex items-center justify-center text-4xl shadow-inner">
            🎉
        </div>
        
        <div class="space-y-1">
            <h1 class="text-2xl font-extrabold text-[#203B3A]">Chúc mừng bạn đã hoàn thành!</h1>
            <p class="text-xs text-gray-500">Đợt luyện tập 20 câu HSK 1</p>
        </div>

        <!-- Score Ring -->
        <div class="bg-[#F0FDF4] border border-[#BBF7D0] rounded-2xl p-6 max-w-xs mx-auto">
            <span class="text-4xl font-black text-[#15965B]">18 / 20</span>
            <p class="text-xs font-bold text-emerald-700 mt-1">Đạt 90% • Xuất sắc (Yêu cầu &ge; 70%)</p>
        </div>

        <!-- Action Buttons -->
        <div class="space-y-3 pt-2">
            <a href="/QuizView" class="block w-full py-3.5 bg-[#15965B] hover:bg-[#11804D] text-white font-bold text-sm rounded-xl shadow-md transition-all">
                🚀 Tiếp tục với 20 từ tiếp theo ➔
            </a>
            <a href="/DashboardView" class="block w-full py-3 bg-gray-100 hover:bg-gray-200 text-[#203B3A] font-semibold text-sm rounded-xl transition-all">
                🏠 Dừng lại & Về trang chủ
            </a>
        </div>
    </div>
</div>
