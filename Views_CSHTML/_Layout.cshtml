<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mộc Ngữ • Nền tảng học tiếng Trung HSK</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            DEFAULT: '#15965B',
                            hover: '#11804D',
                            light: '#ECFDF5',
                            border: '#BBF7D0'
                        },
                        dark: {
                            DEFAULT: '#203B3A',
                            muted: '#59685F'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'Be Vietnam Pro', 'system-ui', 'sans-serif'],
                        chinese: ['Microsoft YaHei', 'SimSun', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Be Vietnam Pro', 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
        }
    </style>
</head>
<body class="bg-[#F8F9FA] text-[#203B3A] min-h-screen flex flex-col">
    <!-- Top Global Navigation Bar -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="/DashboardView" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-white font-bold text-xl shadow-sm group-hover:scale-105 transition-transform">
                    语
                </div>
                <div>
                    <span class="text-xl font-bold text-primary block leading-tight">Mộc Ngữ</span>
                    <span class="text-xs text-dark-muted font-medium">Học tiếng Trung HSK 1 - 6</span>
                </div>
            </a>

            <!-- Nav Links -->
            <nav class="hidden md:flex items-center gap-1 font-medium text-sm">
                <a href="/DashboardView" class="px-3 py-2 rounded-lg hover:bg-gray-100 text-[#203B3A] transition-colors">Trang chủ</a>
                <a href="/CourseSelectionView" class="px-3 py-2 rounded-lg hover:bg-gray-100 text-[#203B3A] transition-colors">Khóa học HSK</a>
                <a href="/PracticeCenterView" class="px-3 py-2 rounded-lg hover:bg-gray-100 text-[#203B3A] transition-colors">Luyện tập</a>
                <a href="/GameMapView" class="px-3 py-2 rounded-lg hover:bg-gray-100 text-[#203B3A] transition-colors">Bản đồ thử thách</a>
                <a href="/VocabListView" class="px-3 py-2 rounded-lg hover:bg-gray-100 text-[#203B3A] transition-colors">Sổ tay từ vựng</a>
                <a href="/DictionaryView" class="px-3 py-2 rounded-lg hover:bg-gray-100 text-[#203B3A] transition-colors">Tra từ điển</a>
            </nav>

            <!-- User Status & Actions -->
            <div class="flex items-center gap-3">
                <div class="hidden sm:flex items-center gap-2 bg-orange-50 border border-orange-200 px-3 py-1.5 rounded-full text-orange-600 text-xs font-bold">
                    <span>🔥 Streak 7 ngày</span>
                </div>
                <a href="/ProfileSettingsView" class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-gray-100 transition-colors">
                    <img src="/Assets/panda_mascot_perfect.png" alt="Avatar" class="w-8 h-8 rounded-full border border-gray-200 object-cover" />
                    <span class="hidden lg:inline text-sm font-semibold text-[#203B3A]">Minh Đạt</span>
                </a>
                <a href="/LoginView" class="text-xs font-semibold text-gray-500 hover:text-red-600 px-2 py-1">Đăng xuất</a>
            </div>
        </div>
    </header>

    <!-- Main Page Content Body -->
    <main class="flex-1">
        @RenderBody()
    </main>

    <!-- Global Footer -->
    <footer class="bg-white border-t border-gray-200 py-6 mt-12 text-center text-xs text-gray-500">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p>© 2026 Mộc Ngữ • Nền tảng học tiếng Trung toàn diện</p>
            <div class="flex items-center gap-4 text-gray-400">
                <a href="/DatabaseSettingsView" class="hover:text-gray-600">Cơ sở dữ liệu</a>
                <span>•</span>
                <a href="/QuestionManagementView" class="hover:text-gray-600">Ngân hàng câu hỏi</a>
                <span>•</span>
                <span>Hỗ trợ HSK 1 ~ 6</span>
            </div>
        </div>
    </footer>
</body>
</html>
