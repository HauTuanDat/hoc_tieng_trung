@model QuizApp.ViewModels.CourseSelectionViewModel
@{
    ViewData["Title"] = "Chọn khóa học HSK";
}
<div class="max-w-7xl mx-auto px-4 py-8 space-y-6">
    <div class="text-center max-w-2xl mx-auto space-y-2">
        <h1 class="text-3xl font-extrabold text-[#203B3A]">Khóa học & Lộ trình HSK 1 - 6</h1>
        <p class="text-sm text-gray-500">Lựa chọn cấp độ phù hợp để bắt đầu luyện tập trắc nghiệm, phản xạ và gõ từ vựng</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-4">
        @for (int i = 1; i <= 6; i++)
        {
            var wordCount = i == 1 ? 149 : i == 2 ? 150 : i == 3 ? 295 : i == 4 ? 600 : i == 5 ? 1295 : 2513;
            <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm hover:shadow-lg transition-all space-y-4">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#15965B] flex items-center justify-center font-black text-xl">
                    H@(i)
                </div>
                <div>
                    <h2 class="text-xl font-bold text-[#203B3A]">Cấp độ HSK @i</h2>
                    <p class="text-xs text-gray-400">@wordCount từ vựng chuẩn • Giáo trình mới nhất</p>
                </div>
                <a href="/QuizView" class="block w-full py-3 text-center bg-[#15965B] hover:bg-[#11804D] text-white font-bold text-sm rounded-xl shadow-sm transition-colors">
                    Bắt đầu học HSK @i
                </a>
            </div>
        }
    </div>
</div>
