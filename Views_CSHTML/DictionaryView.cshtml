@model QuizApp.ViewModels.DictionaryViewModel
@{
    ViewData["Title"] = "Tra cứu từ điển tiếng Trung";
}
<div class="max-w-4xl mx-auto px-4 py-8 space-y-6">
    <div class="text-center space-y-2">
        <h1 class="text-3xl font-extrabold text-[#203B3A]">Từ điển HSK & Hán tự</h1>
        <p class="text-sm text-gray-500">Tra cứu nhanh hơn 5,000 từ vựng theo chữ Hán, Pinyin, nghĩa tiếng Việt</p>
    </div>

    <!-- Search Input -->
    <div class="relative max-w-xl mx-auto">
        <input type="text" placeholder="Nhập chữ Hán, pinyin hoặc tiếng Việt..."
               class="w-full px-5 py-4 rounded-2xl border-2 border-gray-200 text-base focus:border-[#15965B] focus:ring-0 outline-none shadow-sm pr-12" />
        <button class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-[#15965B]">
            🔍
        </button>
    </div>

    <!-- Character Details Card -->
    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm space-y-4">
        <div class="flex items-center gap-6">
            <div class="w-24 h-24 rounded-2xl bg-emerald-50 text-[#15965B] flex items-center justify-center font-black text-6xl font-chinese">
                学
            </div>
            <div>
                <h2 class="text-2xl font-bold text-[#203B3A]">xué • Học, bắt chước</h2>
                <p class="text-xs text-gray-400 mt-1">Bộ thủ: 子 (Tử) • Số nét: 8 • HSK 1</p>
                <p class="text-sm text-gray-600 mt-2">Từ ghép thường gặp: 学习 (học tập), 学校 (trường học), 学生 (học sinh).</p>
            </div>
        </div>
    </div>
</div>
