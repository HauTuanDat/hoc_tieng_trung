@model QuizApp.ViewModels.ProfileSettingsViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}
<div class="max-w-3xl mx-auto px-4 py-8 space-y-6">
    <div>
        <h1 class="text-3xl font-extrabold text-[#203B3A]">Cài đặt tài khoản & Hồ sơ</h1>
        <p class="text-sm text-gray-500">Quản lý thông tin cá nhân và mục tiêu học tập hàng ngày</p>
    </div>

    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm space-y-6">
        <!-- Avatar Section -->
        <div class="flex items-center gap-4 pb-6 border-b border-gray-100">
            <img src="/Assets/panda_mascot_perfect.png" alt="Avatar" class="w-20 h-20 rounded-full border border-gray-200" />
            <div>
                <h3 class="text-lg font-bold text-[#203B3A]">Minh Đạt</h3>
                <p class="text-xs text-gray-400">Học viên tiếng Trung HSK 1 - 6</p>
                <button class="mt-2 text-xs font-bold text-[#15965B] hover:underline">Thay đổi ảnh đại diện</button>
            </div>
        </div>

        <form class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">Họ và tên</label>
                <input type="text" value="Nguyễn Minh Đạt" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-[#15965B] outline-none" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">Email</label>
                <input type="email" value="minhdat@gmail.com" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-[#15965B] outline-none" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">Mục tiêu học mỗi ngày</label>
                <select class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-[#15965B] outline-none">
                    <option>15 phút / ngày</option>
                    <option selected>30 phút / ngày</option>
                    <option>60 phút / ngày</option>
                </select>
            </div>

            <div class="pt-4">
                <button type="button" class="px-6 py-2.5 bg-[#15965B] hover:bg-[#11804D] text-white font-bold text-sm rounded-xl shadow-sm">
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>
