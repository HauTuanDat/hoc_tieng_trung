@model QuizApp.ViewModels.QuizViewModel
@{
    ViewData["Title"] = "Luyện thi trắc nghiệm";
}
<div class="max-w-3xl mx-auto px-4 py-8 space-y-6">
    <!-- Header Progress & Timer -->
    <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm flex items-center justify-between">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-emerald-100 text-[#15965B] font-bold text-xs flex items-center justify-center">1/20</span>
            <span class="text-xs font-semibold text-gray-500">HSK 1 • Đợt 20 câu</span>
        </div>
        <div class="flex items-center gap-2 text-xs font-bold text-orange-500 bg-orange-50 px-3 py-1.5 rounded-full">
            <span>⏱ 00:45</span>
        </div>
    </div>

    <!-- Question Card -->
    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm text-center space-y-4">
        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Chọn nghĩa đúng của từ</span>
        <h2 class="text-5xl font-extrabold text-[#203B3A] font-chinese">你好</h2>
        <p class="text-lg text-emerald-600 font-semibold">nǐ hǎo</p>
    </div>

    <!-- 4 Option Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <button class="bg-white hover:bg-emerald-50/50 border-2 border-gray-200 hover:border-[#15965B] rounded-2xl p-4 text-left flex items-center justify-between transition-all group">
            <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-xl bg-gray-100 group-hover:bg-[#15965B] group-hover:text-white text-gray-700 font-bold text-sm flex items-center justify-center transition-colors">A</span>
                <span class="font-bold text-[#203B3A]">Xin chào</span>
            </div>
            <span class="text-gray-300 group-hover:text-[#15965B]">✓</span>
        </button>

        <button class="bg-white hover:bg-emerald-50/50 border-2 border-gray-200 hover:border-[#15965B] rounded-2xl p-4 text-left flex items-center justify-between transition-all group">
            <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-xl bg-gray-100 group-hover:bg-[#15965B] group-hover:text-white text-gray-700 font-bold text-sm flex items-center justify-center transition-colors">B</span>
                <span class="font-bold text-[#203B3A]">Tạm biệt</span>
            </div>
            <span class="text-gray-300 group-hover:text-[#15965B]">✓</span>
        </button>

        <button class="bg-white hover:bg-emerald-50/50 border-2 border-gray-200 hover:border-[#15965B] rounded-2xl p-4 text-left flex items-center justify-between transition-all group">
            <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-xl bg-gray-100 group-hover:bg-[#15965B] group-hover:text-white text-gray-700 font-bold text-sm flex items-center justify-center transition-colors">C</span>
                <span class="font-bold text-[#203B3A]">Cảm ơn</span>
            </div>
            <span class="text-gray-300 group-hover:text-[#15965B]">✓</span>
        </button>

        <button class="bg-white hover:bg-emerald-50/50 border-2 border-gray-200 hover:border-[#15965B] rounded-2xl p-4 text-left flex items-center justify-between transition-all group">
            <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-xl bg-gray-100 group-hover:bg-[#15965B] group-hover:text-white text-gray-700 font-bold text-sm flex items-center justify-center transition-colors">D</span>
                <span class="font-bold text-[#203B3A]">Không có gì</span>
            </div>
            <span class="text-gray-300 group-hover:text-[#15965B]">✓</span>
        </button>
    </div>

    <!-- Action Buttons -->
    <div class="flex justify-between items-center pt-4">
        <a href="/DashboardView" class="text-xs font-semibold text-gray-400 hover:text-gray-600">Thoát bài thi</a>
        <a href="/ResultView" class="px-6 py-2.5 bg-[#15965B] text-white font-bold text-sm rounded-xl hover:bg-[#11804D] shadow-sm">
            Câu tiếp theo ➔
        </a>
    </div>
</div>
