@model QuizApp.ViewModels.VocabStudyViewModel
@{
    ViewData["Title"] = "Học từ vựng Flashcard";
}
<div class="max-w-xl mx-auto px-4 py-8 space-y-6 text-center">
    <div class="space-y-1">
        <h1 class="text-3xl font-extrabold text-[#203B3A]">Flashcard Từ Vựng</h1>
        <p class="text-xs text-gray-400">Nhấp để lật thẻ và xem thứ tự nét viết</p>
    </div>

    <!-- Flashcard Box -->
    <div class="bg-white rounded-3xl p-10 border border-gray-100 shadow-xl min-h-[320px] flex flex-col justify-center items-center space-y-4 cursor-pointer hover:shadow-2xl transition-all">
        <span class="text-xs font-bold text-gray-400">HSK 1 • Từ 1/149</span>
        <h2 class="text-7xl font-black text-[#203B3A] font-chinese">爱</h2>
        <p class="text-2xl text-[#15965B] font-bold">ài</p>
        <p class="text-base text-gray-600 font-medium">Yêu, thích, quý mến</p>
        <div class="pt-2 text-xs text-gray-400 italic">Ví dụ: 我爱你 (Wǒ ài nǐ)</div>
    </div>

    <!-- Action Buttons -->
    <div class="grid grid-cols-2 gap-4">
        <button class="py-3.5 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-sm rounded-2xl transition-colors">
            Chưa thuộc (Ôn lại)
        </button>
        <button class="py-3.5 bg-[#15965B] hover:bg-[#11804D] text-white font-bold text-sm rounded-2xl shadow-md transition-colors">
            Đã thuộc làu ✓
        </button>
    </div>
</div>
