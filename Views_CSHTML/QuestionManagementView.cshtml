@model QuizApp.ViewModels.QuestionManagementViewModel
@{
    ViewData["Title"] = "Quản lý ngân hàng câu hỏi";
}
<div class="max-w-7xl mx-auto px-4 py-8 space-y-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-extrabold text-[#203B3A]">Ngân hàng câu hỏi trắc nghiệm</h1>
            <p class="text-sm text-gray-500">Thêm, sửa, xóa và quản lý bộ đề thi HSK</p>
        </div>
        <button class="px-5 py-2.5 bg-[#15965B] hover:bg-[#11804D] text-white font-bold text-sm rounded-xl shadow-sm">
            + Thêm câu hỏi mới
        </button>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
        <table class="w-full text-left border-collapse text-sm">
            <thead class="bg-gray-50 text-gray-500 text-xs font-bold uppercase border-b border-gray-100">
                <tr>
                    <th class="p-4">Mã</th>
                    <th class="p-4">Nội dung câu hỏi</th>
                    <th class="p-4">Đáp án đúng</th>
                    <th class="p-4">Cấp độ</th>
                    <th class="p-4 text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <tr>
                    <td class="p-4 text-gray-400 font-mono">Q001</td>
                    <td class="p-4 font-bold text-[#203B3A]">Nghĩa của từ "你好" là gì?</td>
                    <td class="p-4 text-emerald-600 font-bold">Xin chào</td>
                    <td class="p-4"><span class="px-2 py-1 bg-emerald-50 text-[#15965B] rounded text-xs font-bold">HSK 1</span></td>
                    <td class="p-4 text-center space-x-2">
                        <button class="text-blue-600 hover:underline text-xs font-semibold">Sửa</button>
                        <button class="text-red-500 hover:underline text-xs font-semibold">Xóa</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
