<Window x:Class="QuizApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:QuizApp.Views"
        xmlns:vm="clr-namespace:QuizApp.ViewModels"
        mc:Ignorable="d"
        Title="Mộc Ngữ • Học tiếng Trung - Kết nối thế giới"
        Height="880" Width="1280"
        MinHeight="720" MinWidth="1050"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Focusable="True"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- DataTemplates for ViewModel Navigation -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CourseSelectionViewModel}">
            <views:CourseSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PracticeCenterViewModel}">
            <views:PracticeCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VocabStudyViewModel}">
            <views:VocabStudyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SpeakingPracticeViewModel}">
            <views:SpeakingPracticeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VocabListViewModel}">
            <views:VocabListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DictionaryViewModel}">
            <views:DictionaryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LearnedVocabViewModel}">
            <views:LearnedVocabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileSettingsViewModel}">
            <views:ProfileSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuizViewModel}">
            <views:QuizView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultViewModel}">
            <views:ResultView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SentenceScrambleViewModel}">
            <views:SentenceScrambleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TypingPracticeViewModel}">
            <views:TypingPracticeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionManagementViewModel}">
            <views:QuestionManagementView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- IF NOT LOGGED IN: Fullscreen Login / Register Screen -->
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- IF LOGGED IN: Main Mộc Ngữ Application Shell (Left Sidebar + Top Header + Body) -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- 1. LEFT SIDEBAR (Mộc Ngữ Traditional Menu)     -->
            <!-- ============================================== -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Logo: 语 Mộc Ngữ -->
                    <Button Grid.Row="0"
                            Command="{Binding NavigateToDashboardCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,0,24">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="语" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Mộc Ngữ" FontWeight="ExtraBold" FontSize="18" Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="Học tiếng Trung" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium" />
                                    </StackPanel>
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Center Navigation Menu List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. Tổng quan -->
                            <Button Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠 " FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Tổng quan" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 2. Học tập -->
                            <Button Command="{Binding NavigateToCoursesCommand}" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖 " FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Học tập" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Sub-item: Luyện từ vựng chi tiết -->
                            <Button Command="{Binding NavigateToVocabStudyCommand}" Style="{StaticResource SidebarNavButton}" Margin="16,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯 " FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Luyện từ vựng" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 3. Luyện tập -->
                            <Button Command="{Binding NavigateToPracticeCenterCommand}" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯 " FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Luyện tập" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Sub-item: Luyện nói phát âm AI -->
                            <Button Command="{Binding NavigateToSpeakingCommand}" Style="{StaticResource SidebarNavButton}" Margin="16,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎙 " FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Luyện nói AI" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Sub-item: Xếp câu -->
                            <Button Command="{Binding NavigateToSentenceScrambleCommand}" Style="{StaticResource SidebarNavButton}" Margin="16,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧩 " FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Sắp xếp câu" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Sub-item: Luyện viết & gõ -->
                            <Button Command="{Binding NavigateToTypingCommand}" Style="{StaticResource SidebarNavButton}" Margin="16,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✍ " FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Luyện viết &amp; gõ" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 4. Danh sách từ vựng -->
                            <Button Command="{Binding NavigateToVocabListCommand}" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📚 " FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Từ vựng" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 5. Tra từ điển -->
                            <Button Command="{Binding NavigateToDictionaryCommand}" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖 " FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Từ điển" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 6. Thống kê & Tiến độ -->
                            <Button Command="{Binding NavigateToLearnedVocabCommand}" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊 " FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Thống kê" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 7. Cài đặt & Hồ sơ -->
                            <Button Command="{Binding NavigateToProfileSettingsCommand}" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙ " FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cài đặt" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Sidebar Encouragement Widget -->
                    <Border Grid.Row="2" Background="#FAF4EC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="🐼 Mộc Ngữ nhắc bạn:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="&quot;Mỗi ngày học thêm một chút, tương lai sẽ khác đi rất nhiều!&quot;"
                                       FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 2. RIGHT WORKSPACE (Header Bar + Content)      -->
            <!-- ============================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Header Navigation Bar -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="28,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Search Box -->
                        <Border Grid.Column="0"
                                Background="#FAF6F0"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Height="40"
                                MaxWidth="480"
                                HorizontalAlignment="Left"
                                Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍 " FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalAlignment="Center"
                                         FontSize="13"
                                         Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding GlobalSearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2"
                                        Command="{Binding GlobalSearchCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="10,4"
                                        Height="28"
                                        FontSize="11.5">
                                    <TextBlock Text="Tìm kiếm" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Right: Audio Toggle, Notification Bell, User Avatar & Name -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Sound Toggle -->
                            <Button Content="{Binding SoundToggleIcon}"
                                    Command="{Binding ToggleSoundCommand}"
                                    ToolTip="{Binding SoundToggleTooltip}"
                                    Style="{StaticResource OutlineButton}"
                                    FontSize="14"
                                    Padding="10,6"
                                    Margin="0,0,10,0" />

                            <!-- Notification Bell with Red Badge -->
                            <Grid Margin="0,0,16,0" Cursor="Hand">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#FAF6F0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                    <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource ChineseVermilionBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                                    <TextBlock Text="3" FontSize="9.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- User Profile Avatar & Name Pill Button -->
                            <Button Command="{Binding NavigateToProfileSettingsCommand}"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#FAF6F0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="20" Padding="10,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource PrimaryTintBrush}" Margin="0,0,8,0">
                                                    <TextBlock Text="🐼" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding UserDisplayName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="▾" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active View Body -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
