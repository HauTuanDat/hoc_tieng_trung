<Window x:Class="QuizApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:QuizApp.Views"
        xmlns:vm="clr-namespace:QuizApp.ViewModels"
        mc:Ignorable="d"
        Title="Mộc Ngữ • Học tiếng Trung - Kết nối thế giới"
        Height="880" Width="1280"
        MinHeight="500" MinWidth="360"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- DataTemplates for ViewModel Navigation -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CourseSelectionViewModel}">
            <views:CourseSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PracticeCenterViewModel}">
            <views:PracticeCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VocabStudyViewModel}">
            <views:VocabStudyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SpeakingPracticeViewModel}">
            <views:SpeakingPracticeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VocabListViewModel}">
            <views:VocabListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DictionaryViewModel}">
            <views:DictionaryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LearnedVocabViewModel}">
            <views:LearnedVocabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileSettingsViewModel}">
            <views:ProfileSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuizViewModel}">
            <views:QuizView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultViewModel}">
            <views:ResultView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SentenceScrambleViewModel}">
            <views:SentenceScrambleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TypingPracticeViewModel}">
            <views:TypingPracticeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionManagementViewModel}">
            <views:QuestionManagementView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- IF NOT LOGGED IN: Fullscreen Login / Register Screen -->
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- IF LOGGED IN: Main Mộc Ngữ Application Shell (Left Sidebar + Top Header + Body) -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- 1. LEFT SIDEBAR (Mộc Ngữ Traditional Menu)     -->
            <!-- ============================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16,20"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Logo: 语 Mộc Ngữ (Modern UI Typography) -->
                    <Button Grid.Row="0"
                            Command="{Binding NavigateToDashboardCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,0,24">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="语" FontFamily="{StaticResource ChineseFontFamily}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Mộc Ngữ" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="Học tiếng Trung" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Center Navigation Menu List (15px - Medium 500) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. Tổng quan -->
                            <Button Command="{Binding NavigateToDashboardCommand}" Style="{DynamicResource SidebarNavButton}" Tag="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠 " FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Tổng quan" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 2. Học tập -->
                            <Button Command="{Binding NavigateToCoursesCommand}" Style="{DynamicResource SidebarNavButton}" Tag="Courses">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖 " FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Học tập" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Sub-item: Luyện từ vựng chi tiết -->
                            <Button Command="{Binding NavigateToVocabStudyCommand}" Style="{DynamicResource SidebarNavButton}" Tag="VocabStudy" Margin="14,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯 " FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Luyện từ vựng" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 3. Luyện tập -->
                            <Button Command="{Binding NavigateToPracticeCenterCommand}" Style="{DynamicResource SidebarNavButton}" Tag="PracticeCenter">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Luyện tập" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Sub-item: Luyện nói phát âm AI -->
                            <Button Command="{Binding NavigateToSpeakingCommand}" Style="{DynamicResource SidebarNavButton}" Tag="Speaking" Margin="14,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎙 " FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Luyện nói AI" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Sub-item: Xếp câu -->
                            <Button Command="{Binding NavigateToSentenceScrambleCommand}" Style="{DynamicResource SidebarNavButton}" Tag="SentenceScramble" Margin="14,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗂 " FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Sắp xếp câu" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Sub-item: Luyện viết & gõ -->
                            <Button Command="{Binding NavigateToTypingCommand}" Style="{DynamicResource SidebarNavButton}" Tag="Typing" Margin="14,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✍ " FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Luyện viết &amp; gõ" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 4. Danh sách từ vựng -->
                            <Button Command="{Binding NavigateToVocabListCommand}" Style="{DynamicResource SidebarNavButton}" Tag="VocabList">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖 " FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Từ vựng" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 5. Tra từ điển -->
                            <Button Command="{Binding NavigateToDictionaryCommand}" Style="{DynamicResource SidebarNavButton}" Tag="Dictionary">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖 " FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Từ điển" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 6. Thống kê & Tiến độ -->
                            <Button Command="{Binding NavigateToLearnedVocabCommand}" Style="{DynamicResource SidebarNavButton}" Tag="LearnedVocab">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊 " FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Thống kê" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 7. Cài đặt & Hồ sơ -->
                            <Button Command="{Binding NavigateToProfileSettingsCommand}" Style="{DynamicResource SidebarNavButton}" Tag="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙ " FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cài đặt" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Sidebar Encouragement Widget (Clear High-Contrast Text) -->
                    <Border Grid.Row="2" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="🐼 Mộc Ngữ nhắc bạn:" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="&quot;Mỗi ngày học thêm một chút, tương lai sẽ khác đi rất nhiều!&quot;"
                                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 2. RIGHT WORKSPACE (Header Bar + Content)      -->
            <!-- ============================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Header Navigation Bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="28,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Search Box (14px Clean Input) -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource SubCardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Height="42"
                                MaxWidth="480"
                                HorizontalAlignment="Left"
                                Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍 " FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalAlignment="Center"
                                         FontSize="14"
                                         Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding GlobalSearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2"
                                        Command="{Binding GlobalSearchCommand}"
                                        Style="{DynamicResource PrimaryButton}"
                                        Padding="14,5"
                                        Height="30"
                                        FontSize="13.5">
                                    <TextBlock Text="Tìm kiếm" FontWeight="SemiBold" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Right: Audio Toggle, Notification Bell, User Avatar & Name -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Sound Toggle -->
                            <Button Content="{Binding SoundToggleIcon}"
                                    Command="{Binding ToggleSoundCommand}"
                                    ToolTip="{Binding SoundToggleTooltip}"
                                    Style="{DynamicResource OutlineButton}"
                                    FontSize="14"
                                    Padding="10,6"
                                    Margin="0,0,10,0" />

                            <!-- Notification Bell with Red Badge -->
                            <Grid Margin="0,0,16,0" Cursor="Hand">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                                    <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource ChineseVermilionBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                                    <TextBlock Text="3" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- User Profile Avatar & Name Pill Button -->
                            <Button Command="{Binding NavigateToProfileSettingsCommand}"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{DynamicResource SubCardBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="20" Padding="12,5">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="32" Height="32" CornerRadius="16" Background="White" BorderBrush="{DynamicResource PrimaryLightBorderBrush}" BorderThickness="1.5" Margin="0,0,8,0">
                                                    <TextBlock Text="🐼" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding UserDisplayName, TargetNullValue='Minh Đạt'}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="▾" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active View Body -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
