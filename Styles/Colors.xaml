<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Brand Colors: Chinese Jade Green (Màu Xanh Ngọc Bích / Trúc Xanh Phỉ Thúy Truyền Thống) -->
    <Color x:Key="PrimaryColor">#208B58</Color>
    <Color x:Key="PrimaryHoverColor">#187347</Color>
    <Color x:Key="PrimaryPressedColor">#125936</Color>
    <Color x:Key="PrimaryTintColor">#EBF7F0</Color>
    <Color x:Key="PrimaryLightBorderColor">#C3E8D2</Color>

    <!-- Traditional Chinese Accent Colors (Màu sắc nghệ thuật cổ phong Trung Hoa) -->
    <Color x:Key="ChineseVermilionColor">#C8372D</Color>      <!-- Đỏ Chu Sa: may mắn, điểm nhấn son -->
    <Color x:Key="ImperialGoldColor">#D97706</Color>          <!-- Vàng Lưu Ly / Hoàng Kim -->
    <Color x:Key="AmberAccentColor">#D97706</Color>
    <Color x:Key="PorcelainBlueColor">#2563EB</Color>         <!-- Men Lam Thanh Hoa Sứ -->
    <Color x:Key="WisteriaPurpleColor">#7C3AED</Color>        <!-- Tím Tử Đằng -->
    <Color x:Key="TeaGreenColor">#4D7C0F</Color>              <!-- Xanh Trà Long Tỉnh -->

    <!-- Accents for Course Levels -->
    <Color x:Key="Hsk1Color">#208B58</Color>
    <Color x:Key="Hsk2Color">#0D9488</Color>
    <Color x:Key="Hsk3Color">#2563EB</Color>
    <Color x:Key="Hsk4Color">#D97706</Color>
    <Color x:Key="Hsk5Color">#7C3AED</Color>
    <Color x:Key="Hsk6Color">#C8372D</Color>

    <!-- Neutral Tones (Warm Rice Paper & Chinese Ink Wash) -->
    <Color x:Key="WindowBackgroundColor">#FAF7F2</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SubCardBackgroundColor">#F5F8F5</Color>
    <Color x:Key="SidebarBackgroundColor">#FAF8F4</Color>
    <Color x:Key="BorderLightColor">#E6DFD5</Color>
    <Color x:Key="BorderSubtleColor">#DFD6C9</Color>
    <Color x:Key="BorderVibrantColor">#C3E8D2</Color>
    <Color x:Key="TextPrimaryColor">#1F2923</Color>
    <Color x:Key="TextSecondaryColor">#4B5A52</Color>
    <Color x:Key="TextMutedColor">#7A8A81</Color>

    <!-- Semantic Feedback Colors -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessBgColor">#F0FDF4</Color>
    <Color x:Key="SuccessBorderColor">#BBF7D0</Color>
    <Color x:Key="SuccessTextColor">#166534</Color>

    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="ErrorBgColor">#FEF2F2</Color>
    <Color x:Key="ErrorBorderColor">#FECACA</Color>
    <Color x:Key="ErrorTextColor">#991B1B</Color>

    <Color x:Key="PurpleBadgeBgColor">#F3E8FF</Color>
    <Color x:Key="PurpleBadgeTextColor">#7C3AED</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="PrimaryTintBrush" Color="{StaticResource PrimaryTintColor}" />
    <SolidColorBrush x:Key="PrimaryLightBorderBrush" Color="{StaticResource PrimaryLightBorderColor}" />

    <SolidColorBrush x:Key="ChineseVermilionBrush" Color="{StaticResource ChineseVermilionColor}" />
    <SolidColorBrush x:Key="ImperialGoldBrush" Color="{StaticResource ImperialGoldColor}" />
    <SolidColorBrush x:Key="PorcelainBlueBrush" Color="{StaticResource PorcelainBlueColor}" />
    <SolidColorBrush x:Key="AmberAccentBrush" Color="{StaticResource ImperialGoldColor}" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="SubCardBackgroundBrush" Color="{StaticResource SubCardBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderVibrantBrush" Color="{StaticResource BorderVibrantColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource SuccessBorderColor}" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}" />

    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource ErrorBgColor}" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource ErrorBorderColor}" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorTextColor}" />

    <SolidColorBrush x:Key="PurpleBadgeBgBrush" Color="{StaticResource PurpleBadgeBgColor}" />
    <SolidColorBrush x:Key="PurpleBadgeTextBrush" Color="{StaticResource PurpleBadgeTextColor}" />

    <!-- Dynamic Vibrant Gradients for Chinese Jade Green Theme -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#28A768" Offset="0" />
        <GradientStop Color="#187347" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#24965F" Offset="0" />
        <GradientStop Color="#197548" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B7D4D" Offset="0" />
        <GradientStop Color="#125936" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FAF7F2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SoftMeshBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FAF7F2" Offset="0" />
        <GradientStop Color="#EFF7F2" Offset="0.5" />
        <GradientStop Color="#FAF7F2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyanBlueGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D9488" Offset="0" />
        <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SunsetGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D97706" Offset="0" />
        <GradientStop Color="#C8372D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#208B58" Offset="0" />
        <GradientStop Color="#166942" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
